---
const navItems = [
	{ label: "Home", href: "/" },
	{ label: "About", href: "/about" },
	{
		label: "Services",
		href: "/services",
		dropdown: [
			{ label: "Home Cleaning", href: "/services" },
			{ label: "Car Detailing", href: "/services/car-detailing" },
			{ label: "Garage Cleaning & Organization", href: "/services/garage-organization" },
		],
	},
	{
		label: "Booking",
		href: "/booking",
		dropdown: [
			{ label: "Home Cleaning", href: "/booking" },
			{ label: "Car Detailing", href: "/booking/car-detailing" },
		],
	},
	{ label: "Reviews", href: "/reviews" },
	{ label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="navbar" id="site-navbar">
	<div class="navbar__inner container">
		<a href="/" class="navbar__brand">
			<img src="/images/logo-icon.svg" alt="Sky House Cleaning" class="navbar__logo" />
			<span>Sky House Cleaning</span>
		</a>

		<input type="checkbox" id="nav-toggle" class="navbar__toggle-input" />
		<label for="nav-toggle" class="navbar__toggle" aria-label="Toggle menu">
			<span></span>
			<span></span>
			<span></span>
		</label>

		<nav class="navbar__nav" aria-label="Main navigation">
			<ul>
				{navItems.map((item) => {
					const isActive =
						item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);

					if (item.dropdown) {
						return (
							<li class="navbar__item--dropdown">
								<a href={item.href} class:list={["navbar__link", { "is-active": isActive }]}>
									{item.label}
									<span class="navbar__caret" aria-hidden="true"></span>
								</a>
								<ul class="navbar__dropdown">
									{item.dropdown.map((sub) => (
										<li>
											<a
												href={sub.href}
												class:list={["navbar__dropdown-link", { "is-active": currentPath === sub.href }]}
											>
												{sub.label}
											</a>
										</li>
									))}
								</ul>
							</li>
						);
					}

					return (
						<li>
							<a href={item.href} class:list={["navbar__link", { "is-active": isActive }]}>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
			<a href="/booking" class="btn btn--primary navbar__cta">Schedule Your Cleaning</a>
		</nav>
	</div>
</header>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-white);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.navbar.is-scrolled {
		border-bottom-color: var(--color-border);
	}

	.navbar__inner {
		position: relative;
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		padding: 0.85rem 1.5rem;
	}

	.navbar__brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.1rem;
		white-space: nowrap;
	}

	.navbar__logo {
		height: 34px;
		width: auto;
	}

	.navbar__nav {
		display: flex;
		align-items: stretch;
		gap: 2rem;
	}

	.navbar__nav ul {
		display: flex;
		align-items: stretch;
		gap: 1.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.navbar__link {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
		text-decoration: none;
		color: var(--color-slate);
		font-weight: 500;
		font-size: 0.95rem;
	}

	.navbar__link:hover {
		color: var(--color-sky-dark);
	}

	/* The current-page link itself goes black (var(--color-ink), the site's
	   near-black) rather than blue — hover above stays blue as the
	   interactive cue, this is the steady "you are here" state. */
	.navbar__link.is-active {
		color: var(--color-ink);
	}

	/* Sits close under the "Services" text — not centered in the gap, but
	   hugging the text with most of the remaining space left between it and
	   the active-page bar below (positioned relative to .navbar__link, which
	   has its own position: relative below — the bar sits at bottom:
	   -0.85rem) — matching the reference screenshot's spacing. Stays
	   invisible until hovered — it's just a visual hint that a menu is
	   available, separate from whether the menu is actually open (that's
	   click-driven, see the .is-open rules and the script below). Drawn as a
	   thin chevron (a rotated corner of a bordered box) rather than a text
	   glyph, for a crisper, more consistent shape across platforms/fonts. */
	.navbar__caret {
		position: absolute;
		left: 50%;
		bottom: -0.2rem;
		width: 6px;
		height: 6px;
		border-right: 1.5px solid var(--color-ink);
		border-bottom: 1.5px solid var(--color-ink);
		transform: translateX(-50%) rotate(45deg);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.navbar__item--dropdown {
		position: relative;
	}

	.navbar__dropdown {
		position: absolute;
		/* 0.85rem matches .navbar__inner's bottom padding, so this starts
		   right at the header's bottom edge. */
		top: calc(100% + 0.85rem);
		left: 0;
		z-index: 60;
		min-width: 240px;
		margin: 0.5rem 0 0;
		padding: 0.5rem;
		list-style: none;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
	}

	/* Opens only when clicked/selected (see the script below) — not on
	   hover. The caret above still responds to hover on its own, as just a
	   hint that "Services" has a menu. */
	.navbar__item--dropdown.is-open .navbar__dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.navbar__item--dropdown:hover .navbar__caret,
	.navbar__item--dropdown.is-open .navbar__caret {
		opacity: 1;
	}

	.navbar__item--dropdown.is-open .navbar__caret {
		/* 45deg is the chevron's resting "point down" angle — add 180 to flip
		   it to "point up" while open. */
		transform: translateX(-50%) rotate(225deg);
	}

	.navbar__dropdown-link {
		display: block;
		padding: 0.6rem 0.75rem;
		border-radius: 8px;
		text-decoration: none;
		color: var(--color-slate);
		font-weight: 500;
		font-size: 0.9rem;
		white-space: nowrap;
	}

	.navbar__dropdown-link:hover {
		color: var(--color-sky-dark);
	}

	.navbar__dropdown-link.is-active {
		color: var(--color-sky-dark);
	}

	/* The active-page indicator bar. -0.85rem matches .navbar__inner's
	   padding-bottom exactly, so the bar sits flush with the header's own
	   bottom edge (the same place the scroll-triggered border-bottom sits),
	   rather than floating under the link text with a gap. */
	.navbar__link.is-active::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.85rem;
		height: 3px;
		background: var(--color-sky);
		border-radius: 2px 2px 0 0;
	}

	.navbar__cta {
		align-self: center;
		padding: 0.6rem 1.25rem;
		font-size: 0.85rem;
		white-space: nowrap;
	}

	.navbar__toggle-input {
		display: none;
	}

	.navbar__toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		cursor: pointer;
	}

	.navbar__toggle span {
		display: block;
		height: 2px;
		background: var(--color-ink);
		border-radius: 2px;
	}

	@media (max-width: 860px) {
		.navbar__toggle {
			display: flex;
		}

		.navbar__nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--color-white);
			border-bottom: 1px solid var(--color-border);
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
			padding: 0 1.5rem;
			max-height: 0;
			overflow: hidden;
			visibility: hidden;
			transition: max-height 0.25s ease, padding 0.25s ease, visibility 0.25s ease;
		}

		.navbar__nav ul {
			flex-direction: column;
			gap: 1rem;
			width: 100%;
		}

		.navbar__toggle-input:checked ~ .navbar__nav {
			max-height: 640px;
			padding: 1.5rem;
			visibility: visible;
		}

		/* No hover on touch — the dropdown is just always expanded, indented
		   under "Services", in the stacked mobile menu instead of appearing
		   as a hover flyout. */
		.navbar__item--dropdown {
			position: static;
		}

		.navbar__dropdown {
			position: static;
			opacity: 1;
			visibility: visible;
			transform: none;
			border: none;
			box-shadow: none;
			padding: 0.25rem 0 0 1rem;
			margin-top: 0.5rem;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		.navbar__dropdown-link {
			padding: 0.2rem 0;
		}

		.navbar__caret {
			display: none;
		}

		.navbar__cta {
			width: 100%;
		}

		/* The desktop active-page bar is positioned assuming a horizontal,
		   full-height nav row — it doesn't translate to the stacked mobile
		   dropdown, so swap it for a simple left-edge accent instead. */
		.navbar__link.is-active::after {
			top: 0;
			bottom: 0;
			left: -0.75rem;
			right: auto;
			width: 3px;
			height: auto;
			border-radius: 2px;
		}
	}
</style>

<script>
	function initNavbarScroll() {
		const header = document.getElementById("site-navbar");
		if (!header || header.dataset.scrollInit === "true") return;
		header.dataset.scrollInit = "true";

		function update() {
			header.classList.toggle("is-scrolled", window.scrollY > 0);
		}

		update();
		window.addEventListener("scroll", update, { passive: true });
	}

	initNavbarScroll();
	document.addEventListener("astro:page-load", initNavbarScroll);

	// The Services dropdown opens only when clicked/selected — not on
	// hover — and closes on an outside click, Escape, or picking another
	// dropdown. On the stacked mobile menu the sub-links are already always
	// visible (see the max-width: 860px styles), so the click there is left
	// alone to behave as a normal link.
	function initNavbarDropdowns() {
		const header = document.getElementById("site-navbar");
		if (!header || header.dataset.dropdownInit === "true") return;
		header.dataset.dropdownInit = "true";

		const items = Array.from(header.querySelectorAll(".navbar__item--dropdown"));
		if (items.length === 0) return;

		function closeAll() {
			items.forEach((item) => {
				item.classList.remove("is-open");
				item.querySelector(":scope > .navbar__link")?.setAttribute("aria-expanded", "false");
			});
		}

		items.forEach((item) => {
			const trigger = item.querySelector(":scope > .navbar__link");
			if (!trigger) return;
			trigger.setAttribute("aria-haspopup", "true");
			trigger.setAttribute("aria-expanded", "false");

			trigger.addEventListener("click", (event) => {
				if (window.matchMedia("(max-width: 860px)").matches) return;

				event.preventDefault();
				const wasOpen = item.classList.contains("is-open");
				closeAll();
				if (!wasOpen) {
					item.classList.add("is-open");
					trigger.setAttribute("aria-expanded", "true");
				}
			});
		});

		document.addEventListener("click", (event) => {
			items.forEach((item) => {
				if (!item.contains(event.target)) {
					item.classList.remove("is-open");
					item.querySelector(":scope > .navbar__link")?.setAttribute("aria-expanded", "false");
				}
			});
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeAll();
		});
	}

	initNavbarDropdowns();
	document.addEventListener("astro:page-load", initNavbarDropdowns);
</script>
