---
const navItems = [
	{ label: "Home", href: "/" },
	{ label: "About", href: "/about" },
	{ label: "Services", href: "/services" },
	{ label: "Booking", href: "/booking" },
	{ label: "Reviews", href: "/reviews" },
	{ label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="navbar" id="site-navbar">
	<div class="navbar__inner container">
		<a href="/" class="navbar__brand">
			<img src="/images/logo-icon.svg" alt="Sky House Cleaning" class="navbar__logo" />
			<span>Sky House Cleaning</span>
		</a>

		<input type="checkbox" id="nav-toggle" class="navbar__toggle-input" />
		<label for="nav-toggle" class="navbar__toggle" aria-label="Toggle menu">
			<span></span>
			<span></span>
			<span></span>
		</label>

		<nav class="navbar__nav" aria-label="Main navigation">
			<ul>
				{navItems.map((item) => {
					const isActive =
						item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);
					return (
						<li>
							<a href={item.href} class:list={["navbar__link", { "is-active": isActive }]}>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
			<a href="/booking" class="btn btn--primary navbar__cta">Schedule Your Cleaning</a>
		</nav>
	</div>
</header>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-white);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.navbar.is-scrolled {
		border-bottom-color: var(--color-border);
	}

	.navbar__inner {
		position: relative;
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		padding: 0.85rem 1.5rem;
	}

	.navbar__brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--color-ink);
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.1rem;
		white-space: nowrap;
	}

	.navbar__logo {
		height: 34px;
		width: auto;
	}

	.navbar__nav {
		display: flex;
		align-items: stretch;
		gap: 2rem;
	}

	.navbar__nav ul {
		display: flex;
		align-items: stretch;
		gap: 1.6rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.navbar__link {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
		text-decoration: none;
		color: var(--color-slate);
		font-weight: 500;
		font-size: 0.95rem;
	}

	.navbar__link:hover,
	.navbar__link.is-active {
		color: var(--color-sky-dark);
	}

	/* The active-page indicator bar. -0.85rem matches .navbar__inner's
	   padding-bottom exactly, so the bar sits flush with the header's own
	   bottom edge (the same place the scroll-triggered border-bottom sits),
	   rather than floating under the link text with a gap. */
	.navbar__link.is-active::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.85rem;
		height: 3px;
		background: var(--color-sky);
		border-radius: 2px 2px 0 0;
	}

	.navbar__cta {
		align-self: center;
		padding: 0.6rem 1.25rem;
		font-size: 0.85rem;
		white-space: nowrap;
	}

	.navbar__toggle-input {
		display: none;
	}

	.navbar__toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 32px;
		height: 32px;
		cursor: pointer;
	}

	.navbar__toggle span {
		display: block;
		height: 2px;
		background: var(--color-ink);
		border-radius: 2px;
	}

	@media (max-width: 860px) {
		.navbar__toggle {
			display: flex;
		}

		.navbar__nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--color-white);
			border-bottom: 1px solid var(--color-border);
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
			padding: 0 1.5rem;
			max-height: 0;
			overflow: hidden;
			visibility: hidden;
			transition: max-height 0.25s ease, padding 0.25s ease, visibility 0.25s ease;
		}

		.navbar__nav ul {
			flex-direction: column;
			gap: 1rem;
			width: 100%;
		}

		.navbar__toggle-input:checked ~ .navbar__nav {
			max-height: 420px;
			padding: 1.5rem;
			visibility: visible;
		}

		.navbar__cta {
			width: 100%;
		}

		/* The desktop active-page bar is positioned assuming a horizontal,
		   full-height nav row — it doesn't translate to the stacked mobile
		   dropdown, so swap it for a simple left-edge accent instead. */
		.navbar__link.is-active::after {
			top: 0;
			bottom: 0;
			left: -0.75rem;
			right: auto;
			width: 3px;
			height: auto;
			border-radius: 2px;
		}
	}
</style>

<script>
	function initNavbarScroll() {
		const header = document.getElementById("site-navbar");
		if (!header || header.dataset.scrollInit === "true") return;
		header.dataset.scrollInit = "true";

		function update() {
			header.classList.toggle("is-scrolled", window.scrollY > 0);
		}

		update();
		window.addEventListener("scroll", update, { passive: true });
	}

	initNavbarScroll();
	document.addEventListener("astro:page-load", initNavbarScroll);
</script>
