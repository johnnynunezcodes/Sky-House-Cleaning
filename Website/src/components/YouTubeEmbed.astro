---
interface Props {
	id: string;
	title: string;
	aspectRatio?: string;
}

const { id, title, aspectRatio = "16 / 9" } = Astro.props;
const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" style={`--ratio: ${aspectRatio};`} data-yt-id={id} data-yt-title={title}>
	<button type="button" class="yt__play" aria-label={`Play video: ${title}`}>
		<img src={thumbnail} alt="" class="yt__thumb" loading="lazy" />
		<span class="yt__icon" aria-hidden="true">
			<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
				<path d="M8 5v14l11-7z"></path>
			</svg>
		</span>
	</button>
</div>

<style>
	.yt {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ratio);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		background: #0c0c0c;
	}

	.yt__play {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		margin: 0;
		cursor: pointer;
		display: block;
		background: none;
	}

	.yt__thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.yt__play::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(12, 16, 24, 0.28);
		transition: background 0.15s ease;
	}

	.yt__play:hover::after {
		background: rgba(12, 16, 24, 0.4);
	}

	.yt__icon {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: #fff;
		color: var(--color-sky-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 4px;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
		transition: transform 0.15s ease;
	}

	.yt__play:hover .yt__icon {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.yt :global(.yt__player-wrap) {
		position: absolute;
		inset: 0;
	}

	.yt :global(.yt__player-wrap iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		/* The iframe is a cross-origin YouTube document, so a click inside
		   it can never be observed by our page's JS — pointer-events: none
		   sends clicks straight through to .yt__toggle (a same-origin
		   button stacked on top of it, see below), which is what actually
		   handles play/pause. */
		pointer-events: none;
	}

	/* Covers the whole player so clicking anywhere pauses/resumes it, with
	   a small Instagram-style icon pinned to the corner as the visible
	   affordance — no native YouTube controls bar or settings gear at
	   all, playerVars below removes those entirely. */
	.yt :global(.yt__toggle) {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
	}

	.yt :global(.yt__toggle-icon) {
		position: absolute;
		bottom: 0.85rem;
		right: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		transition: background 0.15s ease;
	}

	.yt :global(.yt__toggle:hover .yt__toggle-icon) {
		background: rgba(0, 0, 0, 0.65);
	}

	.yt :global(.yt__toggle-icon svg) {
		width: 15px;
		height: 15px;
		fill: currentColor;
	}

	/* Explicit class rather than the "hidden" attribute — this codebase
	   has run into "hidden" silently losing to an equal-specificity
	   author display rule before, so this sidesteps that entirely. */
	.yt :global(.yt__toggle-icon svg.is-hidden) {
		display: none;
	}
</style>

<script>
	let ytApiPromise;

	function loadYouTubeApi() {
		if (window.YT && window.YT.Player) return Promise.resolve(window.YT);
		if (ytApiPromise) return ytApiPromise;

		ytApiPromise = new Promise((resolve) => {
			const previousCallback = window.onYouTubeIframeAPIReady;
			window.onYouTubeIframeAPIReady = () => {
				previousCallback?.();
				resolve(window.YT);
			};
			const script = document.createElement("script");
			script.src = "https://www.youtube.com/iframe_api";
			document.head.appendChild(script);
		});
		return ytApiPromise;
	}

	function initYouTubeEmbeds() {
		document.querySelectorAll(".yt").forEach((el) => {
			if (!(el instanceof HTMLElement) || el.dataset.ytInit === "true") return;
			el.dataset.ytInit = "true";

			const button = el.querySelector(".yt__play");
			button?.addEventListener("click", async () => {
				const videoId = el.dataset.ytId;
				if (!videoId) return;

				const playerId = `yt-player-${Math.random().toString(36).slice(2, 9)}`;
				el.innerHTML = `
					<div class="yt__player-wrap"><div id="${playerId}"></div></div>
					<button type="button" class="yt__toggle" aria-label="Pause video">
						<span class="yt__toggle-icon" aria-hidden="true">
							<svg class="icon-pause" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1"></rect><rect x="14" y="4" width="4" height="16" rx="1"></rect></svg>
							<svg class="icon-play is-hidden" viewBox="0 0 24 24"><path d="M7 4l13 8-13 8z"></path></svg>
						</span>
					</button>
				`;

				const toggleBtn = el.querySelector(".yt__toggle");
				const pauseIcon = el.querySelector(".icon-pause");
				const playIcon = el.querySelector(".icon-play");
				if (!toggleBtn || !pauseIcon || !playIcon) return;

				const YT = await loadYouTubeApi();

				const player = new YT.Player(playerId, {
					videoId,
					host: "https://www.youtube-nocookie.com",
					playerVars: {
						autoplay: 1,
						rel: 0,
						controls: 0,
						modestbranding: 1,
						iv_load_policy: 3,
						playsinline: 1,
					},
					events: {
						onStateChange(event) {
							const playing = event.data === YT.PlayerState.PLAYING;
							pauseIcon.classList.toggle("is-hidden", !playing);
							playIcon.classList.toggle("is-hidden", playing);
							toggleBtn.setAttribute("aria-label", playing ? "Pause video" : "Play video");
						},
					},
				});

				toggleBtn.addEventListener("click", () => {
					if (player.getPlayerState() === YT.PlayerState.PLAYING) {
						player.pauseVideo();
					} else {
						player.playVideo();
					}
				});
			});
		});
	}

	initYouTubeEmbeds();
	document.addEventListener("astro:page-load", initYouTubeEmbeds);
</script>
