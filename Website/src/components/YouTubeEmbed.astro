---
interface Props {
	id: string;
	title: string;
	aspectRatio?: string;
}

const { id, title, aspectRatio = "16 / 9" } = Astro.props;
const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<!--
	YouTube's embedded player always shows its own branded overlay (channel
	avatar, video title, a big play button, and a "Watch on YouTube" link)
	whenever it isn't actively playing — on initial load, when paused, or
	when a video ends. That overlay is not part of the controls bar and
	YouTube doesn't offer a parameter to turn it off; it's how they keep
	attribution visible even with controls=0.

	So instead of fighting that, this covers the player with our own
	opaque thumbnail + play button any time it's not playing (.yt__cover),
	and only lets the raw iframe show through while it's actually playing
	— which is the one state where YouTube's own overlay is already gone.
	While playing, a small transparent button (.yt__catch) sits on top so
	a click anywhere pauses it, with a small corner icon as the affordance.
-->
<div class="yt" style={`--ratio: ${aspectRatio};`} data-yt-id={id} data-yt-title={title}>
	<div class="yt__player-wrap"></div>

	<button type="button" class="yt__cover" aria-label={`Play video: ${title}`}>
		<img src={thumbnail} alt="" class="yt__thumb" loading="lazy" />
		<span class="yt__icon" aria-hidden="true">
			<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
				<path d="M8 5v14l11-7z"></path>
			</svg>
		</span>
	</button>

	<button type="button" class="yt__catch is-hidden" aria-label="Pause video">
		<span class="yt__catch-icon" aria-hidden="true">
			<svg viewBox="0 0 24 24">
				<rect x="6" y="4" width="4" height="16" rx="1"></rect>
				<rect x="14" y="4" width="4" height="16" rx="1"></rect>
			</svg>
		</span>
	</button>
</div>

<style>
	.yt {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ratio);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		background: #0c0c0c;
	}

	.yt :global(.yt__player-wrap) {
		position: absolute;
		inset: 0;
	}

	.yt :global(.yt__player-wrap iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
		/* Cross-origin YouTube document — a click inside it can never be
		   observed by our page's JS, so this sends clicks straight through
		   to .yt__catch (a same-origin button stacked on top, see below). */
		pointer-events: none;
	}

	.yt__cover,
	.yt__catch {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		cursor: pointer;
	}

	.yt__cover.is-hidden,
	.yt__catch.is-hidden {
		display: none;
	}

	.yt__cover {
		background: none;
	}

	.yt__thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.yt__cover::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(12, 16, 24, 0.28);
		transition: background 0.15s ease;
	}

	.yt__cover:hover::after {
		background: rgba(12, 16, 24, 0.4);
	}

	.yt__icon {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: #fff;
		color: var(--color-sky-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 4px;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
		transition: transform 0.15s ease;
	}

	.yt__cover:hover .yt__icon {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.yt__catch {
		background: none;
	}

	.yt__catch-icon {
		position: absolute;
		bottom: 0.85rem;
		right: 0.85rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		transition: background 0.15s ease;
	}

	.yt__catch:hover .yt__catch-icon {
		background: rgba(0, 0, 0, 0.65);
	}

	.yt__catch-icon svg {
		width: 15px;
		height: 15px;
		fill: currentColor;
	}
</style>

<script>
	let ytApiPromise;

	function loadYouTubeApi() {
		if (window.YT && window.YT.Player) return Promise.resolve(window.YT);
		if (ytApiPromise) return ytApiPromise;

		ytApiPromise = new Promise((resolve) => {
			const previousCallback = window.onYouTubeIframeAPIReady;
			window.onYouTubeIframeAPIReady = () => {
				previousCallback?.();
				resolve(window.YT);
			};
			const script = document.createElement("script");
			script.src = "https://www.youtube.com/iframe_api";
			document.head.appendChild(script);
		});
		return ytApiPromise;
	}

	function initYouTubeEmbeds() {
		document.querySelectorAll(".yt").forEach((el) => {
			if (!(el instanceof HTMLElement) || el.dataset.ytInit === "true") return;
			el.dataset.ytInit = "true";

			const videoId = el.dataset.ytId;
			const playerWrap = el.querySelector(".yt__player-wrap");
			const cover = el.querySelector(".yt__cover");
			const catchBtn = el.querySelector(".yt__catch");
			if (!videoId || !playerWrap || !cover || !catchBtn) return;

			let YT;
			let player;

			function showCoveredState(showCover) {
				cover.classList.toggle("is-hidden", !showCover);
				catchBtn.classList.toggle("is-hidden", showCover);
			}

			function onStateChange(event) {
				// Playing or actively buffering into playback are the only
				// states where YouTube's own idle/paused overlay is gone —
				// everything else (unstarted, paused, ended, cued) shows
				// it, so our opaque cover takes over for those instead.
				const isPlayingOrBuffering =
					event.data === YT.PlayerState.PLAYING || event.data === YT.PlayerState.BUFFERING;
				showCoveredState(!isPlayingOrBuffering);
			}

			async function createPlayer() {
				const playerId = `yt-player-${Math.random().toString(36).slice(2, 9)}`;
				const target = document.createElement("div");
				target.id = playerId;
				playerWrap.appendChild(target);

				YT = await loadYouTubeApi();

				player = new YT.Player(playerId, {
					videoId,
					host: "https://www.youtube-nocookie.com",
					playerVars: {
						autoplay: 1,
						rel: 0,
						controls: 0,
						modestbranding: 1,
						iv_load_policy: 3,
						playsinline: 1,
					},
					events: { onStateChange },
				});
			}

			cover.addEventListener("click", async () => {
				if (!player) {
					await createPlayer();
				} else {
					player.playVideo();
				}
			});

			catchBtn.addEventListener("click", () => {
				player?.pauseVideo();
			});
		});
	}

	initYouTubeEmbeds();
	document.addEventListener("astro:page-load", initYouTubeEmbeds);
</script>
