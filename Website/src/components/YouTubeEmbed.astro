---
interface Props {
	id: string;
	title: string;
	aspectRatio?: string;
}

const { id, title, aspectRatio = "16 / 9" } = Astro.props;
const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" style={`--ratio: ${aspectRatio};`} data-yt-id={id} data-yt-title={title}>
	<button type="button" class="yt__play" aria-label={`Play video: ${title}`}>
		<img src={thumbnail} alt="" class="yt__thumb" loading="lazy" />
		<span class="yt__icon" aria-hidden="true">
			<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor">
				<path d="M8 5v14l11-7z"></path>
			</svg>
		</span>
	</button>
</div>

<style>
	.yt {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ratio);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		background: #0c0c0c;
	}

	.yt__play {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		padding: 0;
		border: none;
		margin: 0;
		cursor: pointer;
		display: block;
		background: none;
	}

	.yt__thumb {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.yt__play::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(12, 16, 24, 0.28);
		transition: background 0.15s ease;
	}

	.yt__play:hover::after {
		background: rgba(12, 16, 24, 0.4);
	}

	.yt__icon {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 68px;
		height: 68px;
		border-radius: 50%;
		background: #fff;
		color: var(--color-sky-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		padding-left: 4px;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
		transition: transform 0.15s ease;
	}

	.yt__play:hover .yt__icon {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.yt :global(.yt__iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
</style>

<script>
	function initYouTubeEmbeds() {
		document.querySelectorAll(".yt").forEach((el) => {
			if (!(el instanceof HTMLElement) || el.dataset.ytInit === "true") return;
			el.dataset.ytInit = "true";

			const button = el.querySelector(".yt__play");
			button?.addEventListener("click", () => {
				const id = el.dataset.ytId;
				const title = el.dataset.ytTitle || "YouTube video";

				const iframe = document.createElement("iframe");
				iframe.className = "yt__iframe";
				iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
				iframe.title = title;
				iframe.allow =
					"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
				iframe.allowFullscreen = true;

				el.innerHTML = "";
				el.appendChild(iframe);
			});
		});
	}

	initYouTubeEmbeds();
	document.addEventListener("astro:page-load", initYouTubeEmbeds);
</script>
