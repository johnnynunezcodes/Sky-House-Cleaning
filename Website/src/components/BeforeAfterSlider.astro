---
interface Props {
	beforeSrc: string;
	afterSrc: string;
	alt: string;
	beforeLabel?: string;
	afterLabel?: string;
	aspectRatio?: string;
}

const {
	beforeSrc,
	afterSrc,
	alt,
	beforeLabel = "Before",
	afterLabel = "After",
	aspectRatio = "4 / 3",
} = Astro.props;
---

<div class="ba-slider" style={`--pos: 50%; --ratio: ${aspectRatio};`}>
	<img class="ba-slider__img" src={beforeSrc} alt={`${alt} — before`} loading="lazy" />
	<img class="ba-slider__img ba-slider__img--after" src={afterSrc} alt={`${alt} — after`} loading="lazy" />

	<span class="ba-slider__tag ba-slider__tag--before">{beforeLabel}</span>
	<span class="ba-slider__tag ba-slider__tag--after">{afterLabel}</span>

	<div class="ba-slider__handle" aria-hidden="true">
		<span class="ba-slider__grip">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none">
				<path d="M9 6l-6 6 6 6M15 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</span>
	</div>

	<input
		type="range"
		class="ba-slider__range"
		min="0"
		max="100"
		value="50"
		aria-label={`Drag to compare before and after: ${alt}`}
	/>
</div>

<style>
	.ba-slider {
		position: relative;
		width: 100%;
		aspect-ratio: var(--ratio);
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		user-select: none;
		touch-action: pan-y;
	}

	.ba-slider__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		pointer-events: none;
	}

	.ba-slider__img--after {
		clip-path: inset(0 0 0 var(--pos));
	}

	.ba-slider__tag {
		position: absolute;
		bottom: 0.9rem;
		background: rgba(28, 43, 69, 0.72);
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		pointer-events: none;
	}

	.ba-slider__tag--before {
		left: 0.9rem;
	}

	.ba-slider__tag--after {
		right: 0.9rem;
	}

	.ba-slider__handle {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--pos);
		width: 0;
		pointer-events: none;
	}

	.ba-slider__handle::before {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		left: -1px;
		width: 2px;
		background: #fff;
		box-shadow: 0 0 0 1px rgba(28, 43, 69, 0.25);
	}

	.ba-slider__grip {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 42px;
		height: 42px;
		border-radius: 50%;
		background: #fff;
		color: var(--color-sky-dark);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2px;
		box-shadow: 0 4px 14px rgba(28, 43, 69, 0.3);
	}

	.ba-slider__range {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		background: transparent;
		cursor: ew-resize;
		-webkit-appearance: none;
		appearance: none;
	}

	.ba-slider__range::-webkit-slider-runnable-track {
		background: transparent;
		height: 100%;
	}

	.ba-slider__range::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 6px;
		height: 100%;
		background: transparent;
		cursor: ew-resize;
	}

	.ba-slider__range::-moz-range-track {
		background: transparent;
		height: 100%;
		border: none;
	}

	.ba-slider__range::-moz-range-thumb {
		width: 6px;
		height: 100%;
		background: transparent;
		border: none;
		cursor: ew-resize;
	}
</style>

<script>
	function initBeforeAfterSliders() {
		document.querySelectorAll<HTMLElement>(".ba-slider").forEach((el) => {
			const range = el.querySelector<HTMLInputElement>(".ba-slider__range");
			if (!range || el.dataset.baInit === "true") return;
			el.dataset.baInit = "true";

			const update = () => {
				el.style.setProperty("--pos", `${range.value}%`);
			};

			range.addEventListener("input", update);
			update();
		});
	}

	initBeforeAfterSliders();
	document.addEventListener("astro:page-load", initBeforeAfterSliders);
</script>
