---
const year = new Date().getFullYear();

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "About", href: "/about" },
	{ label: "Services", href: "/services" },
	{ label: "Booking", href: "/booking" },
	{ label: "Reviews", href: "/reviews" },
	{ label: "Contact", href: "/contact" },
];
---

<footer class="footer">
	<div class="container footer__inner">
		<a href="/" class="footer__brand">
			<img
				src="/images/logo-icon.svg"
				alt="Sky House Cleaning"
				class="footer__logo"
				width="36"
				height="36"
			/>
			<span>Sky House Cleaning</span>
		</a>

		<nav class="footer__nav" aria-label="Footer navigation">
			<ul>
				{navLinks.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="footer__contact">
			<a href="tel:+18017592044">(801) 759-2044</a>
			<a href="mailto:info@skyhousecleaning.com">info@skyhousecleaning.com</a>
		</div>

		<!-- TODO: once online booking is set up, add a "Book Now" link here pointing to the booking tool -->
	</div>

	<div class="footer__bottom container">
		<p>Serving Oakland &amp; the greater Bay Area</p>
		<p>&copy; {year} Sky House Cleaning. All rights reserved.</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-ink);
		color: #cfd7e4;
		margin-top: 4rem;
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 2.25rem 1.5rem;
	}

	.footer__brand {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		text-decoration: none;
		color: #fff;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	.footer__logo {
		display: block;
		width: 36px;
		height: 36px;
		filter: brightness(0) invert(1);
	}

	.footer__nav ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.75rem;
		margin: 0;
		padding: 0;
	}

	.footer__nav a {
		color: #f2f4f8;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
	}

	.footer__nav a:hover {
		color: var(--color-sky);
		text-decoration: underline;
	}

	.footer__contact {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
		flex-shrink: 0;
	}

	.footer__contact a {
		display: block;
		color: #f2f4f8;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
	}

	.footer__contact a:hover {
		color: var(--color-sky);
		text-decoration: underline;
	}

	.footer__bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding: 1.1rem 1.5rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.footer__bottom p {
		margin: 0;
		color: #8b96a9;
		font-size: 0.8rem;
	}

	@media (max-width: 720px) {
		.footer__inner {
			flex-direction: column;
			text-align: center;
		}

		.footer__nav ul {
			justify-content: center;
		}

		.footer__contact {
			align-items: center;
		}

		.footer__bottom {
			justify-content: center;
			text-align: center;
		}
	}
</style>
