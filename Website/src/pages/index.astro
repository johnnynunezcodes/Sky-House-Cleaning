---
import Layout from "../layouts/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import CtaBand from "../components/CtaBand.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import { cleaningServices, otherServices, commercialServices, testimonials } from "../data/content.js";

const galleryPhotos = [
	{
		src: "/images/general/kitchen.jpg",
		alt: "Spotless kitchen island and cabinetry after a Sky House Cleaning visit",
	},
	{
		src: "/images/general/bedroom.jpg",
		alt: "Freshly cleaned, tidy bedroom",
	},
	{
		src: "/images/general/bathroom-towels.jpg",
		alt: "Neatly hung towels and an organized bathroom counter",
	},
	{
		src: "/images/general/bathroom-sink.jpg",
		alt: "Sparkling clean bathroom sink",
	},
];
---

<Layout
	title="Sky House Cleaning | Bay Area Home & Commercial Cleaning"
	description="Trusted, detail-oriented cleaning for the San Francisco Bay Area. One-time, weekly, bi-weekly, and monthly home cleaning memberships, car detailing, garage organization, and office & commercial cleaning."
>
	<section class="hero">
		<div class="container hero__inner">
			<p class="eyebrow">Serving Oakland &amp; the Bay Area</p>
			<h1>A cleaner space, cared for like it's our own</h1>
			<p class="hero__lede">
				One-time visits, recurring memberships, move-in/move-out cleans, car detailing, garage
				organization, and office & commercial cleaning. Reliable, detail-oriented service so you
				can spend less time on cleaning and more time on what matters.
			</p>
			<div class="hero__actions">
				<a href="/booking" class="btn btn--primary">Schedule Your Cleaning</a>
				<a href="/services" class="btn btn--outline">See Our Services</a>
			</div>
			<div class="hero__video">
				<YouTubeEmbed
					id="SZehzr-16lA"
					title="Sky House Cleaning | Company Overview"
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Cleaning Tailored to Your Needs</p>
				<h2>Whatever your home needs, we'll build a plan around it</h2>
				<p>
					Whether you want a recurring membership, a one-time deep clean, or help getting your
					garage back in order, we'll put together a plan that fits your schedule and your space.
					Our goal is simple: consistent, thorough cleaning you can count on, every visit. Running
					a business? See how we help offices and job sites below.
				</p>
			</div>

			<div class="grid grid--4">
				{cleaningServices.map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">More Ways We Help</p>
				<h2>Beyond the home</h2>
				<p>Vehicle care, organization, and cleaning for offices and job sites.</p>
			</div>
			<div class="grid grid--2">
				{[...otherServices, ...commercialServices].map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">See the Difference</p>
				<h2>A real kitchen, before and after</h2>
				<p>Drag the slider to see what a Sky House Cleaning visit looks like in person.</p>
			</div>
			<div class="before-after-wrap">
				<BeforeAfterSlider
					beforeSrc="/images/before-after/kitchen-before.jpg"
					afterSrc="/images/before-after/kitchen-after.jpg"
					alt="Kitchen cleaned by Sky House Cleaning"
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Recent Work</p>
				<h2>A closer look at our results</h2>
				<p>A few shots from a recent visit, the kind of clean we aim for every time.</p>
			</div>
			<div class="gallery">
				{galleryPhotos.map((photo) => (
					<div class="gallery-item">
						<img src={photo.src} alt={photo.alt} loading="lazy" />
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Client Experiences</p>
				<h2>Your satisfaction is our top priority</h2>
			</div>
			<div class="grid grid--3">
				{testimonials.map((t) => (
					<TestimonialCard quote={t.quote} name={t.name} />
				))}
			</div>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero {
		padding: 5rem 0 4rem;
		background: var(--color-white);
	}

	.hero__inner {
		max-width: 760px;
		text-align: center;
		margin: 0 auto;
	}

	.hero__lede {
		font-size: 1.1rem;
		max-width: 620px;
		margin: 0 auto 2rem;
	}

	.hero__actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.hero__video {
		max-width: 680px;
		margin: 2.75rem auto 0;
	}

	.before-after-wrap {
		max-width: 760px;
		margin: 0 auto;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
	}

	.gallery-item {
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		aspect-ratio: 3 / 4;
	}

	.gallery-item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 720px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.hero {
			padding: 3.5rem 0 2.5rem;
		}
	}
</style>
