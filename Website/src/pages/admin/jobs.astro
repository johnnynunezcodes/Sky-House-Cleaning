			}

			.admin-result-message--error {
				color: #b3261e;
			}

			/* --- List view: overview cards ---------------------------------------- */

			.admin-overview-row {
				display: grid;
				grid-template-columns: minmax(220px, 1.4fr) repeat(2, minmax(160px, 1fr));
				gap: 0.75rem;
				margin-bottom: 1.25rem;
				align-items: stretch;
			}

			@media (max-width: 800px) {
