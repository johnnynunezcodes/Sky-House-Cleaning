			}

			.admin-list-search {
				padding: 0.5rem 0.85rem;
				border: 1px solid var(--color-border);
				border-radius: 999px;
				font-size: 0.85rem;
				font-family: inherit;
				min-width: 220px;
			}

			/* --- List view: table -------------------------------------------------- */

			.admin-table-wrap {
				overflow-x: auto;
				border: 1px solid var(--color-border);
				border-radius: 10px;
			}

			.admin-table {
				width: 100%;
				border-collapse: collapse;
				font-size: 0.88rem;
			}

			.admin-table th,
			.admin-table td {
				text-align: left;
				padding: 0.65rem 1rem;
				border-bottom: 1px solid var(--color-border);
			}

			.admin-table th {
				background: var(--color-sky-light);
				font-weight: 600;
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				color: var(--color-slate);
				white-space: nowrap;
			}

			.admin-jobs-table th[data-sort] {
				cursor: pointer;
				user-select: none;
			}

			.admin-jobs-table th[data-sort]:hover {
				color: var(--color-sky-dark);
			}

			.admin-jobs-table th[data-sort].is-sorted-asc::after {
				content: " ▲";
				font-size: 0.65rem;
			}

			.admin-jobs-table th[data-sort].is-sorted-desc::after {
				content: " ▼";
				font-size: 0.65rem;
			}

			.admin-jobs-table tbody tr:last-child td {
				border-bottom: none;
			}

			.admin-jobs-table__row {
				cursor: pointer;
			}

			.admin-jobs-table__row:hover {
				background: var(--color-sky-light);
			}

			.admin-table__sub {
				margin-top: 0.15rem;
				font-size: 0.75rem;
				color: var(--color-slate-light);
			}

			.admin-table__sub--paid {
				color: #1e7a34;
				font-weight: 600;
			}

			.admin-card__meta--quote {
				font-weight: 600;
				color: var(--color-ink);
			}

			.admin-table__empty {
				text-align: center;
				color: var(--color-slate-light);
				padding: 2rem 1rem;
			}

			/* --- Shared chip (used by Week columns) ------------------------------ */

			.admin-chip {
				display: block;
				width: 100%;
				text-align: left;
				background: var(--color-cream);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				padding: 0.5rem 0.65rem;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-chip:hover {
				border-color: var(--color-sky);
			}

			.admin-chip--unassigned {
				background: #fdeceb;
				border-color: #f3c8c5;
			}

			.admin-chip__time {
				display: block;
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--color-ink);
			}

			.admin-chip__summary {
				display: block;
				margin: 0.15rem 0;
				font-size: 0.8rem;
				color: var(--color-slate);
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.admin-chip__cleaners {
				display: block;
				margin: 0 0 0.4rem;
				font-size: 0.75rem;
				color: var(--color-slate);
			}

			.admin-chip__cleaners--empty {
				color: #b3261e;
				font-weight: 600;
			}

			.admin-chip__footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.4rem;
			}

			/* --- Week board --------------------------------------------------- */

			.admin-week-board {
				display: grid;
				grid-template-columns: repeat(7, minmax(160px, 1fr));
				gap: 0.75rem;
				overflow-x: auto;
				padding-bottom: 0.5rem;
			}

			.admin-week-col {
				background: var(--color-white);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				padding: 0.75rem;
				min-height: 120px;
			}

			.admin-week-col.is-today {
				border-color: var(--color-sky);
				box-shadow: 0 0 0 1px var(--color-sky);
			}

			.admin-week-col__header {
				display: flex;
				align-items: baseline;
				gap: 0.4rem;
				width: 100%;
				margin-bottom: 0.6rem;
				padding: 0 0 0.5rem;
				border: none;
				border-bottom: 1px solid var(--color-border);
				background: none;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-week-col__day {
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--color-slate-light);
				font-weight: 600;
			}

			.admin-week-col__date {
				font-family: var(--font-heading);
				font-weight: 700;
				color: var(--color-ink);
			}

			.admin-week-col__badge {
				margin-left: auto;
				background: #fdeceb;
				color: #b3261e;
				border-radius: 999px;
				padding: 0.05rem 0.5rem;
				font-size: 0.72rem;
				font-weight: 700;
			}

			.admin-week-col__jobs {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.admin-week-empty {
				margin: 0;
				font-size: 0.8rem;
				color: var(--color-slate-light);
			}

			/* --- Month grid ----------------------------------------------------- */

			.admin-month-weekdays {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				margin-bottom: 0.4rem;
			}

			.admin-month-weekdays span {
				text-align: center;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				color: var(--color-slate-light);
			}

			.admin-month-grid {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				gap: 0.4rem;
			}

			.admin-month-pad {
				display: block;
			}

			.admin-month-day {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				min-height: 90px;
				padding: 0.4rem;
				border-radius: 10px;
				border: 1px solid var(--color-border);
				background: var(--color-white);
			}

			.admin-month-day.is-today {
				border-color: var(--color-sky);
				box-shadow: 0 0 0 1px var(--color-sky);
			}

			.admin-month-day.has-unassigned {
				background: #fdeceb;
			}

			.admin-month-day__header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.3rem;
				border: none;
				background: none;
				padding: 0;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-month-day__num {
				font-family: var(--font-heading);
				font-weight: 700;
				color: var(--color-ink);
				font-size: 0.9rem;
			}

			.admin-month-day__count {
				font-size: 0.65rem;
				font-weight: 600;
				color: var(--color-slate-light);
				background: var(--color-sky-light);
				border-radius: 999px;
				padding: 0.05rem 0.4rem;
				white-space: nowrap;
			}

			.admin-month-day__chips {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			.admin-month-chip {
				display: flex;
				align-items: center;
				gap: 0.3rem;
				width: 100%;
				text-align: left;
				border: none;
				border-radius: 6px;
				background: #eaf1fb;
				color: #1a3a5c;
				padding: 0.15rem 0.35rem;
				font-size: 0.7rem;
				font-family: inherit;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				cursor: pointer;
			}

			.admin-month-chip__dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: #1a5fb4;
				flex-shrink: 0;
			}

			.admin-month-chip--unassigned {
				background: #fdeceb;
				color: #7a1a15;
			}

			.admin-month-chip--unassigned .admin-month-chip__dot {
				background: #b3261e;
			}

			/* --- Day view: hour grid, one column per cleaner --------------------- */

			.admin-daygrid {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				overflow-x: auto;
				background: var(--color-white);
			}

			.admin-daygrid__empty {
				margin: 1rem 1.25rem 0;
			}

			.admin-daygrid__inner {
				min-width: fit-content;
			}

			.admin-daygrid__headers,
			.admin-daygrid__body {
				display: flex;
			}

			.admin-daygrid__gutter-cell,
			.admin-daygrid__gutter {
				width: 64px;
				flex-shrink: 0;
			}

			.admin-daygrid__headers {
				border-bottom: 1px solid var(--color-border);
				position: sticky;
				top: 0;
				background: var(--color-white);
				z-index: 2;
			}

			.admin-daygrid__col-header {
				flex: 1 0 170px;
				padding: 0.6rem 0.75rem;
				border-left: 1px solid var(--color-border);
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.admin-daygrid__col-header--unassigned {
				color: #b3261e;
			}

			.admin-daygrid__gutter {
				position: relative;
			}

			.admin-daygrid__hour-label {
				position: absolute;
				right: 8px;
				/* Sits just below the gridline marking the start of this hour,
				   not centered on it (no translateY(-50%)) — centering it on
				   the line pushed the topmost label half above the grid's own
				   top edge, right where it visually collided with the header
				   row's bottom border, making "8 AM" look cut in half. */
				top: 4px;
				font-size: 0.7rem;
				color: var(--color-slate-light);
				white-space: nowrap;
			}

			.admin-daygrid__col {
				position: relative;
				flex: 1 0 170px;
				border-left: 1px solid var(--color-border);
			}

			.admin-daygrid__gridline {
				position: absolute;
				left: 0;
				right: 0;
				border-top: 1px solid var(--color-border);
			}

			.admin-daygrid__block {
				position: absolute;
				left: 4px;
				right: 4px;
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
				border-radius: 6px;
				background: #eaf1fb;
				border: 1px solid #1a5fb4;
				color: #1a3a5c;
				text-align: left;
				padding: 0.25rem 0.4rem;
				overflow: hidden;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-daygrid__block:hover {
				filter: brightness(0.97);
			}

			.admin-daygrid__block--unassigned {
				background: #fdeceb;
				border-color: #b3261e;
				color: #7a1a15;
			}

			.admin-daygrid__block-time {
				font-size: 0.68rem;
				font-weight: 700;
			}

			.admin-daygrid__block-title {
				font-size: 0.75rem;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			/* --- Job detail modal (List/Month/Week/Day all share this) ----------- */

			.admin-modal-backdrop {
				position: fixed;
				inset: 0;
				z-index: 80;
				background: rgba(28, 43, 69, 0.45);
				display: flex;
				align-items: flex-start;
				justify-content: center;
				padding: 4rem 1.5rem;
				overflow-y: auto;
			}

			.admin-modal-backdrop[hidden] {
				display: none;
			}

			.admin-modal {
				width: 100%;
				max-width: 480px;
				padding: 1.5rem;
			}

			.admin-modal__header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--color-border);
			}

			.admin-modal__header h3 {
				margin: 0 0 0.3rem;
			}

			.admin-modal__close {
				flex-shrink: 0;
				width: 32px;
				height: 32px;
				border-radius: 50%;
				border: 1px solid var(--color-border);
				background: var(--color-white);
				color: var(--color-slate);
				cursor: pointer;
				font-size: 0.9rem;
			}

			.admin-modal__close:hover {
				border-color: var(--color-sky);
				color: var(--color-sky-dark);
			}

			.admin-modal__body {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			@media (max-width: 900px) {
				.admin-week-board {
					grid-template-columns: repeat(7, minmax(150px, 1fr));
				}
			}
		</style>
</AdminLayout>
