---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Reads
// real bookings straight from Google Calendar (the existing source of
// truth) and layers on a Firestore overlay for assignment/status. See
// AGENTS.md → "Jobs (formerly Dispatcher)" and src/lib/dispatch.js for why
// it's built this way instead of a duplicated `jobs` collection.
//
// List-only now — Day/Week/Month moved to the separate /admin/schedule page
// (see AGENTS.md → "Schedule (split from Jobs)") after the business owner
// asked for Jobber's own Schedule/Jobs split, rather than one page trying to
// be both. This page keeps the flat, filterable/searchable table with
// Jobber-style Overview/Status filtering (Late/Requires Invoicing/Action
// Required/Unscheduled/Archived, etc. — see the big comment block in the
// List view section below) and its own job-detail modal (team/status/notes/
// archive/hold) — day-to-day calendar assignment now happens on Schedule,
// which has a different, three-tier click-to-edit pattern of its own.
//
// Deliberate departures from Jobber's exact layout, worth knowing about
// rather than discovering by their absence:
// - No "Job number" column removed — this app DOES have one (`jobNumber`,
//   from `getNextJobNumber()` in dispatch.js), shown as its own column.
// - Status/Job Type filters are plain <select> dropdowns, not Jobber's
//   checkbox-multiselect popovers — /admin/schedule got the popover
//   treatment instead, since its Type/Team/Status filters needed to combine
//   (AND) rather than this page's single-value Status dropdown.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { WORKING_HOURS, QUOTE_SERVICE_TYPES } from "../../data/booking.js";
---

<AdminLayout title="Jobs | Sky House Cleaning Staff Tools">
			<div
				class="container admin-container"
				id="jobs-page"
				data-working-hours-start={WORKING_HOURS.start}
				data-working-hours-end={WORKING_HOURS.end}
				data-quote-service-types={JSON.stringify(QUOTE_SERVICE_TYPES)}
			>
				<h1>Jobs</h1>
				<p class="admin-hint">
					Every real job on the calendar, with billing totals and the statuses that need your
					attention. This reads directly from Google Calendar, not a separate copy — reschedules,
					cancellations, and new bookings show up here automatically. For the day-to-day calendar
					and cleaner assignment, see <a href="/admin/schedule">Schedule</a>.
				</p>

				<p id="load-status" class="admin-status">Loading…</p>

				<div id="list-view" class="admin-list-view">
					<div class="admin-overview-row">
						<div class="card admin-overview-list-card">
							<p class="admin-overview-card__label">Overview</p>
							<ul class="admin-overview-list" id="overview-list">
								<li class="admin-overview-list__item" data-filter="late" tabindex="0" role="button">
									<span>Late</span>
									<span class="admin-overview-list__count" id="stat-late-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="requires_invoicing" tabindex="0" role="button">
									<span>Requires Invoicing</span>
									<span class="admin-overview-list__count" id="stat-invoicing-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="action_required" tabindex="0" role="button">
									<span>Action Required</span>
									<span class="admin-overview-list__count" id="stat-action-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="unscheduled" tabindex="0" role="button">
									<span>Unscheduled</span>
									<span class="admin-overview-list__count" id="stat-unscheduled-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="unassigned" tabindex="0" role="button">
									<span>Needs a Cleaner</span>
									<span class="admin-overview-list__count" id="stat-unassigned-count">0</span>
								</li>
							</ul>
						</div>
						<div class="card admin-overview-card">
							<p class="admin-overview-card__label">Recent Visits</p>
							<p class="admin-overview-card__sub">Past 30 days</p>
							<p class="admin-overview-card__value" id="stat-recent-count">0</p>
							<p class="admin-overview-card__meta" id="stat-recent-total">$0.00</p>
						</div>
						<div class="card admin-overview-card">
							<p class="admin-overview-card__label">Visits Scheduled</p>
							<p class="admin-overview-card__sub">Next 30 days</p>
							<p class="admin-overview-card__value" id="stat-upcoming-count">0</p>
							<p class="admin-overview-card__meta" id="stat-upcoming-total">$0.00</p>
						</div>
					</div>

					<div class="admin-list-toolbar">
						<div class="admin-list-filters">
							<select id="list-status-filter">
								<option value="all">Status: All</option>
								<optgroup label="Job status">
									<option value="active">Active</option>
									<option value="today">Today</option>
									<option value="upcoming">Upcoming</option>
									<option value="late">Late</option>
									<option value="unscheduled">Unscheduled</option>
									<option value="action_required">Action Required</option>
									<option value="requires_invoicing">Requires Invoicing</option>
									<option value="archived">Archived</option>
								</optgroup>
								<optgroup label="Cleaner status">
									<option value="unassigned">Unassigned</option>
									<option value="assigned">Assigned</option>
									<option value="en_route">En route</option>
									<option value="in_progress">In progress</option>
									<option value="completed">Completed</option>
								</optgroup>
							</select>
							<select id="list-type-filter">
								<option value="all">Job Type: All</option>
								<option value="one_time">One-off jobs</option>
								<option value="recurring">Recurring jobs</option>
								<option value="quote_based">Quote-based jobs</option>
							</select>
						</div>
						<input type="search" id="list-search" class="admin-list-search" placeholder="Search jobs…" />
					</div>

					<p id="list-results-count" class="admin-hint admin-hint--tight"></p>

					<div class="admin-table-wrap" id="jobs-table-wrap">
						<table class="admin-table admin-jobs-table">
							<thead>
								<tr>
									<th data-sort="jobNumber">Job #</th>
									<th data-sort="client">Client</th>
									<th data-sort="service">Service</th>
									<th data-sort="location">Property</th>
									<th data-sort="start" class="is-sorted-asc">Schedule</th>
									<th data-sort="status">Status</th>
									<th data-sort="amountPaid">Total</th>
								</tr>
							</thead>
							<tbody id="list-table-body"></tbody>
						</table>
					</div>

					<div class="admin-table-wrap" id="action-required-panel" hidden>
						<table class="admin-table admin-jobs-table">
							<thead>
								<tr>
									<th>Client</th>
									<th>Phone</th>
									<th>Plan</th>
									<th>Status</th>
									<th></th>
								</tr>
							</thead>
							<tbody id="action-required-table-body"></tbody>
						</table>
					</div>
				</div>
			</div>

		<script>
			const root = document.getElementById("jobs-page");
			const WORKING_HOURS_START = Number(root?.dataset.workingHoursStart) || 8;
			const WORKING_HOURS_END = Number(root?.dataset.workingHoursEnd) || 18;

			const loadStatus = document.getElementById("load-status");

			// Human labels for a paused subscription's billing frequency, shown
			// in the Action Required panel — same wording
			// /admin/minimum-commitments.astro already uses for the same field.
			const FREQUENCY_LABELS = { weekly: "Weekly", biweekly: "Bi-Weekly", monthly: "Monthly" };

			const QUOTE_SERVICE_LABELS = JSON.parse(root?.dataset.quoteServiceTypes || "{}");

			const STATUS_LABELS = {
				unassigned: "Unassigned",
				assigned: "Assigned",
				en_route: "En route",
				in_progress: "In progress",
				completed: "Completed",
			};
			const STATUS_ORDER = ["unassigned", "assigned", "en_route", "in_progress", "completed"];

			let cleaners = [];

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function todayLocalIso() {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			}

			function fmtTime(iso) {
				return new Date(iso).toLocaleTimeString("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "numeric",
					minute: "2-digit",
				});
			}

			function fmtDateTime(iso) {
				return new Date(iso).toLocaleDateString("en-US", {
					timeZone: "America/Los_Angeles",
					weekday: "short",
					month: "short",
					day: "numeric",
				});
			}

			// Minutes since local (Pacific) midnight — used for the Day view
			// grid's time-to-pixel math. `hour12: false` can return "24" for
			// midnight in some environments, hence the `% 24`.
			function minutesSinceMidnightPT(iso) {
				const parts = new Intl.DateTimeFormat("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				}).formatToParts(new Date(iso));
				const hour = Number(parts.find((p) => p.type === "hour")?.value || "0") % 24;
				const minute = Number(parts.find((p) => p.type === "minute")?.value || "0");
				return hour * 60 + minute;
			}

			function addDays(dateStr, delta) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() + delta);
				return date.toISOString().slice(0, 10);
			}

			// Sunday-start, matching the weekday header row used both here and on
			// the public/admin booking pages' own calendar (schedule.astro,
			// admin/book.astro).
			function startOfWeek(dateStr) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() - date.getUTCDay());
				return date.toISOString().slice(0, 10);
			}

			function startOfMonth(dateStr) {
				return `${dateStr.slice(0, 7)}-01`;
			}

			function daysInMonthCount(dateStr) {
				const [y, m] = dateStr.split("-").map(Number);
				return new Date(Date.UTC(y, m, 0)).getUTCDate();
			}

			// Always normalized to the 1st — month view only ever anchors to
			// "which month," never a specific day within it.
			function addMonths(dateStr, delta) {
				const [y, m] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1 + delta, 1));
				return date.toISOString().slice(0, 10);
			}

			function localDate(dateStr) {
				// Deliberately NOT `new Date(dateStr)` — that parses "YYYY-MM-DD" as
				// UTC midnight, which can print as the previous day in a
				// west-of-UTC browser. Appending a local time-of-day avoids that.
				return new Date(dateStr + "T00:00:00");
			}

			function groupByDate(jobs) {
				const map = new Map();
				for (const j of jobs) {
					if (!map.has(j.visitDate)) map.set(j.visitDate, []);
					map.get(j.visitDate).push(j);
				}
				for (const arr of map.values()) arr.sort((a, b) => new Date(a.start) - new Date(b.start));
				return map;
			}

			function cleanerNamesFor(ids) {
				return (ids || []).map((id) => cleaners.find((c) => c.id === id)?.name).filter(Boolean);
			}

			// The calendar event's summary is always written server-side as
			// "Sky House Cleaning: {name}, {service}" (see stripe-webhook.js) —
			// reliable enough to parse back apart for the List view's Client/
			// Service columns on jobs that predate the clientName private field
			// below.
			function parseSummary(summary) {
				const m = (summary || "").match(/^Sky House Cleaning: (.+?), (.+)$/);
				return m ? { client: m[1], service: m[2] } : { client: summary || "—", service: "" };
			}

			function clientNameFor(job) {
				return job.clientName || parseSummary(job.summary).client;
			}

			function serviceNameFor(job) {
				// Unscheduled quote pseudo-rows (see loadListView) have no calendar
				// event summary to parse a service name back out of — their label
				// comes straight from the quote's own serviceType instead.
				if (job.isUnscheduled) return job.serviceLabel || "";
				return parseSummary(job.summary).service;
			}

			// `amountPaid` only exists on jobs booked after this field was added
			// (see googleCalendar.js's extendedProperties.private comment) —
			// older jobs on the calendar simply won't have it. Quote-based jobs
			// (see create-quote-job.js) don't have amountPaid at creation at
			// all — nothing's been paid yet, only quoted — so those show the
			// quoted total instead, which is what a "Total" column should mean
			// for a job billed outside Stripe's automatic flow.
			function amountLabel(job) {
				if (job.jobType === "quote_based") {
					return job.quotedTotal ? `$${job.quotedTotal}` : "N/A";
				}
				return job.amountPaid ? `$${job.amountPaid}` : "N/A";
			}

			function amountSortValue(job) {
				return parseFloat(job.jobType === "quote_based" ? job.quotedTotal : job.amountPaid) || 0;
			}

			// A small pending/paid indicator shown next to Total for quote-based
			// jobs only — depositStatus lives in the Firestore jobAssignments
			// overlay (see list-jobs.js), not the calendar event, since it's the
			// one thing about a quote job's money that actually changes after
			// creation (flipped by stripe-webhook.js once the customer pays).
			function depositBadge(job) {
				if (job.jobType !== "quote_based") return "";
				const paid = job.depositStatus === "paid";
				return `<div class="admin-table__sub${paid ? " admin-table__sub--paid" : ""}">
					Deposit ${paid ? "paid ✓" : `pending${job.depositAmount ? ` ($${job.depositAmount})` : ""}`}
				</div>`;
			}

			// Cleaner roster management (add/deactivate) moved to
			// /admin/schedule — this page only needs the roster itself, to
			// resolve assignedCleanerIds into names for the table.
			async function loadCleaners() {
				try {
					const res = await fetch("/api/admin/dispatch/list-cleaners");
					const data = await res.json();
					if (res.ok) cleaners = data.cleaners || [];
				} catch {
					// Non-fatal — assignment dropdowns/names just come up empty.
				}
			}

			// --- List view: overview stats + filterable/sortable/searchable table --

			const statRecentCount = document.getElementById("stat-recent-count");
			const statRecentTotal = document.getElementById("stat-recent-total");
			const statUpcomingCount = document.getElementById("stat-upcoming-count");
			const statUpcomingTotal = document.getElementById("stat-upcoming-total");
			const statUnassignedCount = document.getElementById("stat-unassigned-count");
			const statLateCount = document.getElementById("stat-late-count");
			const statInvoicingCount = document.getElementById("stat-invoicing-count");
			const statActionCount = document.getElementById("stat-action-count");
			const statUnscheduledCount = document.getElementById("stat-unscheduled-count");
			const overviewListEl = document.getElementById("overview-list");
			const listStatusFilterEl = document.getElementById("list-status-filter");
			const listTypeFilterEl = document.getElementById("list-type-filter");
			const listSearchEl = document.getElementById("list-search");
			const listResultsCountEl = document.getElementById("list-results-count");
			const listTableBody = document.getElementById("list-table-body");
			const listSortHeaders = Array.from(document.querySelectorAll("#list-view th[data-sort]"));
			const jobsTableWrap = document.getElementById("jobs-table-wrap");
			const actionRequiredPanel = document.getElementById("action-required-panel");
			const actionRequiredTableBody = document.getElementById("action-required-table-body");

			let listWindowJobs = [];
			let listPausedPlans = [];
			let listStatusFilter = "all";
			let listTypeFilter = "all";
			let listSortKey = "start";
			let listSortDir = "asc";

			// Statuses adapted from Jobber's own Jobs list (confirmed against
			// their help docs — see AGENTS.md → "Jobs" for the full mapping and
			// why "Ending Within 30 Days" was deliberately left out: this app's
			// recurring plans have no built-in end date, only an optional
			// early-cancellation date staff set by hand, so that stat would only
			// ever flag clients who've already told you they're leaving).
			//
			// `archived` jobs are hidden from every filter except "archived"
			// itself, checked first so none of the branches below need to repeat
			// that exclusion. Unscheduled quote pseudo-rows (see loadListView)
			// only ever match "all" or "unscheduled" — they have no status/date
			// for any of the other predicates to mean anything.
			function matchesStatusFilter(job, filter, today) {
				if (job.isUnscheduled) return filter === "all" || filter === "unscheduled";
				if (filter === "archived") return !!job.archived;
				if (job.archived) return false;
				if (filter === "all") return true;
				if (filter === "active") return job.status === "in_progress";
				if (filter === "today") return job.visitDate === today;
				if (filter === "upcoming") return job.visitDate > today;
				if (filter === "late") return job.visitDate < today && job.status !== "completed";
				if (filter === "requires_invoicing") return !!job.requiresInvoicing;
				if (filter === "unscheduled") return false;
				if (filter === "action_required") return false; // shown in its own panel, not table rows
				// Checked against assignedCleanerIds, not job.status, so this always
				// agrees with the "Needs a Cleaner" Overview count above (which
				// uses the same predicate) — status can go stale here: unassigning
				// every cleaner from an already-assigned/en-route job only resets
				// status back to "unassigned" when going the OTHER direction (see
				// the team-assignment change handler on the job detail page), so a
				// job can end up with assignedCleanerIds: [] while status still
				// reads "assigned".
				if (filter === "unassigned") return (job.assignedCleanerIds || []).length === 0;
				return job.status === filter;
			}

			// Fixed 90-day rolling window (30 days back, 60 forward) — enough to
			// cover Jobber's own "past 30 days" / "next 30 days" stat cards in one
			// read, with some headroom for the Late count. Jobs overdue by more
			// than 30 days won't be counted — an edge case for a small crew that
			// marks visits completed same-day, not worth a second query.
			//
			// Alongside the calendar read, this also pulls in accepted-but-
			// unscheduled quotes (Unscheduled), open invoices (Requires
			// Invoicing), and paused recurring plans (Action Required) — three
			// reads this page didn't need before the Jobber-parity redesign, all
			// non-fatal on their own if one fails, same tolerance every other
			// best-effort read in this app has.
			async function loadListView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				listTableBody.innerHTML = "";
				const windowStart = addDays(todayLocalIso(), -30);
				try {
					const [jobsRes, quotesRes, invoicesRes, pausedRes] = await Promise.all([
						fetch(`/api/admin/dispatch/list-jobs?date=${windowStart}&days=90`),
						fetch(`/api/admin/quotes/list?status=accepted`).catch(() => null),
						fetch(`/api/admin/invoices/list`).catch(() => null),
						fetch(`/api/admin/subscriptions/list-paused`).catch(() => null),
					]);
					const data = await jobsRes.json();
					if (!jobsRes.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;

					const realJobs = data.jobs || [];

					// Requires Invoicing: a completed quote-based job whose invoice
					// isn't paid (or void) yet — draft, sent, or overdue all count,
					// same as a client would describe "I still need to bill this."
					let unpaidInvoiceJobKeys = new Set();
					if (invoicesRes?.ok) {
						try {
							const invoicesData = await invoicesRes.json();
							unpaidInvoiceJobKeys = new Set(
								(invoicesData.invoices || [])
									.filter((inv) => inv.status !== "paid" && inv.status !== "void")
									.map((inv) => inv.jobKey),
							);
						} catch {
							// Non-fatal — Requires Invoicing just reads as 0 for this load.
						}
					}
					realJobs.forEach((job) => {
						job.requiresInvoicing = unpaidInvoiceJobKeys.has(job.jobKey);
					});

					// Unscheduled: quotes the customer already accepted (deposit
					// paid) but staff haven't picked a date for yet — represented
					// as pseudo-rows with no eventId/jobKey, since no calendar event
					// exists for these (see AGENTS.md → "Requests, Assessments &
					// Quotes"). Clicking one jumps to the Quotes page, where the
					// actual "Schedule Job" action already lives, rather than
					// duplicating that whole flow here.
					let unscheduledPseudoJobs = [];
					if (quotesRes?.ok) {
						try {
							const quotesData = await quotesRes.json();
							unscheduledPseudoJobs = (quotesData.quotes || []).map((q) => {
								const customer = q.customer || {};
								return {
									isUnscheduled: true,
									quoteId: q.id,
									jobNumber: "",
									clientName: customer.name || "(no name)",
									serviceLabel: QUOTE_SERVICE_LABELS[q.serviceType] || q.serviceType || "Quote",
									location: customer.address || "",
									jobType: "quote_based",
									amountPaid: "",
									quotedTotal: q.quotedTotal || "",
									status: "unscheduled",
									assignedCleanerIds: [],
									start: null,
									visitDate: "",
								};
							});
						} catch {
							// Non-fatal — Unscheduled just reads as 0 for this load.
						}
					}

					// Action Required: recurring plans currently on hold — see
					// list-paused.js. These never appear as table rows (a plan on
					// hold by definition has no upcoming visit for a row to
					// represent), just as an Overview count and their own panel.
					if (pausedRes?.ok) {
						try {
							const pausedData = await pausedRes.json();
							listPausedPlans = pausedData.paused || [];
						} catch {
							listPausedPlans = [];
						}
					} else {
						listPausedPlans = [];
					}

					listWindowJobs = [...realJobs, ...unscheduledPseudoJobs];
					renderListStats();
					applyListFilters();
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			function renderListStats() {
				const today = todayLocalIso();
				const in30 = addDays(today, 30);
				const back30 = addDays(today, -30);

				let recentCount = 0;
				let recentTotal = 0;
				let upcomingCount = 0;
				let upcomingTotal = 0;
				let unassignedCount = 0;
				let lateCount = 0;
				let invoicingCount = 0;
				let unscheduledCount = 0;

				listWindowJobs.forEach((job) => {
					if (job.isUnscheduled) {
						unscheduledCount++;
						return;
					}
					if (job.archived) return;
					const amount = parseFloat(job.amountPaid) || 0;
					if (job.visitDate < today && job.visitDate >= back30) {
						recentCount++;
						recentTotal += amount;
					}
					if (job.visitDate >= today && job.visitDate <= in30) {
						upcomingCount++;
						upcomingTotal += amount;
					}
					if (job.visitDate >= today && (job.assignedCleanerIds || []).length === 0) {
						unassignedCount++;
					}
					if (job.visitDate < today && job.status !== "completed") {
						lateCount++;
					}
					if (job.requiresInvoicing) {
						invoicingCount++;
					}
				});

				statRecentCount.textContent = String(recentCount);
				statRecentTotal.textContent = `$${recentTotal.toFixed(2)}`;
				statUpcomingCount.textContent = String(upcomingCount);
				statUpcomingTotal.textContent = `$${upcomingTotal.toFixed(2)}`;
				statUnassignedCount.textContent = String(unassignedCount);
				statLateCount.textContent = String(lateCount);
				statInvoicingCount.textContent = String(invoicingCount);
				statUnscheduledCount.textContent = String(unscheduledCount);
				statActionCount.textContent = String(listPausedPlans.length);
			}

			function listSortValue(job, key) {
				switch (key) {
					case "jobNumber":
						return parseInt(job.jobNumber, 10) || 0;
					case "client":
						return clientNameFor(job).toLowerCase();
					case "service":
						return serviceNameFor(job).toLowerCase();
					case "location":
						return (job.location || "").toLowerCase();
					case "start":
						// Unscheduled pseudo-rows have no start time — sort them to
						// the end under ascending order rather than colliding at the
						// Unix epoch (which `new Date(null)` would otherwise do).
						return job.start ? new Date(job.start).getTime() : Number.POSITIVE_INFINITY;
					case "status":
						return job.status || "";
					case "amountPaid":
						return amountSortValue(job);
					default:
						return "";
				}
			}

			function renderActionRequiredPanel() {
				actionRequiredTableBody.innerHTML = "";
				if (!listPausedPlans.length) {
					actionRequiredTableBody.innerHTML = `<tr><td colspan="5" class="admin-table__empty">No plans on hold right now.</td></tr>`;
					return;
				}
				listPausedPlans.forEach((plan) => {
					const tr = document.createElement("tr");
					tr.innerHTML = `
						<td>${escapeHtml(plan.name || plan.email || "—")}</td>
						<td>${escapeHtml(plan.phone || "—")}</td>
						<td>${escapeHtml(FREQUENCY_LABELS[plan.frequency] || plan.frequency || "Recurring plan")}</td>
						<td><span class="admin-badge admin-badge--action_required">Action Required</span></td>
						<td><button type="button" class="btn btn--outline admin-resume-btn">Resume</button></td>
					`;
					tr.querySelector(".admin-resume-btn").addEventListener("click", async (e) => {
						if (!confirm(`Take ${plan.name || "this client"} off hold and resume their plan?`)) return;
						const btn = e.currentTarget;
						btn.disabled = true;
						try {
							const res = await fetch("/api/admin/subscriptions/toggle-hold", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ hold: false, subscriptionId: plan.subscriptionId }),
							});
							if (!res.ok) {
								const data = await res.json();
								alert(data.error || "Something went wrong.");
								btn.disabled = false;
								return;
							}
							await loadListView();
						} catch {
							alert("Network error, please try again.");
							btn.disabled = false;
						}
					});
					actionRequiredTableBody.appendChild(tr);
				});
			}

			function applyListFilters() {
				const today = todayLocalIso();

				overviewListEl.querySelectorAll(".admin-overview-list__item").forEach((li) => {
					li.classList.toggle("is-active", li.dataset.filter === listStatusFilter);
				});

				if (listStatusFilter === "action_required") {
					jobsTableWrap.hidden = true;
					actionRequiredPanel.hidden = false;
					listResultsCountEl.textContent = `${listPausedPlans.length} plan${listPausedPlans.length === 1 ? "" : "s"} on hold`;
					renderActionRequiredPanel();
					return;
				}
				jobsTableWrap.hidden = false;
				actionRequiredPanel.hidden = true;

				const q = listSearchEl.value.trim().toLowerCase();

				let rows = listWindowJobs.filter((job) => {
					if (!matchesStatusFilter(job, listStatusFilter, today)) return false;
					if (listTypeFilter !== "all" && job.jobType !== listTypeFilter) return false;
					if (q) {
						const haystack = `${clientNameFor(job)} ${serviceNameFor(job)} ${job.location || ""}`.toLowerCase();
						if (!haystack.includes(q)) return false;
					}
					return true;
				});

				rows.sort((a, b) => {
					const av = listSortValue(a, listSortKey);
					const bv = listSortValue(b, listSortKey);
					if (av < bv) return listSortDir === "asc" ? -1 : 1;
					if (av > bv) return listSortDir === "asc" ? 1 : -1;
					return 0;
				});

				listResultsCountEl.textContent = `${rows.length} job${rows.length === 1 ? "" : "s"}`;
				renderListRows(rows);
			}

			function renderListRows(rows) {
				listTableBody.innerHTML = "";
				if (!rows.length) {
					const tr = document.createElement("tr");
					tr.innerHTML = `<td colspan="7" class="admin-table__empty">No jobs match these filters.</td>`;
					listTableBody.appendChild(tr);
					return;
				}
				rows.forEach((job) => {
					const tr = document.createElement("tr");
					tr.className = "admin-jobs-table__row";

					if (job.isUnscheduled) {
						tr.innerHTML = `
							<td>—</td>
							<td>${escapeHtml(job.clientName)}</td>
							<td>${escapeHtml(serviceNameFor(job))}</td>
							<td>${escapeHtml(job.location || "—")}</td>
							<td>Not yet scheduled</td>
							<td><span class="admin-badge admin-badge--unscheduled">Unscheduled</span></td>
							<td>${job.quotedTotal ? `$${job.quotedTotal}` : "N/A"}</td>
						`;
						// No calendar event exists yet for this row (see loadListView) —
						// the full job detail page needs a real jobKey to load
						// (/api/admin/dispatch/get-job fetches a live Calendar event),
						// so this jumps to the Quotes page's own "Schedule Job" action
						// instead of linking somewhere that would 404.
						tr.addEventListener("click", () => {
							window.location.href = "/admin/crm/quotes";
						});
						listTableBody.appendChild(tr);
						return;
					}

					const names = cleanerNamesFor(job.assignedCleanerIds);
					tr.innerHTML = `
						<td>${job.jobNumber ? "#" + escapeHtml(job.jobNumber) : "—"}</td>
						<td>${escapeHtml(clientNameFor(job))}</td>
						<td>${escapeHtml(serviceNameFor(job))}</td>
						<td>${escapeHtml(job.location || "—")}</td>
						<td>${fmtDateTime(job.start)}<div class="admin-table__sub">${fmtTime(job.start)}</div></td>
						<td>
							<span class="admin-badge admin-badge--${job.status}">${STATUS_LABELS[job.status] || job.status}</span>
							${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
							${job.archived ? `<div class="admin-table__sub">Archived</div>` : ""}
							${job.requiresInvoicing ? `<div class="admin-table__sub admin-table__sub--warn">Requires invoicing</div>` : ""}
							${names.length ? `<div class="admin-table__sub">${escapeHtml(names.join(", "))}</div>` : ""}
						</td>
						<td>${amountLabel(job)}${depositBadge(job)}</td>
					`;
					// Full job detail page (replaces the old job-detail modal — see
					// AGENTS.md → "Jobs") instead of a popup, so there's room for a
					// real client card, invoice status, and an edit path, matching
					// what the business owner asked for after seeing Jobber's own
					// job page. Links by eventId alone, not the full jobKey — see
					// get-job.js's own comment for why a jobKey's "::" broke this.
					tr.addEventListener("click", () => {
						window.location.href = `/admin/jobs/${encodeURIComponent(job.eventId)}`;
					});
					listTableBody.appendChild(tr);
				});
			}

			listStatusFilterEl.addEventListener("change", () => {
				listStatusFilter = listStatusFilterEl.value;
				applyListFilters();
			});
			listTypeFilterEl.addEventListener("change", () => {
				listTypeFilter = listTypeFilterEl.value;
				applyListFilters();
			});
			listSearchEl.addEventListener("input", () => applyListFilters());

			// Overview list rows are a second way to set the very same
			// listStatusFilter/`<select>` the toolbar dropdown controls — kept in
			// sync both directions so it never looks like two different filters.
			overviewListEl.querySelectorAll(".admin-overview-list__item").forEach((li) => {
				const activate = () => {
					listStatusFilter = li.dataset.filter;
					listStatusFilterEl.value = li.dataset.filter;
					applyListFilters();
				};
				li.addEventListener("click", activate);
				li.addEventListener("keydown", (e) => {
					if (e.key === "Enter" || e.key === " ") {
						e.preventDefault();
						activate();
					}
				});
			});

			listSortHeaders.forEach((th) => {
				th.addEventListener("click", () => {
					if (listSortKey === th.dataset.sort) {
						listSortDir = listSortDir === "asc" ? "desc" : "asc";
					} else {
						listSortKey = th.dataset.sort;
						listSortDir = "asc";
					}
					listSortHeaders.forEach((h) => h.classList.remove("is-sorted-asc", "is-sorted-desc"));
					th.classList.add(listSortDir === "asc" ? "is-sorted-asc" : "is-sorted-desc");
					applyListFilters();
				});
			});

			loadCleaners().then(loadListView);
		</script>

