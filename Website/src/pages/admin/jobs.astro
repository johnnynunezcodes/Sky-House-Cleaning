---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Reads
// real bookings straight from Google Calendar (the existing source of
// truth) and layers on a Firestore overlay for assignment/status. See
// AGENTS.md → "Jobs (formerly Dispatcher)" and src/lib/dispatch.js for why
// it's built this way instead of a duplicated `jobs` collection.
//
// Formerly two ideas that got consolidated into one page after the business
// owner shared reference screenshots of Jobber's own Jobs list and asked
// for it, noting that if something similar already existed it should just
// become "Jobs" rather than adding a second nav item: this used to be
// /admin/dispatch (Day/Week/Month calendar only). List is now the default
// view — a flat, filterable/searchable table with overview stats, closest
// to what Jobber's screenshots showed — with Day/Week/Month still available
// as other tabs for actual day-to-day cleaner assignment. All four share the
// same job-detail modal to edit a job.
//
// Deliberate departures from Jobber's exact layout, worth knowing about
// rather than discovering by their absence:
// - No "Job number" column — this app has no sequential per-job id, only a
//   composite eventId+visitDate key (see dispatch.js's comment on jobKey()).
// - No "Requires Invoicing" status — billing here is automatic via Stripe
//   Checkout/subscriptions, there's no manual invoicing step to require.
// - No "On Hold" / "Archived" states — a job here is either on the calendar
//   (real) or it isn't; nothing is paused or archived independently of that.
// - "Ending within 30 days" isn't shown — would require cross-referencing
//   Stripe subscription cancel_at dates into this list, which /admin/reschedule
//   and /admin/minimum-commitments already surface; not duplicated here.
// - Status/Job Type filters are plain <select> dropdowns, not Jobber's
//   checkbox-multiselect popovers — same filtering outcome, simpler control.
// - No drag-and-drop reassignment, and Day view doesn't lay overlapping jobs
//   on the same cleaner side-by-side (rare for a small crew) — both scope
//   cuts carried over unchanged from the original Dispatch redesign.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { WORKING_HOURS, QUOTE_SERVICE_TYPES } from "../../data/booking.js";
---

<AdminLayout title="Jobs | Sky House Cleaning Staff Tools">
			<div
				class="container admin-container"
				id="jobs-page"
				data-working-hours-start={WORKING_HOURS.start}
				data-working-hours-end={WORKING_HOURS.end}
				data-quote-service-types={JSON.stringify(QUOTE_SERVICE_TYPES)}
			>
				<h1>Jobs</h1>
				<p class="admin-hint">
					Every real job on the calendar, with who's assigned, their status, and whether the
					cleaner has confirmed. This reads directly from Google Calendar, not a separate copy —
					reschedules, cancellations, and new bookings show up here automatically.
				</p>

				<details class="card admin-add-card">
					<summary class="admin-add-summary">Manage cleaners</summary>
					<div id="cleaners-list"></div>
					<form id="add-cleaner-form" class="admin-form admin-inline-form">
						<div class="admin-form__row">
							<label for="add-cleaner-name">Name *</label>
							<input type="text" id="add-cleaner-name" name="name" required />
						</div>
						<div class="admin-form__row">
							<label for="add-cleaner-phone">Phone</label>
							<input type="tel" id="add-cleaner-phone" name="phone" />
						</div>
						<div class="admin-form__row">
							<label for="add-cleaner-email">Email</label>
							<input type="email" id="add-cleaner-email" name="email" />
						</div>
						<button type="submit" class="btn btn--outline">Add Cleaner</button>
					</form>
					<p class="admin-result-message" id="cleaner-message" hidden></p>
				</details>

				<div class="admin-view-switcher" role="group" aria-label="View">
					<button type="button" class="admin-view-btn is-active" data-view="list">List</button>
					<button type="button" class="admin-view-btn" data-view="day">Day</button>
					<button type="button" class="admin-view-btn" data-view="week">Week</button>
					<button type="button" class="admin-view-btn" data-view="month">Month</button>
				</div>

				<div id="period-nav" class="admin-day-nav" hidden>
					<button type="button" id="prev-period" class="btn btn--outline">← Previous</button>
					<input type="date" id="day-picker" />
					<span id="period-label" class="admin-period-label" hidden></span>
					<button type="button" id="next-period" class="btn btn--outline">Next →</button>
					<button type="button" id="today-btn" class="btn btn--outline">Today</button>
				</div>

				<p id="load-status" class="admin-status">Loading…</p>

				<div id="list-view" class="admin-list-view">
					<div class="admin-overview-row">
						<div class="card admin-overview-list-card">
							<p class="admin-overview-card__label">Overview</p>
							<ul class="admin-overview-list" id="overview-list">
								<li class="admin-overview-list__item" data-filter="late" tabindex="0" role="button">
									<span>Late</span>
									<span class="admin-overview-list__count" id="stat-late-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="requires_invoicing" tabindex="0" role="button">
									<span>Requires Invoicing</span>
									<span class="admin-overview-list__count" id="stat-invoicing-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="action_required" tabindex="0" role="button">
									<span>Action Required</span>
									<span class="admin-overview-list__count" id="stat-action-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="unscheduled" tabindex="0" role="button">
									<span>Unscheduled</span>
									<span class="admin-overview-list__count" id="stat-unscheduled-count">0</span>
								</li>
								<li class="admin-overview-list__item" data-filter="unassigned" tabindex="0" role="button">
									<span>Needs a Cleaner</span>
									<span class="admin-overview-list__count" id="stat-unassigned-count">0</span>
								</li>
							</ul>
						</div>
						<div class="card admin-overview-card">
							<p class="admin-overview-card__label">Recent Visits</p>
							<p class="admin-overview-card__sub">Past 30 days</p>
							<p class="admin-overview-card__value" id="stat-recent-count">0</p>
							<p class="admin-overview-card__meta" id="stat-recent-total">$0.00</p>
						</div>
						<div class="card admin-overview-card">
							<p class="admin-overview-card__label">Visits Scheduled</p>
							<p class="admin-overview-card__sub">Next 30 days</p>
							<p class="admin-overview-card__value" id="stat-upcoming-count">0</p>
							<p class="admin-overview-card__meta" id="stat-upcoming-total">$0.00</p>
						</div>
					</div>

					<div class="admin-list-toolbar">
						<div class="admin-list-filters">
							<select id="list-status-filter">
								<option value="all">Status: All</option>
								<optgroup label="Job status">
									<option value="active">Active</option>
									<option value="today">Today</option>
									<option value="upcoming">Upcoming</option>
									<option value="late">Late</option>
									<option value="unscheduled">Unscheduled</option>
									<option value="action_required">Action Required</option>
									<option value="requires_invoicing">Requires Invoicing</option>
									<option value="archived">Archived</option>
								</optgroup>
								<optgroup label="Cleaner status">
									<option value="unassigned">Unassigned</option>
									<option value="assigned">Assigned</option>
									<option value="en_route">En route</option>
									<option value="in_progress">In progress</option>
									<option value="completed">Completed</option>
								</optgroup>
							</select>
							<select id="list-type-filter">
								<option value="all">Job Type: All</option>
								<option value="one_time">One-off jobs</option>
								<option value="recurring">Recurring jobs</option>
								<option value="quote_based">Quote-based jobs</option>
							</select>
						</div>
						<input type="search" id="list-search" class="admin-list-search" placeholder="Search jobs…" />
					</div>

					<p id="list-results-count" class="admin-hint admin-hint--tight"></p>

					<div class="admin-table-wrap" id="jobs-table-wrap">
						<table class="admin-table admin-jobs-table">
							<thead>
								<tr>
									<th data-sort="jobNumber">Job #</th>
									<th data-sort="client">Client</th>
									<th data-sort="service">Service</th>
									<th data-sort="location">Property</th>
									<th data-sort="start" class="is-sorted-asc">Schedule</th>
									<th data-sort="status">Status</th>
									<th data-sort="amountPaid">Total</th>
								</tr>
							</thead>
							<tbody id="list-table-body"></tbody>
						</table>
					</div>

					<div class="admin-table-wrap" id="action-required-panel" hidden>
						<table class="admin-table admin-jobs-table">
							<thead>
								<tr>
									<th>Client</th>
									<th>Phone</th>
									<th>Plan</th>
									<th>Status</th>
									<th></th>
								</tr>
							</thead>
							<tbody id="action-required-table-body"></tbody>
						</table>
					</div>
				</div>

				<div id="day-view" class="admin-day-view" hidden>
					<div id="day-grid" class="admin-daygrid"></div>
				</div>

				<div id="week-view" class="admin-week-view" hidden>
					<div id="week-board" class="admin-week-board"></div>
				</div>

				<div id="month-view" class="admin-month-view" hidden>
					<div class="admin-month-weekdays">
						<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
					</div>
					<div id="month-grid" class="admin-month-grid"></div>
				</div>
			</div>

			<div class="admin-modal-backdrop" id="job-modal-backdrop" hidden>
				<div class="admin-modal card" id="job-modal" role="dialog" aria-modal="true" aria-labelledby="job-modal-title">
					<div class="admin-modal__header">
						<div>
							<h3 id="job-modal-title"></h3>
							<p class="admin-card__meta" id="job-modal-time"></p>
							<p class="admin-card__meta" id="job-modal-location"></p>
							<p class="admin-card__meta admin-card__meta--quote" id="job-modal-quote" hidden></p>
						</div>
						<button type="button" class="admin-modal__close" id="job-modal-close" aria-label="Close">✕</button>
					</div>

					<div class="admin-modal__body">
						<div class="admin-form__row">
							<label for="job-modal-assign">Team</label>
							<select multiple class="admin-assign-select" id="job-modal-assign"></select>
						</div>
						<div class="admin-form__row">
							<label for="job-modal-status">Status</label>
							<select class="admin-status-select" id="job-modal-status"></select>
						</div>
						<div class="admin-form__row admin-form__row--checkbox">
							<label class="admin-confirm-label">
								<input type="checkbox" id="job-modal-confirmed" />
								Confirmed by cleaner
							</label>
						</div>
						<div class="admin-form__row">
							<label for="job-modal-notes">Dispatch notes</label>
							<textarea id="job-modal-notes" rows="2" placeholder="Anything the team should know"></textarea>
						</div>
						<div class="admin-modal__extra-actions">
							<button type="button" class="btn btn--outline" id="job-modal-hold" hidden>Put client's plan on hold</button>
							<button type="button" class="btn btn--outline" id="job-modal-archive">Archive job</button>
						</div>
					</div>

					<p class="admin-result-message" id="job-modal-message" hidden></p>
				</div>
			</div>

		<script>
			const root = document.getElementById("jobs-page");
			const WORKING_HOURS_START = Number(root?.dataset.workingHoursStart) || 8;
			const WORKING_HOURS_END = Number(root?.dataset.workingHoursEnd) || 18;

			const periodNavEl = document.getElementById("period-nav");
			const dayPicker = document.getElementById("day-picker");
			const prevPeriodBtn = document.getElementById("prev-period");
			const nextPeriodBtn = document.getElementById("next-period");
			const todayBtn = document.getElementById("today-btn");
			const periodLabel = document.getElementById("period-label");
			const loadStatus = document.getElementById("load-status");
			const cleanersList = document.getElementById("cleaners-list");
			const addCleanerForm = document.getElementById("add-cleaner-form");
			const cleanerMessage = document.getElementById("cleaner-message");
			const viewButtons = Array.from(document.querySelectorAll(".admin-view-btn"));
			const listViewEl = document.getElementById("list-view");
			const dayViewEl = document.getElementById("day-view");
			const weekViewEl = document.getElementById("week-view");
			const monthViewEl = document.getElementById("month-view");
			const dayGrid = document.getElementById("day-grid");
			const weekBoard = document.getElementById("week-board");
			const monthGrid = document.getElementById("month-grid");

			// Human labels for a paused subscription's billing frequency, shown
			// in the Action Required panel — same wording
			// /admin/minimum-commitments.astro already uses for the same field.
			const FREQUENCY_LABELS = { weekly: "Weekly", biweekly: "Bi-Weekly", monthly: "Monthly" };

			const QUOTE_SERVICE_LABELS = JSON.parse(root?.dataset.quoteServiceTypes || "{}");

			const STATUS_LABELS = {
				unassigned: "Unassigned",
				assigned: "Assigned",
				en_route: "En route",
				in_progress: "In progress",
				completed: "Completed",
			};
			const STATUS_ORDER = ["unassigned", "assigned", "en_route", "in_progress", "completed"];
			const HOUR_HEIGHT = 56; // px per hour row in the Day view grid

			let cleaners = [];
			let viewMode = "list"; // "list" | "day" | "week" | "month"

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function todayLocalIso() {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			}

			function fmtTime(iso) {
				return new Date(iso).toLocaleTimeString("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "numeric",
					minute: "2-digit",
				});
			}

			function fmtDateTime(iso) {
				return new Date(iso).toLocaleDateString("en-US", {
					timeZone: "America/Los_Angeles",
					weekday: "short",
					month: "short",
					day: "numeric",
				});
			}

			// Minutes since local (Pacific) midnight — used for the Day view
			// grid's time-to-pixel math. `hour12: false` can return "24" for
			// midnight in some environments, hence the `% 24`.
			function minutesSinceMidnightPT(iso) {
				const parts = new Intl.DateTimeFormat("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				}).formatToParts(new Date(iso));
				const hour = Number(parts.find((p) => p.type === "hour")?.value || "0") % 24;
				const minute = Number(parts.find((p) => p.type === "minute")?.value || "0");
				return hour * 60 + minute;
			}

			function addDays(dateStr, delta) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() + delta);
				return date.toISOString().slice(0, 10);
			}

			// Sunday-start, matching the weekday header row used both here and on
			// the public/admin booking pages' own calendar (schedule.astro,
			// admin/book.astro).
			function startOfWeek(dateStr) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() - date.getUTCDay());
				return date.toISOString().slice(0, 10);
			}

			function startOfMonth(dateStr) {
				return `${dateStr.slice(0, 7)}-01`;
			}

			function daysInMonthCount(dateStr) {
				const [y, m] = dateStr.split("-").map(Number);
				return new Date(Date.UTC(y, m, 0)).getUTCDate();
			}

			// Always normalized to the 1st — month view only ever anchors to
			// "which month," never a specific day within it.
			function addMonths(dateStr, delta) {
				const [y, m] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1 + delta, 1));
				return date.toISOString().slice(0, 10);
			}

			function localDate(dateStr) {
				// Deliberately NOT `new Date(dateStr)` — that parses "YYYY-MM-DD" as
				// UTC midnight, which can print as the previous day in a
				// west-of-UTC browser. Appending a local time-of-day avoids that.
				return new Date(dateStr + "T00:00:00");
			}

			function groupByDate(jobs) {
				const map = new Map();
				for (const j of jobs) {
					if (!map.has(j.visitDate)) map.set(j.visitDate, []);
					map.get(j.visitDate).push(j);
				}
				for (const arr of map.values()) arr.sort((a, b) => new Date(a.start) - new Date(b.start));
				return map;
			}

			function cleanerNamesFor(ids) {
				return (ids || []).map((id) => cleaners.find((c) => c.id === id)?.name).filter(Boolean);
			}

			// The calendar event's summary is always written server-side as
			// "Sky House Cleaning: {name}, {service}" (see stripe-webhook.js) —
			// reliable enough to parse back apart for the List view's Client/
			// Service columns on jobs that predate the clientName private field
			// below.
			function parseSummary(summary) {
				const m = (summary || "").match(/^Sky House Cleaning: (.+?), (.+)$/);
				return m ? { client: m[1], service: m[2] } : { client: summary || "—", service: "" };
			}

			function clientNameFor(job) {
				return job.clientName || parseSummary(job.summary).client;
			}

			function serviceNameFor(job) {
				// Unscheduled quote pseudo-rows (see loadListView) have no calendar
				// event summary to parse a service name back out of — their label
				// comes straight from the quote's own serviceType instead.
				if (job.isUnscheduled) return job.serviceLabel || "";
				return parseSummary(job.summary).service;
			}

			// `amountPaid` only exists on jobs booked after this field was added
			// (see googleCalendar.js's extendedProperties.private comment) —
			// older jobs on the calendar simply won't have it. Quote-based jobs
			// (see create-quote-job.js) don't have amountPaid at creation at
			// all — nothing's been paid yet, only quoted — so those show the
			// quoted total instead, which is what a "Total" column should mean
			// for a job billed outside Stripe's automatic flow.
			function amountLabel(job) {
				if (job.jobType === "quote_based") {
					return job.quotedTotal ? `$${job.quotedTotal}` : "N/A";
				}
				return job.amountPaid ? `$${job.amountPaid}` : "N/A";
			}

			function amountSortValue(job) {
				return parseFloat(job.jobType === "quote_based" ? job.quotedTotal : job.amountPaid) || 0;
			}

			// A small pending/paid indicator shown next to Total for quote-based
			// jobs only — depositStatus lives in the Firestore jobAssignments
			// overlay (see list-jobs.js), not the calendar event, since it's the
			// one thing about a quote job's money that actually changes after
			// creation (flipped by stripe-webhook.js once the customer pays).
			function depositBadge(job) {
				if (job.jobType !== "quote_based") return "";
				const paid = job.depositStatus === "paid";
				return `<div class="admin-table__sub${paid ? " admin-table__sub--paid" : ""}">
					Deposit ${paid ? "paid ✓" : `pending${job.depositAmount ? ` ($${job.depositAmount})` : ""}`}
				</div>`;
			}

			async function loadCleaners() {
				try {
					const res = await fetch("/api/admin/dispatch/list-cleaners");
					const data = await res.json();
					if (res.ok) cleaners = data.cleaners || [];
					renderCleanersList();
				} catch {
					// Non-fatal — assignment dropdowns/names just come up empty.
				}
			}

			function renderCleanersList() {
				if (!cleaners.length) {
					cleanersList.innerHTML = `<p class="admin-card__meta">No cleaners added yet.</p>`;
					return;
				}
				cleanersList.innerHTML = cleaners
					.map(
						(c) => `
						<div class="admin-cleaner-row">
							<span>${escapeHtml(c.name)}${c.phone ? " · " + escapeHtml(c.phone) : ""}${c.active ? "" : " (inactive)"}</span>
							<button type="button" class="btn btn--outline admin-toggle-active" data-id="${c.id}" data-active="${c.active}">
								${c.active ? "Mark inactive" : "Mark active"}
							</button>
						</div>
					`,
					)
					.join("");

				cleanersList.querySelectorAll(".admin-toggle-active").forEach((btn) => {
					btn.addEventListener("click", async () => {
						btn.disabled = true;
						try {
							await fetch("/api/admin/dispatch/update-cleaner", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ id: btn.dataset.id, active: btn.dataset.active !== "true" }),
							});
							await loadCleaners();
						} finally {
							btn.disabled = false;
						}
					});
				});
			}

			addCleanerForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const formData = new FormData(addCleanerForm);
				const payload = Object.fromEntries(formData.entries());
				const submitBtn = addCleanerForm.querySelector("button[type=submit]");
				submitBtn.disabled = true;
				cleanerMessage.hidden = true;
				try {
					const res = await fetch("/api/admin/dispatch/create-cleaner", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) {
						cleanerMessage.hidden = false;
						cleanerMessage.textContent = data.error || "Something went wrong.";
						cleanerMessage.classList.add("admin-result-message--error");
						return;
					}
					addCleanerForm.reset();
					await loadCleaners();
				} catch {
					cleanerMessage.hidden = false;
					cleanerMessage.textContent = "Network error, please try again.";
					cleanerMessage.classList.add("admin-result-message--error");
				} finally {
					submitBtn.disabled = false;
				}
			});

			function cleanerOptions(selectedIds) {
				return cleaners
					.filter((c) => c.active || selectedIds.includes(c.id))
					.map((c) => `<option value="${c.id}" ${selectedIds.includes(c.id) ? "selected" : ""}>${escapeHtml(c.name)}</option>`)
					.join("");
			}

			// --- Shared job-detail modal (List/Month/Week/Day all open this) -------

			const modalBackdrop = document.getElementById("job-modal-backdrop");
			const modalTitle = document.getElementById("job-modal-title");
			const modalTime = document.getElementById("job-modal-time");
			const modalLocation = document.getElementById("job-modal-location");
			const modalQuote = document.getElementById("job-modal-quote");
			const modalClose = document.getElementById("job-modal-close");
			const modalAssign = document.getElementById("job-modal-assign");
			const modalStatus = document.getElementById("job-modal-status");
			const modalConfirmed = document.getElementById("job-modal-confirmed");
			const modalNotes = document.getElementById("job-modal-notes");
			const modalHoldBtn = document.getElementById("job-modal-hold");
			const modalArchiveBtn = document.getElementById("job-modal-archive");
			const modalMessage = document.getElementById("job-modal-message");

			let currentModalJob = null;

			function openJobModal(job) {
				currentModalJob = job;
				const assignedIds = job.assignedCleanerIds || [];
				modalTitle.textContent = job.jobNumber ? `#${job.jobNumber} — ${job.summary || "Job"}` : job.summary || "Job";
				modalTime.textContent = `${fmtDateTime(job.start)} · ${fmtTime(job.start)} – ${fmtTime(job.end)}`;
				modalLocation.textContent = job.location || "";
				modalLocation.hidden = !job.location;
				if (job.jobType === "quote_based") {
					const paid = job.depositStatus === "paid";
					modalQuote.innerHTML = `Quoted total: $${job.quotedTotal || "0.00"} · Deposit ${
						paid ? "paid ✓" : `pending ($${job.depositAmount || "0.00"})`
					}`;
					modalQuote.hidden = false;
				} else {
					modalQuote.hidden = true;
				}
				modalAssign.innerHTML = cleanerOptions(assignedIds);
				modalAssign.size = Math.min(4, Math.max(2, cleaners.length));
				modalStatus.innerHTML = STATUS_ORDER.map(
					(s) => `<option value="${s}" ${job.status === s ? "selected" : ""}>${STATUS_LABELS[s]}</option>`,
				).join("");
				modalConfirmed.checked = !!job.cleanerConfirmed;
				modalConfirmed.disabled = assignedIds.length === 0;
				modalNotes.value = job.dispatchNotes || "";

				// "Put on hold" only makes sense for a recurring plan's job — see
				// AGENTS.md → "Jobs" for why this is a client-level Stripe action
				// (pauses the whole subscription), not a per-visit field like
				// everything else in this modal.
				modalHoldBtn.hidden = job.jobType !== "recurring";
				modalHoldBtn.disabled = false;
				modalHoldBtn.textContent = "Put client's plan on hold";

				modalArchiveBtn.textContent = job.archived ? "Unarchive job" : "Archive job";
				modalArchiveBtn.disabled = false;

				modalMessage.hidden = true;
				modalBackdrop.hidden = false;
			}

			function closeJobModal() {
				modalBackdrop.hidden = true;
				currentModalJob = null;
				// Anything edited in the modal can change which view (and the
				// sidebar's unassigned badge, next page load) is stale — simplest
				// correct thing is to just reload whichever view is open.
				loadCurrentView();
			}

			modalClose.addEventListener("click", closeJobModal);
			modalBackdrop.addEventListener("click", (e) => {
				if (e.target === modalBackdrop) closeJobModal();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && !modalBackdrop.hidden) closeJobModal();
			});

			async function saveModalJob(extraFields) {
				if (!currentModalJob) return;
				modalMessage.hidden = true;
				try {
					const res = await fetch("/api/admin/dispatch/update-job", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							jobKey: currentModalJob.jobKey,
							eventId: currentModalJob.eventId,
							visitDate: currentModalJob.visitDate,
							...extraFields,
						}),
					});
					const data = await res.json();
					if (!res.ok) {
						modalMessage.hidden = false;
						modalMessage.textContent = data.error || "Something went wrong.";
						modalMessage.classList.add("admin-result-message--error");
					}
				} catch {
					modalMessage.hidden = false;
					modalMessage.textContent = "Network error, please try again.";
					modalMessage.classList.add("admin-result-message--error");
				}
			}

			modalAssign.addEventListener("change", () => {
				const selectedIds = Array.from(modalAssign.selectedOptions).map((o) => o.value);
				const nextStatus = selectedIds.length && currentModalJob.status === "unassigned" ? "assigned" : undefined;
				if (nextStatus) modalStatus.value = nextStatus;

				const extra = { assignedCleanerIds: selectedIds, ...(nextStatus ? { status: nextStatus } : {}) };

				// Unassigning everyone makes "confirmed" meaningless — reset it
				// rather than leaving a stale confirmation attached to nobody.
				modalConfirmed.disabled = selectedIds.length === 0;
				if (selectedIds.length === 0 && modalConfirmed.checked) {
					modalConfirmed.checked = false;
					extra.cleanerConfirmed = false;
				}

				currentModalJob.assignedCleanerIds = selectedIds;
				if (nextStatus) currentModalJob.status = nextStatus;
				saveModalJob(extra);
			});

			modalStatus.addEventListener("change", () => {
				currentModalJob.status = modalStatus.value;
				saveModalJob({ status: modalStatus.value });
			});

			modalConfirmed.addEventListener("change", () => {
				currentModalJob.cleanerConfirmed = modalConfirmed.checked;
				saveModalJob({ cleanerConfirmed: modalConfirmed.checked });
			});

			// Debounced — notes are free text, saving on every keystroke would be
			// wasteful and could race with itself.
			let notesDebounceTimer;
			modalNotes.addEventListener("input", () => {
				clearTimeout(notesDebounceTimer);
				notesDebounceTimer = setTimeout(() => {
					if (!currentModalJob) return;
					currentModalJob.dispatchNotes = modalNotes.value;
					saveModalJob({ dispatchNotes: modalNotes.value });
				}, 600);
			});

			modalArchiveBtn.addEventListener("click", async () => {
				if (!currentModalJob) return;
				const nextArchived = !currentModalJob.archived;
				modalArchiveBtn.disabled = true;
				await saveModalJob({ archived: nextArchived });
				currentModalJob.archived = nextArchived;
				closeJobModal();
			});

			modalHoldBtn.addEventListener("click", async () => {
				if (!currentModalJob) return;
				if (!currentModalJob.clientEmail) {
					modalMessage.hidden = false;
					modalMessage.textContent = "No client email on file for this booking — can't look up their plan.";
					modalMessage.classList.add("admin-result-message--error");
					return;
				}
				if (!confirm(`Put ${clientNameFor(currentModalJob)}'s recurring plan on hold? This pauses billing and stops new visits from being created until you take them off hold.`)) {
					return;
				}
				modalHoldBtn.disabled = true;
				modalMessage.hidden = true;
				try {
					const res = await fetch("/api/admin/subscriptions/toggle-hold", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ hold: true, clientEmail: currentModalJob.clientEmail }),
					});
					const data = await res.json();
					if (!res.ok) {
						modalMessage.hidden = false;
						modalMessage.textContent = data.error || "Something went wrong.";
						modalMessage.classList.add("admin-result-message--error");
						modalHoldBtn.disabled = false;
						return;
					}
					closeJobModal();
				} catch {
					modalMessage.hidden = false;
					modalMessage.textContent = "Network error, please try again.";
					modalMessage.classList.add("admin-result-message--error");
					modalHoldBtn.disabled = false;
				}
			});

			// --- List view: overview stats + filterable/sortable/searchable table --

			const statRecentCount = document.getElementById("stat-recent-count");
			const statRecentTotal = document.getElementById("stat-recent-total");
			const statUpcomingCount = document.getElementById("stat-upcoming-count");
			const statUpcomingTotal = document.getElementById("stat-upcoming-total");
			const statUnassignedCount = document.getElementById("stat-unassigned-count");
			const statLateCount = document.getElementById("stat-late-count");
			const statInvoicingCount = document.getElementById("stat-invoicing-count");
			const statActionCount = document.getElementById("stat-action-count");
			const statUnscheduledCount = document.getElementById("stat-unscheduled-count");
			const overviewListEl = document.getElementById("overview-list");
			const listStatusFilterEl = document.getElementById("list-status-filter");
			const listTypeFilterEl = document.getElementById("list-type-filter");
			const listSearchEl = document.getElementById("list-search");
			const listResultsCountEl = document.getElementById("list-results-count");
			const listTableBody = document.getElementById("list-table-body");
			const listSortHeaders = Array.from(document.querySelectorAll("#list-view th[data-sort]"));
			const jobsTableWrap = document.getElementById("jobs-table-wrap");
			const actionRequiredPanel = document.getElementById("action-required-panel");
			const actionRequiredTableBody = document.getElementById("action-required-table-body");

			let listWindowJobs = [];
			let listPausedPlans = [];
			let listStatusFilter = "all";
			let listTypeFilter = "all";
			let listSortKey = "start";
			let listSortDir = "asc";

			// Statuses adapted from Jobber's own Jobs list (confirmed against
			// their help docs — see AGENTS.md → "Jobs" for the full mapping and
			// why "Ending Within 30 Days" was deliberately left out: this app's
			// recurring plans have no built-in end date, only an optional
			// early-cancellation date staff set by hand, so that stat would only
			// ever flag clients who've already told you they're leaving).
			//
			// `archived` jobs are hidden from every filter except "archived"
			// itself, checked first so none of the branches below need to repeat
			// that exclusion. Unscheduled quote pseudo-rows (see loadListView)
			// only ever match "all" or "unscheduled" — they have no status/date
			// for any of the other predicates to mean anything.
			function matchesStatusFilter(job, filter, today) {
				if (job.isUnscheduled) return filter === "all" || filter === "unscheduled";
				if (filter === "archived") return !!job.archived;
				if (job.archived) return false;
				if (filter === "all") return true;
				if (filter === "active") return job.status === "in_progress";
				if (filter === "today") return job.visitDate === today;
				if (filter === "upcoming") return job.visitDate > today;
				if (filter === "late") return job.visitDate < today && job.status !== "completed";
				if (filter === "requires_invoicing") return !!job.requiresInvoicing;
				if (filter === "unscheduled") return false;
				if (filter === "action_required") return false; // shown in its own panel, not table rows
				// Checked against assignedCleanerIds, not job.status, so this always
				// agrees with the "Needs a Cleaner" Overview count above (which
				// uses the same predicate) — status can go stale here: unassigning
				// every cleaner from an already-assigned/en-route job only resets
				// status back to "unassigned" when going the OTHER direction (see
				// the modalAssign change handler), so a job can end up with
				// assignedCleanerIds: [] while status still reads "assigned".
				if (filter === "unassigned") return (job.assignedCleanerIds || []).length === 0;
				return job.status === filter;
			}

			// Fixed 90-day rolling window (30 days back, 60 forward) — enough to
			// cover Jobber's own "past 30 days" / "next 30 days" stat cards in one
			// read, with some headroom for the Late count. Jobs overdue by more
			// than 30 days won't be counted — an edge case for a small crew that
			// marks visits completed same-day, not worth a second query.
			//
			// Alongside the calendar read, this also pulls in accepted-but-
			// unscheduled quotes (Unscheduled), open invoices (Requires
			// Invoicing), and paused recurring plans (Action Required) — three
			// reads this page didn't need before the Jobber-parity redesign, all
			// non-fatal on their own if one fails, same tolerance every other
			// best-effort read in this app has.
			async function loadListView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				listTableBody.innerHTML = "";
				const windowStart = addDays(todayLocalIso(), -30);
				try {
					const [jobsRes, quotesRes, invoicesRes, pausedRes] = await Promise.all([
						fetch(`/api/admin/dispatch/list-jobs?date=${windowStart}&days=90`),
						fetch(`/api/admin/quotes/list?status=accepted`).catch(() => null),
						fetch(`/api/admin/invoices/list`).catch(() => null),
						fetch(`/api/admin/subscriptions/list-paused`).catch(() => null),
					]);
					const data = await jobsRes.json();
					if (!jobsRes.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;

					const realJobs = data.jobs || [];

					// Requires Invoicing: a completed quote-based job whose invoice
					// isn't paid (or void) yet — draft, sent, or overdue all count,
					// same as a client would describe "I still need to bill this."
					let unpaidInvoiceJobKeys = new Set();
					if (invoicesRes?.ok) {
						try {
							const invoicesData = await invoicesRes.json();
							unpaidInvoiceJobKeys = new Set(
								(invoicesData.invoices || [])
									.filter((inv) => inv.status !== "paid" && inv.status !== "void")
									.map((inv) => inv.jobKey),
							);
						} catch {
							// Non-fatal — Requires Invoicing just reads as 0 for this load.
						}
					}
					realJobs.forEach((job) => {
						job.requiresInvoicing = unpaidInvoiceJobKeys.has(job.jobKey);
					});

					// Unscheduled: quotes the customer already accepted (deposit
					// paid) but staff haven't picked a date for yet — represented
					// as pseudo-rows with no eventId/jobKey, since no calendar event
					// exists for these (see AGENTS.md → "Requests, Assessments &
					// Quotes"). Clicking one jumps to the Quotes page, where the
					// actual "Schedule Job" action already lives, rather than
					// duplicating that whole flow here.
					let unscheduledPseudoJobs = [];
					if (quotesRes?.ok) {
						try {
							const quotesData = await quotesRes.json();
							unscheduledPseudoJobs = (quotesData.quotes || []).map((q) => {
								const customer = q.customer || {};
								return {
									isUnscheduled: true,
									quoteId: q.id,
									jobNumber: "",
									clientName: customer.name || "(no name)",
									serviceLabel: QUOTE_SERVICE_LABELS[q.serviceType] || q.serviceType || "Quote",
									location: customer.address || "",
									jobType: "quote_based",
									amountPaid: "",
									quotedTotal: q.quotedTotal || "",
									status: "unscheduled",
									assignedCleanerIds: [],
									start: null,
									visitDate: "",
								};
							});
						} catch {
							// Non-fatal — Unscheduled just reads as 0 for this load.
						}
					}

					// Action Required: recurring plans currently on hold — see
					// list-paused.js. These never appear as table rows (a plan on
					// hold by definition has no upcoming visit for a row to
					// represent), just as an Overview count and their own panel.
					if (pausedRes?.ok) {
						try {
							const pausedData = await pausedRes.json();
							listPausedPlans = pausedData.paused || [];
						} catch {
							listPausedPlans = [];
						}
					} else {
						listPausedPlans = [];
					}

					listWindowJobs = [...realJobs, ...unscheduledPseudoJobs];
					renderListStats();
					applyListFilters();
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			function renderListStats() {
				const today = todayLocalIso();
				const in30 = addDays(today, 30);
				const back30 = addDays(today, -30);

				let recentCount = 0;
				let recentTotal = 0;
				let upcomingCount = 0;
				let upcomingTotal = 0;
				let unassignedCount = 0;
				let lateCount = 0;
				let invoicingCount = 0;
				let unscheduledCount = 0;

				listWindowJobs.forEach((job) => {
					if (job.isUnscheduled) {
						unscheduledCount++;
						return;
					}
					if (job.archived) return;
					const amount = parseFloat(job.amountPaid) || 0;
					if (job.visitDate < today && job.visitDate >= back30) {
						recentCount++;
						recentTotal += amount;
					}
					if (job.visitDate >= today && job.visitDate <= in30) {
						upcomingCount++;
						upcomingTotal += amount;
					}
					if (job.visitDate >= today && (job.assignedCleanerIds || []).length === 0) {
						unassignedCount++;
					}
					if (job.visitDate < today && job.status !== "completed") {
						lateCount++;
					}
					if (job.requiresInvoicing) {
						invoicingCount++;
					}
				});

				statRecentCount.textContent = String(recentCount);
				statRecentTotal.textContent = `$${recentTotal.toFixed(2)}`;
				statUpcomingCount.textContent = String(upcomingCount);
				statUpcomingTotal.textContent = `$${upcomingTotal.toFixed(2)}`;
				statUnassignedCount.textContent = String(unassignedCount);
				statLateCount.textContent = String(lateCount);
				statInvoicingCount.textContent = String(invoicingCount);
				statUnscheduledCount.textContent = String(unscheduledCount);
				statActionCount.textContent = String(listPausedPlans.length);
			}

			function listSortValue(job, key) {
				switch (key) {
					case "jobNumber":
						return parseInt(job.jobNumber, 10) || 0;
					case "client":
						return clientNameFor(job).toLowerCase();
					case "service":
						return serviceNameFor(job).toLowerCase();
					case "location":
						return (job.location || "").toLowerCase();
					case "start":
						// Unscheduled pseudo-rows have no start time — sort them to
						// the end under ascending order rather than colliding at the
						// Unix epoch (which `new Date(null)` would otherwise do).
						return job.start ? new Date(job.start).getTime() : Number.POSITIVE_INFINITY;
					case "status":
						return job.status || "";
					case "amountPaid":
						return amountSortValue(job);
					default:
						return "";
				}
			}

			function renderActionRequiredPanel() {
				actionRequiredTableBody.innerHTML = "";
				if (!listPausedPlans.length) {
					actionRequiredTableBody.innerHTML = `<tr><td colspan="5" class="admin-table__empty">No plans on hold right now.</td></tr>`;
					return;
				}
				listPausedPlans.forEach((plan) => {
					const tr = document.createElement("tr");
					tr.innerHTML = `
						<td>${escapeHtml(plan.name || plan.email || "—")}</td>
						<td>${escapeHtml(plan.phone || "—")}</td>
						<td>${escapeHtml(FREQUENCY_LABELS[plan.frequency] || plan.frequency || "Recurring plan")}</td>
						<td><span class="admin-badge admin-badge--action_required">Action Required</span></td>
						<td><button type="button" class="btn btn--outline admin-resume-btn">Resume</button></td>
					`;
					tr.querySelector(".admin-resume-btn").addEventListener("click", async (e) => {
						if (!confirm(`Take ${plan.name || "this client"} off hold and resume their plan?`)) return;
						const btn = e.currentTarget;
						btn.disabled = true;
						try {
							const res = await fetch("/api/admin/subscriptions/toggle-hold", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ hold: false, subscriptionId: plan.subscriptionId }),
							});
							if (!res.ok) {
								const data = await res.json();
								alert(data.error || "Something went wrong.");
								btn.disabled = false;
								return;
							}
							await loadListView();
						} catch {
							alert("Network error, please try again.");
							btn.disabled = false;
						}
					});
					actionRequiredTableBody.appendChild(tr);
				});
			}

			function applyListFilters() {
				const today = todayLocalIso();

				overviewListEl.querySelectorAll(".admin-overview-list__item").forEach((li) => {
					li.classList.toggle("is-active", li.dataset.filter === listStatusFilter);
				});

				if (listStatusFilter === "action_required") {
					jobsTableWrap.hidden = true;
					actionRequiredPanel.hidden = false;
					listResultsCountEl.textContent = `${listPausedPlans.length} plan${listPausedPlans.length === 1 ? "" : "s"} on hold`;
					renderActionRequiredPanel();
					return;
				}
				jobsTableWrap.hidden = false;
				actionRequiredPanel.hidden = true;

				const q = listSearchEl.value.trim().toLowerCase();

				let rows = listWindowJobs.filter((job) => {
					if (!matchesStatusFilter(job, listStatusFilter, today)) return false;
					if (listTypeFilter !== "all" && job.jobType !== listTypeFilter) return false;
					if (q) {
						const haystack = `${clientNameFor(job)} ${serviceNameFor(job)} ${job.location || ""}`.toLowerCase();
						if (!haystack.includes(q)) return false;
					}
					return true;
				});

				rows.sort((a, b) => {
					const av = listSortValue(a, listSortKey);
					const bv = listSortValue(b, listSortKey);
					if (av < bv) return listSortDir === "asc" ? -1 : 1;
					if (av > bv) return listSortDir === "asc" ? 1 : -1;
					return 0;
				});

				listResultsCountEl.textContent = `${rows.length} job${rows.length === 1 ? "" : "s"}`;
				renderListRows(rows);
			}

			function renderListRows(rows) {
				listTableBody.innerHTML = "";
				if (!rows.length) {
					const tr = document.createElement("tr");
					tr.innerHTML = `<td colspan="7" class="admin-table__empty">No jobs match these filters.</td>`;
					listTableBody.appendChild(tr);
					return;
				}
				rows.forEach((job) => {
					const tr = document.createElement("tr");
					tr.className = "admin-jobs-table__row";

					if (job.isUnscheduled) {
						tr.innerHTML = `
							<td>—</td>
							<td>${escapeHtml(job.clientName)}</td>
							<td>${escapeHtml(serviceNameFor(job))}</td>
							<td>${escapeHtml(job.location || "—")}</td>
							<td>Not yet scheduled</td>
							<td><span class="admin-badge admin-badge--unscheduled">Unscheduled</span></td>
							<td>${job.quotedTotal ? `$${job.quotedTotal}` : "N/A"}</td>
						`;
						// No calendar event exists yet for this row (see loadListView) —
						// the shared job-detail modal only knows how to edit a real
						// job, so this jumps to the Quotes page's own "Schedule Job"
						// action instead of duplicating it here.
						tr.addEventListener("click", () => {
							window.location.href = "/admin/crm/quotes";
						});
						listTableBody.appendChild(tr);
						return;
					}

					const names = cleanerNamesFor(job.assignedCleanerIds);
					tr.innerHTML = `
						<td>${job.jobNumber ? "#" + escapeHtml(job.jobNumber) : "—"}</td>
						<td>${escapeHtml(clientNameFor(job))}</td>
						<td>${escapeHtml(serviceNameFor(job))}</td>
						<td>${escapeHtml(job.location || "—")}</td>
						<td>${fmtDateTime(job.start)}<div class="admin-table__sub">${fmtTime(job.start)}</div></td>
						<td>
							<span class="admin-badge admin-badge--${job.status}">${STATUS_LABELS[job.status] || job.status}</span>
							${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
							${job.archived ? `<div class="admin-table__sub">Archived</div>` : ""}
							${job.requiresInvoicing ? `<div class="admin-table__sub admin-table__sub--warn">Requires invoicing</div>` : ""}
							${names.length ? `<div class="admin-table__sub">${escapeHtml(names.join(", "))}</div>` : ""}
						</td>
						<td>${amountLabel(job)}${depositBadge(job)}</td>
					`;
					tr.addEventListener("click", () => openJobModal(job));
					listTableBody.appendChild(tr);
				});
			}

			listStatusFilterEl.addEventListener("change", () => {
				listStatusFilter = listStatusFilterEl.value;
				applyListFilters();
			});
			listTypeFilterEl.addEventListener("change", () => {
				listTypeFilter = listTypeFilterEl.value;
				applyListFilters();
			});
			listSearchEl.addEventListener("input", () => applyListFilters());

			// Overview list rows are a second way to set the very same
			// listStatusFilter/`<select>` the toolbar dropdown controls — kept in
			// sync both directions so it never looks like two different filters.
			overviewListEl.querySelectorAll(".admin-overview-list__item").forEach((li) => {
				const activate = () => {
					listStatusFilter = li.dataset.filter;
					listStatusFilterEl.value = li.dataset.filter;
					applyListFilters();
				};
				li.addEventListener("click", activate);
				li.addEventListener("keydown", (e) => {
					if (e.key === "Enter" || e.key === " ") {
						e.preventDefault();
						activate();
					}
				});
			});

			listSortHeaders.forEach((th) => {
				th.addEventListener("click", () => {
					if (listSortKey === th.dataset.sort) {
						listSortDir = listSortDir === "asc" ? "desc" : "asc";
					} else {
						listSortKey = th.dataset.sort;
						listSortDir = "asc";
					}
					listSortHeaders.forEach((h) => h.classList.remove("is-sorted-asc", "is-sorted-desc"));
					th.classList.add(listSortDir === "asc" ? "is-sorted-asc" : "is-sorted-desc");
					applyListFilters();
				});
			});

			// --- Day view: hour-ruler grid, one column per cleaner -----------------

			function hourLabel(h) {
				const hour24 = ((h % 24) + 24) % 24;
				const period = hour24 < 12 ? "AM" : "PM";
				let hour12 = hour24 % 12;
				if (hour12 === 0) hour12 = 12;
				return `${hour12} ${period}`;
			}

			function dayBlock(job, gridStartHour) {
				const startMin = minutesSinceMidnightPT(job.start);
				// Never render a sliver too short to read/click — visually widened,
				// doesn't change the real scheduled time (shown in the label and,
				// authoritatively, in the modal).
				const endMin = Math.max(minutesSinceMidnightPT(job.end), startMin + 20);
				const top = (startMin - gridStartHour * 60) * (HOUR_HEIGHT / 60);
				const height = Math.max((endMin - startMin) * (HOUR_HEIGHT / 60), 24);

				const assignedIds = job.assignedCleanerIds || [];
				const block = document.createElement("button");
				block.type = "button";
				block.className = "admin-daygrid__block" + (assignedIds.length === 0 ? " admin-daygrid__block--unassigned" : "");
				block.style.top = `${top}px`;
				block.style.height = `${height}px`;
				block.innerHTML = `
					<span class="admin-daygrid__block-time">${fmtTime(job.start)}</span>
					<span class="admin-daygrid__block-title">${escapeHtml(job.summary)}</span>
					${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
				`;
				block.addEventListener("click", () => openJobModal(job));
				return block;
			}

			function buildDayGrid(jobs) {
				dayGrid.innerHTML = "";

				let startHour = WORKING_HOURS_START;
				let endHour = WORKING_HOURS_END;
				jobs.forEach((job) => {
					const s = minutesSinceMidnightPT(job.start) / 60;
					const e = minutesSinceMidnightPT(job.end) / 60;
					startHour = Math.min(startHour, Math.floor(s));
					endHour = Math.max(endHour, Math.ceil(e));
				});
				const totalHours = Math.max(1, endHour - startHour);
				const gridHeight = totalHours * HOUR_HEIGHT;

				// Only cleaners actually relevant today get a column: active ones,
				// plus any inactive one who somehow still has a job assigned today
				// (so an existing assignment never just disappears from view).
				const dayCleaners = cleaners.filter(
					(c) => c.active || jobs.some((j) => (j.assignedCleanerIds || []).includes(c.id)),
				);
				const columns = [{ id: "", name: "Unassigned" }, ...dayCleaners.map((c) => ({ id: c.id, name: c.name }))];

				const inner = document.createElement("div");
				inner.className = "admin-daygrid__inner";

				const header = document.createElement("div");
				header.className = "admin-daygrid__headers";
				header.innerHTML =
					`<div class="admin-daygrid__gutter-cell"></div>` +
					columns
						.map(
							(col) => `
						<div class="admin-daygrid__col-header${col.id ? "" : " admin-daygrid__col-header--unassigned"}">
							${escapeHtml(col.name)}
						</div>
					`,
						)
						.join("");
				inner.appendChild(header);

				const body = document.createElement("div");
				body.className = "admin-daygrid__body";
				body.style.height = `${gridHeight}px`;

				const gutter = document.createElement("div");
				gutter.className = "admin-daygrid__gutter";
				for (let h = startHour; h <= endHour; h++) {
					const label = document.createElement("div");
					label.className = "admin-daygrid__hour-label";
					label.style.top = `${(h - startHour) * HOUR_HEIGHT}px`;
					label.textContent = hourLabel(h);
					gutter.appendChild(label);
				}
				body.appendChild(gutter);

				columns.forEach((col) => {
					const colEl = document.createElement("div");
					colEl.className = "admin-daygrid__col";

					for (let h = startHour; h <= endHour; h++) {
						const line = document.createElement("div");
						line.className = "admin-daygrid__gridline";
						line.style.top = `${(h - startHour) * HOUR_HEIGHT}px`;
						colEl.appendChild(line);
					}

					const colJobs = jobs.filter((j) => {
						const ids = j.assignedCleanerIds || [];
						return col.id ? ids.includes(col.id) : ids.length === 0;
					});
					colJobs.forEach((job) => colEl.appendChild(dayBlock(job, startHour)));

					body.appendChild(colEl);
				});

				inner.appendChild(body);

				if (!jobs.length) {
					const empty = document.createElement("p");
					empty.className = "admin-status admin-daygrid__empty";
					empty.textContent = "No jobs scheduled this day.";
					dayGrid.appendChild(empty);
				}
				dayGrid.appendChild(inner);
			}

			async function loadDayView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				dayGrid.innerHTML = "";
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${dayPicker.value}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					buildDayGrid(data.jobs || []);
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- Week view (7-column board, chips open the shared modal) -----------

			function formatWeekRange(weekStart) {
				const start = localDate(weekStart).toLocaleDateString("en-US", { month: "short", day: "numeric" });
				const end = localDate(addDays(weekStart, 6)).toLocaleDateString("en-US", {
					month: "short",
					day: "numeric",
					year: "numeric",
				});
				return `${start} – ${end}`;
			}

			function jobChip(job) {
				const chip = document.createElement("button");
				chip.type = "button";
				const assignedIds = job.assignedCleanerIds || [];
				const isUnassigned = assignedIds.length === 0;
				chip.className = "admin-chip" + (isUnassigned ? " admin-chip--unassigned" : "");
				const names = cleanerNamesFor(assignedIds);
				chip.innerHTML = `
					<span class="admin-chip__time">${fmtTime(job.start)}</span>
					<span class="admin-chip__summary">${escapeHtml(job.summary)}</span>
					<span class="admin-chip__cleaners${names.length ? "" : " admin-chip__cleaners--empty"}">
						${names.length ? escapeHtml(names.join(", ")) : "Needs cleaner"}
					</span>
					<span class="admin-chip__footer">
						<span class="admin-badge admin-badge--${job.status}">${STATUS_LABELS[job.status] || job.status}</span>
						${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
					</span>
				`;
				chip.addEventListener("click", () => openJobModal(job));
				return chip;
			}

			function weekColumn(dateStr, jobs, isToday) {
				const col = document.createElement("div");
				col.className = "admin-week-col" + (isToday ? " is-today" : "");
				const date = localDate(dateStr);
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;

				col.innerHTML = `
					<button type="button" class="admin-week-col__header" data-date="${dateStr}">
						<span class="admin-week-col__day">${date.toLocaleDateString("en-US", { weekday: "short" })}</span>
						<span class="admin-week-col__date">${date.getDate()}</span>
						${unassignedCount ? `<span class="admin-week-col__badge">${unassignedCount}</span>` : ""}
					</button>
					<div class="admin-week-col__jobs"></div>
				`;

				col.querySelector(".admin-week-col__header").addEventListener("click", () => jumpToDay(dateStr));

				const jobsEl = col.querySelector(".admin-week-col__jobs");
				if (!jobs.length) {
					jobsEl.innerHTML = `<p class="admin-week-empty">No jobs</p>`;
				} else {
					jobs.forEach((job) => jobsEl.appendChild(jobChip(job)));
				}
				return col;
			}

			async function loadWeekView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				weekBoard.innerHTML = "";
				const weekStart = startOfWeek(dayPicker.value);
				periodLabel.hidden = false;
				periodLabel.textContent = formatWeekRange(weekStart);
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${weekStart}&days=7`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const byDate = groupByDate(data.jobs || []);
					const today = todayLocalIso();
					for (let i = 0; i < 7; i++) {
						const dateStr = addDays(weekStart, i);
						weekBoard.appendChild(weekColumn(dateStr, byDate.get(dateStr) || [], dateStr === today));
					}
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- Month view (calendar grid, chips open the shared modal) -----------

			function monthCell(dateStr, dayNum, jobs, isToday) {
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;
				const cell = document.createElement("div");
				cell.className = "admin-month-day" + (isToday ? " is-today" : "") + (unassignedCount ? " has-unassigned" : "");

				cell.innerHTML = `
					<button type="button" class="admin-month-day__header" data-date="${dateStr}">
						<span class="admin-month-day__num">${dayNum}</span>
						${jobs.length ? `<span class="admin-month-day__count">${jobs.length} visit${jobs.length === 1 ? "" : "s"}</span>` : ""}
					</button>
					<div class="admin-month-day__chips"></div>
				`;

				cell.querySelector(".admin-month-day__header").addEventListener("click", () => jumpToDay(dateStr));

				const chipsEl = cell.querySelector(".admin-month-day__chips");
				jobs.forEach((job) => {
					const assignedIds = job.assignedCleanerIds || [];
					const mini = document.createElement("button");
					mini.type = "button";
					mini.className = "admin-month-chip" + (assignedIds.length === 0 ? " admin-month-chip--unassigned" : "");
					mini.innerHTML = `<span class="admin-month-chip__dot"></span>${escapeHtml(job.summary)}`;
					mini.addEventListener("click", (e) => {
						e.stopPropagation();
						openJobModal(job);
					});
					chipsEl.appendChild(mini);
				});

				return cell;
			}

			async function loadMonthView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				monthGrid.innerHTML = "";
				const monthStart = startOfMonth(dayPicker.value);
				const totalDays = daysInMonthCount(monthStart);
				periodLabel.hidden = false;
				periodLabel.textContent = localDate(monthStart).toLocaleDateString("en-US", {
					month: "long",
					year: "numeric",
				});
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${monthStart}&days=${totalDays}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const byDate = groupByDate(data.jobs || []);
					const today = todayLocalIso();
					const firstDow = localDate(monthStart).getDay();
					for (let i = 0; i < firstDow; i++) {
						const pad = document.createElement("span");
						pad.className = "admin-month-pad";
						monthGrid.appendChild(pad);
					}
					for (let d = 1; d <= totalDays; d++) {
						const dateStr = `${monthStart.slice(0, 8)}${String(d).padStart(2, "0")}`;
						monthGrid.appendChild(monthCell(dateStr, d, byDate.get(dateStr) || [], dateStr === today));
					}
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- View switching / shared date nav ------------------------------------

			function loadCurrentView() {
				if (viewMode === "list") loadListView();
				else if (viewMode === "day") loadDayView();
				else if (viewMode === "week") loadWeekView();
				else loadMonthView();
			}

			function setViewMode(mode) {
				viewMode = mode;
				viewButtons.forEach((b) => b.classList.toggle("is-active", b.dataset.view === mode));
				listViewEl.hidden = mode !== "list";
				dayViewEl.hidden = mode !== "day";
				weekViewEl.hidden = mode !== "week";
				monthViewEl.hidden = mode !== "month";
				periodNavEl.hidden = mode === "list";
				periodLabel.hidden = mode === "day" || mode === "list";
			}

			// Used by week/month "no chip clicked" areas to drop into the
			// full-detail Day view for that date.
			function jumpToDay(dateStr) {
				dayPicker.value = dateStr;
				setViewMode("day");
				loadDayView();
			}

			viewButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					if (btn.dataset.view === viewMode) return;
					setViewMode(btn.dataset.view);
					loadCurrentView();
				});
			});

			prevPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, -1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, -7);
				else dayPicker.value = addMonths(dayPicker.value, -1);
				loadCurrentView();
			});
			nextPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, 1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, 7);
				else dayPicker.value = addMonths(dayPicker.value, 1);
				loadCurrentView();
			});
			todayBtn.addEventListener("click", () => {
				dayPicker.value = todayLocalIso();
				loadCurrentView();
			});
			dayPicker.addEventListener("change", loadCurrentView);

			dayPicker.value = todayLocalIso();
			loadCleaners().then(loadCurrentView);
		</script>

