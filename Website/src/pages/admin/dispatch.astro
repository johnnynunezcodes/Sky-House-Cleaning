---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. The
// dispatch board: reads real bookings straight from Google Calendar (the
// existing source of truth) and layers on a Firestore overlay for
// assignment/status. See AGENTS.md → "Dispatcher (jobs)" and
// src/lib/dispatch.js for why it's built this way instead of a duplicated
// `jobs` collection.
//
// Three view modes share one date-range-aware read (list-jobs.js already
// supported a `days` param before any of this existed): Day is the original
// full-detail view (assign cleaners, change status, confirm) unchanged.
// Week and Month are read-only overviews built for one purpose — seeing at
// a glance which jobs across a wider range still need a cleaner assigned —
// and clicking any job/day in them jumps into Day view to actually act on
// it, rather than duplicating the assign/status editing controls three
// times over.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Dispatch | Sky House Cleaning Staff Tools">
			<div class="container admin-container">
				<h1>Dispatch</h1>
				<p class="admin-hint">
					Every real job on the calendar, with who's assigned, their status, and whether the
					cleaner has confirmed. This reads directly from Google Calendar, not a separate copy —
					reschedules, cancellations, and new bookings show up here automatically.
				</p>

				<details class="card admin-add-card">
					<summary class="admin-add-summary">Manage cleaners</summary>
					<div id="cleaners-list"></div>
					<form id="add-cleaner-form" class="admin-form admin-inline-form">
						<div class="admin-form__row">
							<label for="add-cleaner-name">Name *</label>
							<input type="text" id="add-cleaner-name" name="name" required />
						</div>
						<div class="admin-form__row">
							<label for="add-cleaner-phone">Phone</label>
							<input type="tel" id="add-cleaner-phone" name="phone" />
						</div>
						<div class="admin-form__row">
							<label for="add-cleaner-email">Email</label>
							<input type="email" id="add-cleaner-email" name="email" />
						</div>
						<button type="submit" class="btn btn--outline">Add Cleaner</button>
					</form>
					<p class="admin-result-message" id="cleaner-message" hidden></p>
				</details>

				<div class="admin-view-switcher" role="group" aria-label="View">
					<button type="button" class="admin-view-btn is-active" data-view="day">Day</button>
					<button type="button" class="admin-view-btn" data-view="week">Week</button>
					<button type="button" class="admin-view-btn" data-view="month">Month</button>
				</div>

				<div class="admin-day-nav">
					<button type="button" id="prev-period" class="btn btn--outline">← Previous</button>
					<input type="date" id="day-picker" />
					<span id="period-label" class="admin-period-label" hidden></span>
					<button type="button" id="next-period" class="btn btn--outline">Next →</button>
					<button type="button" id="today-btn" class="btn btn--outline">Today</button>
				</div>

				<p id="load-status" class="admin-status">Loading…</p>

				<div id="day-view" class="admin-day-view">
					<div id="jobs-list"></div>
				</div>

				<div id="week-view" class="admin-week-view" hidden>
					<div id="week-board" class="admin-week-board"></div>
				</div>

				<div id="month-view" class="admin-month-view" hidden>
					<div class="admin-month-weekdays">
						<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
					</div>
					<div id="month-grid" class="admin-month-grid"></div>
				</div>
			</div>

		<script>
			const dayPicker = document.getElementById("day-picker");
			const prevPeriodBtn = document.getElementById("prev-period");
			const nextPeriodBtn = document.getElementById("next-period");
			const todayBtn = document.getElementById("today-btn");
			const periodLabel = document.getElementById("period-label");
			const loadStatus = document.getElementById("load-status");
			const jobsList = document.getElementById("jobs-list");
			const cleanersList = document.getElementById("cleaners-list");
			const addCleanerForm = document.getElementById("add-cleaner-form");
			const cleanerMessage = document.getElementById("cleaner-message");
			const viewButtons = Array.from(document.querySelectorAll(".admin-view-btn"));
			const dayViewEl = document.getElementById("day-view");
			const weekViewEl = document.getElementById("week-view");
			const monthViewEl = document.getElementById("month-view");
			const weekBoard = document.getElementById("week-board");
			const monthGrid = document.getElementById("month-grid");

			const STATUS_LABELS = {
				unassigned: "Unassigned",
				assigned: "Assigned",
				en_route: "En route",
				in_progress: "In progress",
				completed: "Completed",
			};
			const STATUS_ORDER = ["unassigned", "assigned", "en_route", "in_progress", "completed"];

			let cleaners = [];
			let viewMode = "day"; // "day" | "week" | "month"

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function todayLocalIso() {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			}

			function fmtTime(iso) {
				return new Date(iso).toLocaleTimeString("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "numeric",
					minute: "2-digit",
				});
			}

			function addDays(dateStr, delta) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() + delta);
				return date.toISOString().slice(0, 10);
			}

			// Sunday-start, matching the weekday header row used both here and on
			// the public/admin booking pages' own calendar (schedule.astro,
			// admin/book.astro).
			function startOfWeek(dateStr) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() - date.getUTCDay());
				return date.toISOString().slice(0, 10);
			}

			function startOfMonth(dateStr) {
				return `${dateStr.slice(0, 7)}-01`;
			}

			function daysInMonthCount(dateStr) {
				const [y, m] = dateStr.split("-").map(Number);
				return new Date(Date.UTC(y, m, 0)).getUTCDate();
			}

			// Always normalized to the 1st — month view only ever anchors to
			// "which month," never a specific day within it.
			function addMonths(dateStr, delta) {
				const [y, m] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1 + delta, 1));
				return date.toISOString().slice(0, 10);
			}

			function localDate(dateStr) {
				// Deliberately NOT `new Date(dateStr)` — that parses "YYYY-MM-DD" as
				// UTC midnight, which can print as the previous day in a
				// west-of-UTC browser. Appending a local time-of-day avoids that.
				return new Date(dateStr + "T00:00:00");
			}

			function groupByDate(jobs) {
				const map = new Map();
				for (const j of jobs) {
					if (!map.has(j.visitDate)) map.set(j.visitDate, []);
					map.get(j.visitDate).push(j);
				}
				for (const arr of map.values()) arr.sort((a, b) => new Date(a.start) - new Date(b.start));
				return map;
			}

			function cleanerNamesFor(ids) {
				return (ids || []).map((id) => cleaners.find((c) => c.id === id)?.name).filter(Boolean);
			}

			async function loadCleaners() {
				try {
					const res = await fetch("/api/admin/dispatch/list-cleaners");
					const data = await res.json();
					if (res.ok) cleaners = data.cleaners || [];
					renderCleanersList();
				} catch {
					// Non-fatal — assignment dropdowns/names just come up empty.
				}
			}

			function renderCleanersList() {
				if (!cleaners.length) {
					cleanersList.innerHTML = `<p class="admin-card__meta">No cleaners added yet.</p>`;
					return;
				}
				cleanersList.innerHTML = cleaners
					.map(
						(c) => `
						<div class="admin-cleaner-row">
							<span>${escapeHtml(c.name)}${c.phone ? " · " + escapeHtml(c.phone) : ""}${c.active ? "" : " (inactive)"}</span>
							<button type="button" class="btn btn--outline admin-toggle-active" data-id="${c.id}" data-active="${c.active}">
								${c.active ? "Mark inactive" : "Mark active"}
							</button>
						</div>
					`,
					)
					.join("");

				cleanersList.querySelectorAll(".admin-toggle-active").forEach((btn) => {
					btn.addEventListener("click", async () => {
						btn.disabled = true;
						try {
							await fetch("/api/admin/dispatch/update-cleaner", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ id: btn.dataset.id, active: btn.dataset.active !== "true" }),
							});
							await loadCleaners();
						} finally {
							btn.disabled = false;
						}
					});
				});
			}

			addCleanerForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const formData = new FormData(addCleanerForm);
				const payload = Object.fromEntries(formData.entries());
				const submitBtn = addCleanerForm.querySelector("button[type=submit]");
				submitBtn.disabled = true;
				cleanerMessage.hidden = true;
				try {
					const res = await fetch("/api/admin/dispatch/create-cleaner", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) {
						cleanerMessage.hidden = false;
						cleanerMessage.textContent = data.error || "Something went wrong.";
						cleanerMessage.classList.add("admin-result-message--error");
						return;
					}
					addCleanerForm.reset();
					await loadCleaners();
				} catch {
					cleanerMessage.hidden = false;
					cleanerMessage.textContent = "Network error, please try again.";
					cleanerMessage.classList.add("admin-result-message--error");
				} finally {
					submitBtn.disabled = false;
				}
			});

			function cleanerOptions(selectedIds) {
				return cleaners
					.filter((c) => c.active || selectedIds.includes(c.id))
					.map((c) => `<option value="${c.id}" ${selectedIds.includes(c.id) ? "selected" : ""}>${escapeHtml(c.name)}</option>`)
					.join("");
			}

			// --- Day view (full detail — assign, status, confirm) ------------------

			function jobCard(job) {
				const card = document.createElement("div");
				card.className = "card admin-job-card";
				const assignedIds = job.assignedCleanerIds || [];
				card.innerHTML = `
					<div class="admin-job-card__header">
						<div>
							<h4>${fmtTime(job.start)} – ${fmtTime(job.end)}</h4>
							<p class="admin-card__meta">${escapeHtml(job.summary)}</p>
							${job.location ? `<p class="admin-card__meta">${escapeHtml(job.location)}</p>` : ""}
						</div>
						<div class="admin-job-card__badges">
							<span class="admin-badge admin-badge--${job.status} admin-job-card__status-badge">${STATUS_LABELS[job.status] || job.status}</span>
							<span class="admin-confirmed-check" ${job.cleanerConfirmed ? "" : "hidden"}>✓ Confirmed</span>
						</div>
					</div>
					<div class="admin-job-card__controls">
						<div class="admin-form__row">
							<label>Assigned</label>
							<select multiple class="admin-assign-select" size="${Math.min(4, Math.max(2, cleaners.length))}">
								${cleanerOptions(assignedIds)}
							</select>
						</div>
						<div class="admin-form__row">
							<label>Status</label>
							<select class="admin-status-select">
								${STATUS_ORDER.map((s) => `<option value="${s}" ${job.status === s ? "selected" : ""}>${STATUS_LABELS[s]}</option>`).join("")}
							</select>
						</div>
						<div class="admin-form__row admin-form__row--checkbox">
							<label class="admin-confirm-label">
								<input type="checkbox" class="admin-confirmed-checkbox" ${job.cleanerConfirmed ? "checked" : ""} ${assignedIds.length === 0 ? "disabled" : ""} />
								Confirmed by cleaner
							</label>
						</div>
					</div>
					<p class="admin-result-message" hidden></p>
				`;

				const assignSelect = card.querySelector(".admin-assign-select");
				const statusSelect = card.querySelector(".admin-status-select");
				const confirmedCheckbox = card.querySelector(".admin-confirmed-checkbox");
				const statusBadge = card.querySelector(".admin-job-card__status-badge");
				const confirmedBadge = card.querySelector(".admin-confirmed-check");
				const messageEl = card.querySelector(".admin-result-message");

				async function saveJob(extraFields) {
					messageEl.hidden = true;
					try {
						const res = await fetch("/api/admin/dispatch/update-job", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({
								jobKey: job.jobKey,
								eventId: job.eventId,
								visitDate: job.visitDate,
								...extraFields,
							}),
						});
						const data = await res.json();
						if (!res.ok) {
							messageEl.hidden = false;
							messageEl.textContent = data.error || "Something went wrong.";
							messageEl.classList.add("admin-result-message--error");
						}
					} catch {
						messageEl.hidden = false;
						messageEl.textContent = "Network error, please try again.";
						messageEl.classList.add("admin-result-message--error");
					}
				}

				assignSelect.addEventListener("change", () => {
					const selectedIds = Array.from(assignSelect.selectedOptions).map((o) => o.value);
					const nextStatus = selectedIds.length && job.status === "unassigned" ? "assigned" : undefined;
					if (nextStatus) statusSelect.value = nextStatus;

					const extra = { assignedCleanerIds: selectedIds, ...(nextStatus ? { status: nextStatus } : {}) };

					// Unassigning everyone makes "confirmed" meaningless — reset it
					// rather than leaving a stale confirmation attached to nobody.
					confirmedCheckbox.disabled = selectedIds.length === 0;
					if (selectedIds.length === 0 && confirmedCheckbox.checked) {
						confirmedCheckbox.checked = false;
						extra.cleanerConfirmed = false;
						confirmedBadge.hidden = true;
					}

					saveJob(extra);
					if (nextStatus) {
						job.status = nextStatus;
						statusBadge.className = `admin-badge admin-badge--${nextStatus} admin-job-card__status-badge`;
						statusBadge.textContent = STATUS_LABELS[nextStatus];
					}
				});

				statusSelect.addEventListener("change", () => {
					job.status = statusSelect.value;
					statusBadge.className = `admin-badge admin-badge--${statusSelect.value} admin-job-card__status-badge`;
					statusBadge.textContent = STATUS_LABELS[statusSelect.value];
					saveJob({ status: statusSelect.value });
				});

				confirmedCheckbox.addEventListener("change", () => {
					confirmedBadge.hidden = !confirmedCheckbox.checked;
					saveJob({ cleanerConfirmed: confirmedCheckbox.checked });
				});

				return card;
			}

			async function loadDayView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				jobsList.innerHTML = "";
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${dayPicker.value}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const jobs = data.jobs || [];
					if (!jobs.length) {
						jobsList.innerHTML = `<p class="admin-status">No jobs scheduled this day.</p>`;
						return;
					}
					for (const job of jobs) jobsList.appendChild(jobCard(job));
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- Week view (read-only board, click a job to jump into Day view) ----

			function formatWeekRange(weekStart) {
				const start = localDate(weekStart).toLocaleDateString("en-US", { month: "short", day: "numeric" });
				const end = localDate(addDays(weekStart, 6)).toLocaleDateString("en-US", {
					month: "short",
					day: "numeric",
					year: "numeric",
				});
				return `${start} – ${end}`;
			}

			function weekCard(job) {
				const card = document.createElement("button");
				card.type = "button";
				const assignedIds = job.assignedCleanerIds || [];
				const isUnassigned = assignedIds.length === 0;
				card.className = "admin-week-card" + (isUnassigned ? " admin-week-card--unassigned" : "");
				const names = cleanerNamesFor(assignedIds);
				card.innerHTML = `
					<p class="admin-week-card__time">${fmtTime(job.start)}</p>
					<p class="admin-week-card__summary">${escapeHtml(job.summary)}</p>
					<p class="admin-week-card__cleaners${names.length ? "" : " admin-week-card__cleaners--empty"}">
						${names.length ? escapeHtml(names.join(", ")) : "Needs cleaner"}
					</p>
					<div class="admin-week-card__footer">
						<span class="admin-badge admin-badge--${job.status}">${STATUS_LABELS[job.status] || job.status}</span>
						${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
					</div>
				`;
				card.addEventListener("click", () => jumpToDay(job.visitDate));
				return card;
			}

			function weekColumn(dateStr, jobs, isToday) {
				const col = document.createElement("div");
				col.className = "admin-week-col" + (isToday ? " is-today" : "");
				const date = localDate(dateStr);
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;

				col.innerHTML = `
					<div class="admin-week-col__header">
						<span class="admin-week-col__day">${date.toLocaleDateString("en-US", { weekday: "short" })}</span>
						<span class="admin-week-col__date">${date.getDate()}</span>
						${unassignedCount ? `<span class="admin-week-col__badge">${unassignedCount}</span>` : ""}
					</div>
					<div class="admin-week-col__jobs"></div>
				`;

				const jobsEl = col.querySelector(".admin-week-col__jobs");
				if (!jobs.length) {
					jobsEl.innerHTML = `<p class="admin-week-empty">No jobs</p>`;
				} else {
					jobs.forEach((job) => jobsEl.appendChild(weekCard(job)));
				}
				return col;
			}

			async function loadWeekView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				weekBoard.innerHTML = "";
				const weekStart = startOfWeek(dayPicker.value);
				periodLabel.hidden = false;
				periodLabel.textContent = formatWeekRange(weekStart);
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${weekStart}&days=7`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const byDate = groupByDate(data.jobs || []);
					const today = todayLocalIso();
					for (let i = 0; i < 7; i++) {
						const dateStr = addDays(weekStart, i);
						weekBoard.appendChild(weekColumn(dateStr, byDate.get(dateStr) || [], dateStr === today));
					}
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- Month view (read-only grid, click a day to jump into Day view) ----

			function monthCell(dateStr, dayNum, jobs, isToday) {
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;
				const cell = document.createElement("button");
				cell.type = "button";
				cell.className =
					"admin-month-day" + (isToday ? " is-today" : "") + (unassignedCount ? " has-unassigned" : "");
				cell.innerHTML = `
					<span class="admin-month-day__num">${dayNum}</span>
					${jobs.length ? `<span class="admin-month-day__count">${jobs.length} job${jobs.length === 1 ? "" : "s"}</span>` : ""}
					${unassignedCount ? `<span class="admin-month-day__badge">${unassignedCount} unassigned</span>` : ""}
				`;
				cell.addEventListener("click", () => jumpToDay(dateStr));
				return cell;
			}

			async function loadMonthView() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				monthGrid.innerHTML = "";
				const monthStart = startOfMonth(dayPicker.value);
				const totalDays = daysInMonthCount(monthStart);
				periodLabel.hidden = false;
				periodLabel.textContent = localDate(monthStart).toLocaleDateString("en-US", {
					month: "long",
					year: "numeric",
				});
				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${monthStart}&days=${totalDays}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load jobs.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const byDate = groupByDate(data.jobs || []);
					const today = todayLocalIso();
					const firstDow = localDate(monthStart).getDay();
					for (let i = 0; i < firstDow; i++) {
						const pad = document.createElement("span");
						pad.className = "admin-month-pad";
						monthGrid.appendChild(pad);
					}
					for (let d = 1; d <= totalDays; d++) {
						const dateStr = `${monthStart.slice(0, 8)}${String(d).padStart(2, "0")}`;
						monthGrid.appendChild(monthCell(dateStr, d, byDate.get(dateStr) || [], dateStr === today));
					}
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			// --- View switching / shared date nav ------------------------------------

			function loadCurrentView() {
				if (viewMode === "day") loadDayView();
				else if (viewMode === "week") loadWeekView();
				else loadMonthView();
			}

			function setViewMode(mode) {
				viewMode = mode;
				viewButtons.forEach((b) => b.classList.toggle("is-active", b.dataset.view === mode));
				dayViewEl.hidden = mode !== "day";
				weekViewEl.hidden = mode !== "week";
				monthViewEl.hidden = mode !== "month";
				periodLabel.hidden = mode === "day";
			}

			// Used by week/month cells to drop straight into the full-detail Day
			// view for that date, rather than trying to edit assignment/status
			// inline from a compact card.
			function jumpToDay(dateStr) {
				dayPicker.value = dateStr;
				setViewMode("day");
				loadDayView();
			}

			viewButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					if (btn.dataset.view === viewMode) return;
					setViewMode(btn.dataset.view);
					loadCurrentView();
				});
			});

			prevPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, -1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, -7);
				else dayPicker.value = addMonths(dayPicker.value, -1);
				loadCurrentView();
			});
			nextPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, 1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, 7);
				else dayPicker.value = addMonths(dayPicker.value, 1);
				loadCurrentView();
			});
			todayBtn.addEventListener("click", () => {
				dayPicker.value = todayLocalIso();
				loadCurrentView();
			});
			dayPicker.addEventListener("change", loadCurrentView);

			dayPicker.value = todayLocalIso();
			loadCleaners().then(loadCurrentView);
		</script>

