---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. CRM
// Deals: the lead pipeline, backed by Firestore (src/lib/crm.js). See
// AGENTS.md → "CRM (Firebase/Firestore)" for the data model.
export const prerender = false;

import "../../../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>CRM: Deals | Sky House Cleaning Staff Tools</title>
	</head>
	<body>
		<main class="section">
			<div class="container admin-container">
				<p class="admin-nav">
					<a href="/admin/crm/contacts">← Contacts</a>
					· <a href="/admin/reschedule">Manage a specific customer's plan →</a>
				</p>
				<h1>CRM: Deals</h1>
				<p class="admin-hint">
					Everyone who's inquired but hasn't booked yet. Marking a deal <strong>Won</strong>
					automatically flips the linked contact to an active client — nothing else to update by
					hand.
				</p>

				<p id="load-status" class="admin-status">Loading…</p>

				<details class="card admin-add-card">
					<summary class="admin-add-summary">+ Add a deal</summary>
					<form id="add-form" class="admin-form">
						<div class="admin-form__grid">
							<div class="admin-form__row admin-form__row--full">
								<label for="add-contactId">Contact</label>
								<select id="add-contactId" name="contactId">
									<option value="">+ New contact…</option>
								</select>
							</div>
							<div id="new-contact-fields" class="admin-form__row admin-form__row--full admin-form__subgrid">
								<div class="admin-form__row">
									<label for="add-newContactName">New contact name *</label>
									<input type="text" id="add-newContactName" name="newContactName" />
								</div>
								<div class="admin-form__row">
									<label for="add-newContactPhone">Phone</label>
									<input type="tel" id="add-newContactPhone" name="newContactPhone" />
								</div>
								<div class="admin-form__row">
									<label for="add-newContactEmail">Email</label>
									<input type="email" id="add-newContactEmail" name="newContactEmail" />
								</div>
								<div class="admin-form__row">
									<label for="add-newContactLeadSource">Lead source</label>
									<input type="text" id="add-newContactLeadSource" name="newContactLeadSource" placeholder="Referral, Google, Facebook…" />
								</div>
							</div>
							<div class="admin-form__row admin-form__row--full">
								<label for="add-title">Deal title *</label>
								<input type="text" id="add-title" name="title" required placeholder="e.g. Jane Doe, Weekly Cleaning or Acme Corp, Office Cleaning" />
							</div>
							<div class="admin-form__row">
								<label for="add-serviceType">Service type</label>
								<select id="add-serviceType" name="serviceType">
									<option value="">Not sure yet</option>
									<option value="One-Time Cleaning">One-Time Cleaning</option>
									<option value="Recurring Cleaning">Recurring Cleaning</option>
									<option value="Deep Cleaning">Deep Cleaning</option>
									<option value="Move-In / Move-Out Cleaning">Move-In / Move-Out Cleaning</option>
									<option value="Garage Cleaning & Organization">Garage Cleaning &amp; Organization</option>
									<option value="Interior Car Detailing">Interior Car Detailing</option>
									<option value="Airbnb Cleaning">Airbnb Cleaning</option>
									<option value="Office & Commercial Cleaning">Office &amp; Commercial Cleaning</option>
									<option value="Post-Construction Cleaning">Post-Construction Cleaning</option>
								</select>
							</div>
							<div class="admin-form__row">
								<label for="add-estimatedValue">Estimated value ($)</label>
								<input type="number" id="add-estimatedValue" name="estimatedValue" min="0" step="1" />
							</div>
							<div class="admin-form__row">
								<label for="add-expectedCloseDate">Expected close date</label>
								<input type="date" id="add-expectedCloseDate" name="expectedCloseDate" />
							</div>
							<div class="admin-form__row admin-form__row--full">
								<label for="add-notes">Notes</label>
								<input type="text" id="add-notes" name="notes" />
							</div>
						</div>
						<button type="submit" class="btn btn--primary">Add Deal</button>
						<p class="admin-result-message" hidden></p>
					</form>
				</details>

				<div class="admin-filters" role="group" aria-label="Filter deals">
					<button type="button" class="admin-filter is-active" data-view="open">Open pipeline</button>
					<button type="button" class="admin-filter" data-view="won">Won</button>
					<button type="button" class="admin-filter" data-view="lost">Lost</button>
					<button type="button" class="admin-filter" data-view="">All</button>
				</div>

				<div id="board"></div>
			</div>
		</main>

		<script>
			const loadStatus = document.getElementById("load-status");
			const board = document.getElementById("board");
			const addForm = document.getElementById("add-form");
			const contactSelect = document.getElementById("add-contactId");
			const newContactFields = document.getElementById("new-contact-fields");
			const filterButtons = document.querySelectorAll(".admin-filter");

			const STAGE_LABELS = {
				new_inquiry: "New Inquiry",
				quote_sent: "Quote Sent",
				follow_up: "Follow-Up",
				won: "Won",
				lost: "Lost",
			};
			const OPEN_STAGE_ORDER = ["new_inquiry", "quote_sent", "follow_up"];
			const NEXT_STAGE = { new_inquiry: "quote_sent", quote_sent: "follow_up" };

			let currentView = "open";
			let allClients = [];

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function fmtDate(iso) {
				if (!iso) return "";
				// expectedCloseDate is stored as a plain "YYYY-MM-DD" string, not a
				// timestamp, so parse it as local rather than letting `Date` treat
				// it as UTC midnight (which shifts it a day back in Pacific time).
				const [y, m, d] = iso.split("-").map(Number);
				if (!y || !m || !d) return iso;
				return new Date(y, m - 1, d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
			}

			function fmtValue(n) {
				if (n == null || n === "") return "";
				return `$${Number(n).toLocaleString()}`;
			}

			async function loadClients() {
				try {
					const res = await fetch("/api/admin/crm/list-clients");
					const data = await res.json();
					if (res.ok) allClients = data.clients || [];
					contactSelect.innerHTML =
						`<option value="">+ New contact…</option>` +
						allClients
							.map((c) => `<option value="${c.id}">${escapeHtml(c.name)}${c.phone ? " · " + escapeHtml(c.phone) : ""}</option>`)
							.join("");
				} catch {
					// Non-fatal — the "+ New contact…" option still works fine.
				}
			}

			contactSelect.addEventListener("change", () => {
				newContactFields.hidden = contactSelect.value !== "";
			});

			async function loadDeals() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				board.innerHTML = "";
				try {
					const stageParam = currentView === "open" ? "" : currentView;
					const qs = stageParam ? `?stage=${encodeURIComponent(stageParam)}` : "";
					const res = await fetch(`/api/admin/crm/list-deals${qs}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load deals.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					const deals = data.deals || [];
					if (currentView === "open") {
						renderOpenBoard(deals.filter((d) => OPEN_STAGE_ORDER.includes(d.stage)));
					} else {
						renderFlatList(deals);
					}
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			function dealCard(deal) {
				const card = document.createElement("div");
				card.className = "card admin-deal-card";
				const advanceStage = NEXT_STAGE[deal.stage];
				card.innerHTML = `
					<h4>${escapeHtml(deal.title) || "(untitled deal)"}</h4>
					<p class="admin-card__meta">${escapeHtml(deal.contactName)}${deal.contactPhone ? " · " + escapeHtml(deal.contactPhone) : ""}</p>
					${deal.serviceType ? `<p class="admin-card__meta">${escapeHtml(deal.serviceType)}</p>` : ""}
					<p class="admin-card__meta">
						${[fmtValue(deal.estimatedValue), deal.expectedCloseDate ? "Expected " + fmtDate(deal.expectedCloseDate) : ""].filter(Boolean).join(" · ")}
					</p>
					${deal.notes ? `<p class="admin-card__meta admin-card__notes">${escapeHtml(deal.notes)}</p>` : ""}
					${deal.stage === "lost" && deal.lostReason ? `<p class="admin-card__meta admin-card__notes">Lost reason: ${escapeHtml(deal.lostReason)}</p>` : ""}
					<div class="admin-deal-actions">
						${advanceStage ? `<button type="button" class="btn btn--outline admin-advance">Mark ${STAGE_LABELS[advanceStage]}</button>` : ""}
						${deal.stage !== "won" && deal.stage !== "lost" ? `<button type="button" class="btn btn--outline admin-win">Mark Won</button>` : ""}
						${deal.stage !== "won" && deal.stage !== "lost" ? `<button type="button" class="btn btn--outline admin-lost">Mark Lost</button>` : ""}
						${deal.contactId ? `<a href="/admin/quote?contactId=${encodeURIComponent(deal.contactId)}" class="btn btn--outline">Convert to Booking</a>` : ""}
					</div>
					<p class="admin-result-message" hidden></p>
				`;

				const messageEl = card.querySelector(".admin-result-message");
				function showMessage(text, isError = false) {
					messageEl.hidden = false;
					messageEl.textContent = text;
					messageEl.classList.toggle("admin-result-message--error", isError);
				}

				const advanceBtn = card.querySelector(".admin-advance");
				if (advanceBtn) {
					advanceBtn.addEventListener("click", async () => {
						advanceBtn.disabled = true;
						try {
							const res = await fetch("/api/admin/crm/update-deal", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ id: deal.id, stage: advanceStage }),
							});
							const data = await res.json();
							if (!res.ok) return showMessage(data.error || "Something went wrong.", true);
							await loadDeals();
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							advanceBtn.disabled = false;
						}
					});
				}

				const winBtn = card.querySelector(".admin-win");
				if (winBtn) {
					winBtn.addEventListener("click", async () => {
						if (!confirm(`Mark "${deal.title}" as Won? This also activates ${deal.contactName} as a client.`)) return;
						winBtn.disabled = true;
						try {
							const res = await fetch("/api/admin/crm/win-deal", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ id: deal.id }),
							});
							const data = await res.json();
							if (!res.ok) return showMessage(data.error || "Something went wrong.", true);
							await loadDeals();
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							winBtn.disabled = false;
						}
					});
				}

				const lostBtn = card.querySelector(".admin-lost");
				if (lostBtn) {
					lostBtn.addEventListener("click", async () => {
						const reason = prompt(`Why is "${deal.title}" lost? (optional)`) || "";
						lostBtn.disabled = true;
						try {
							const res = await fetch("/api/admin/crm/update-deal", {
								method: "POST",
								headers: { "Content-Type": "application/json" },
								body: JSON.stringify({ id: deal.id, stage: "lost", lostReason: reason }),
							});
							const data = await res.json();
							if (!res.ok) return showMessage(data.error || "Something went wrong.", true);
							await loadDeals();
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							lostBtn.disabled = false;
						}
					});
				}

				return card;
			}

			function renderOpenBoard(deals) {
				if (!deals.length) {
					board.innerHTML = `<p class="admin-status">No open deals. Add one above.</p>`;
					return;
				}
				const columns = document.createElement("div");
				columns.className = "admin-board";
				for (const stage of OPEN_STAGE_ORDER) {
					const col = document.createElement("div");
					col.className = "admin-column";
					const stageDeals = deals.filter((d) => d.stage === stage);
					col.innerHTML = `<h3 class="admin-column__title">${STAGE_LABELS[stage]} <span class="admin-column__count">${stageDeals.length}</span></h3>`;
					for (const deal of stageDeals) col.appendChild(dealCard(deal));
					columns.appendChild(col);
				}
				board.innerHTML = "";
				board.appendChild(columns);
			}

			function renderFlatList(deals) {
				if (!deals.length) {
					board.innerHTML = `<p class="admin-status">No deals here.</p>`;
					return;
				}
				board.innerHTML = "";
				const list = document.createElement("div");
				for (const deal of deals) list.appendChild(dealCard(deal));
				board.appendChild(list);
			}

			addForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const messageEl = addForm.querySelector(".admin-result-message");
				const submitBtn = addForm.querySelector("button[type=submit]");
				const formData = new FormData(addForm);
				const raw = Object.fromEntries(formData.entries());

				const payload = {
					title: raw.title,
					serviceType: raw.serviceType,
					estimatedValue: raw.estimatedValue,
					expectedCloseDate: raw.expectedCloseDate,
					notes: raw.notes,
				};
				if (raw.contactId) {
					payload.contactId = raw.contactId;
				} else {
					payload.newContact = {
						name: raw.newContactName,
						phone: raw.newContactPhone,
						email: raw.newContactEmail,
						leadSource: raw.newContactLeadSource,
					};
				}

				submitBtn.disabled = true;
				messageEl.hidden = true;
				try {
					const res = await fetch("/api/admin/crm/create-deal", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) {
						messageEl.hidden = false;
						messageEl.textContent = data.error || "Something went wrong.";
						messageEl.classList.add("admin-result-message--error");
						return;
					}
					addForm.reset();
					newContactFields.hidden = false;
					messageEl.hidden = false;
					messageEl.classList.remove("admin-result-message--error");
					messageEl.textContent = "Deal added.";
					await loadClients();
					await loadDeals();
				} catch {
					messageEl.hidden = false;
					messageEl.textContent = "Network error, please try again.";
					messageEl.classList.add("admin-result-message--error");
				} finally {
					submitBtn.disabled = false;
				}
			});

			filterButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					filterButtons.forEach((b) => b.classList.remove("is-active"));
					btn.classList.add("is-active");
					currentView = btn.dataset.view;
					loadDeals();
				});
			});

			loadClients();
			loadDeals();
		</script>

		<style>
			.admin-container {
				max-width: 980px;
				margin: 0 auto;
				padding-block: 3rem;
			}

			.admin-nav {
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
			}

			.admin-hint {
				color: var(--color-slate);
				margin-bottom: 1.5rem;
			}

			.admin-status {
				margin-bottom: 1rem;
			}

			.admin-status--error {
				color: #b3261e;
			}

			.admin-add-card {
				margin-bottom: 1.5rem;
				padding: 1.25rem 1.5rem;
			}

			.admin-add-summary {
				cursor: pointer;
				font-weight: 600;
				color: var(--color-ink);
			}

			.admin-add-card form {
				margin-top: 1.25rem;
			}

			.admin-form__grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem 1.5rem;
				margin-bottom: 1.25rem;
			}

			.admin-form__subgrid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem 1.5rem;
				padding: 1rem;
				background: var(--color-sky-light);
				border-radius: 8px;
			}

			.admin-form__row {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
			}

			.admin-form__row--full {
				grid-column: 1 / -1;
			}

			.admin-form__row label {
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.admin-form__row input,
			.admin-form__row select {
				padding: 0.6rem 0.75rem;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				font-size: 0.95rem;
				font-family: inherit;
			}

			@media (max-width: 640px) {
				.admin-form__grid,
				.admin-form__subgrid {
					grid-template-columns: 1fr;
				}
			}

			.admin-filters {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1.5rem;
			}

			.admin-filter {
				padding: 0.4rem 0.9rem;
				border-radius: 999px;
				border: 1px solid var(--color-border);
				background: var(--color-white);
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--color-slate);
				cursor: pointer;
			}

			.admin-filter.is-active {
				background: var(--color-ink);
				border-color: var(--color-ink);
				color: var(--color-white);
			}

			.admin-board {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				align-items: start;
			}

			@media (max-width: 900px) {
				.admin-board {
					grid-template-columns: 1fr;
				}
			}

			.admin-column__title {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 1rem;
				margin: 0 0 1rem;
				padding-bottom: 0.5rem;
				border-bottom: 2px solid var(--color-border);
			}

			.admin-column__count {
				background: var(--color-sky-light);
				color: var(--color-slate);
				border-radius: 999px;
				padding: 0.1rem 0.55rem;
				font-size: 0.8rem;
				font-weight: 600;
			}

			.admin-deal-card {
				margin-bottom: 1rem;
				padding: 1.1rem 1.25rem;
			}

			.admin-deal-card h4 {
				margin: 0 0 0.35rem;
			}

			.admin-card__meta {
				color: var(--color-slate);
				margin: 0.25rem 0;
				font-size: 0.9rem;
			}

			.admin-card__notes {
				font-style: italic;
			}

			.admin-deal-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-top: 0.85rem;
			}

			.admin-deal-actions .btn {
				font-size: 0.85rem;
				padding: 0.45rem 0.85rem;
			}

			.admin-result-message {
				margin-top: 0.75rem;
				font-weight: 600;
				color: #1e7a34;
				font-size: 0.9rem;
			}

			.admin-result-message--error {
				color: #b3261e;
			}
		</style>
	</body>
</html>
