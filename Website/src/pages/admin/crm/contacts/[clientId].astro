		.admin-badge--sent {
			background: #eaf1fb;
			color: #1a5fb4;
		}

		.admin-badge--overdue {
			background: #fdeceb;
			color: #b3261e;
		}

		.admin-badge--void {
			background: #ececec;
			color: var(--color-slate);
		}

		/* --- Jobs/Invoices tables --- */
		.admin-table {
			width: 100%;
			border-collapse: collapse;
			font-size: 0.9rem;
			margin-top: 0.5rem;
