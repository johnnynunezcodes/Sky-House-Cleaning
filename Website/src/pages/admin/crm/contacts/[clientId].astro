		.admin-table th {
			background: var(--color-sky-light);
			font-weight: 600;
			font-size: 0.78rem;
			text-transform: uppercase;
			letter-spacing: 0.03em;
			color: var(--color-slate);
			white-space: nowrap;
		}

		.admin-table td a {
			color: var(--color-sky-dark);
			font-weight: 600;
		}

		/* --- Edit Client modal — same admin-modal pattern used elsewhere. */
		.admin-modal-backdrop {
			position: fixed;
			inset: 0;
			z-index: 80;
			background: rgba(28, 43, 69, 0.45);
			display: flex;
			align-items: flex-start;
			justify-content: center;
			padding: 4rem 1.5rem;
			overflow-y: auto;
		}

		.admin-modal-backdrop[hidden] {
			display: none;
		}

		.admin-modal {
			width: 100%;
			max-width: 560px;
			padding: 1.5rem;
		}

		.admin-modal__header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: 1rem;
			margin-bottom: 1rem;
			padding-bottom: 1rem;
			border-bottom: 1px solid var(--color-border);
		}

		.admin-modal__header h3 {
			margin: 0;
		}

		.admin-modal__close {
			flex-shrink: 0;
			width: 32px;
			height: 32px;
			border-radius: 50%;
			border: 1px solid var(--color-border);
			background: var(--color-white);
			color: var(--color-slate);
			cursor: pointer;
			font-size: 0.9rem;
		}

		.admin-modal__close:hover {
			border-color: var(--color-sky);
			color: var(--color-sky-dark);
		}

		.admin-form__grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1rem 1.5rem;
			margin-bottom: 1.25rem;
		}

		.admin-form__row {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}

		.admin-form__row--full {
