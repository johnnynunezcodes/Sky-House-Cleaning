---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Step two
// of the phone-booking flow (step one is /admin/quote.astro, which builds
// the `?s=` quote payload this page expects). This is a close adaptation of
// the public /schedule.astro: same date/time picker and contact form, reusing
// the same /api/availability and /api/create-checkout-session endpoints
// unchanged — staff and online customers go through identical slot
// validation and server-side pricing.
//
// The one real difference: /schedule.astro redirects the customer's own browser
// straight to Stripe to pay. Here, staff are booking on someone else's
// behalf over the phone, so there's no card to collect on this screen —
// instead, once the Checkout Session is created, its payment link is shown
// on screen to copy and text/email to the customer. Nothing is booked or
// charged (no calendar event, no card charge) until the customer actually
// completes that payment — same invariant as every other booking path,
// enforced the same way, by stripe-webhook.js only acting on a completed
// payment.
export const prerender = false;

import "../../styles/global.css";
import { WORKING_DAYS, BOOKING_WINDOW_DAYS } from "../../data/booking.js";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Book a Customer | Sky House Cleaning Staff Tools</title>
	</head>
	<body>
		<main class="section" id="book-page" data-working-days={JSON.stringify(WORKING_DAYS)} data-window-days={BOOKING_WINDOW_DAYS}>
			<div class="container admin-container">
				<p class="admin-nav"><a href="/admin/reschedule">← Manage existing plans</a></p>

				<div class="book-step" id="book-no-quote" hidden>
					<h3>Let's start with a quote</h3>
					<p>We couldn't find a saved quote for this session. Head back and build the customer's quote first.</p>
					<a href="/admin/quote" class="btn btn--primary">Build a Quote</a>
				</div>

				<div id="book-steps" class="book-layout">
					<div class="book-main">
						<div class="book-step">
							<h3><span class="book-step__num">1</span> Pick the date &amp; time</h3>
							<p class="book-step__hint">Choose a day, then an open time slot.</p>

							<div class="book-dates" id="book-dates"></div>
							<div class="book-times" id="book-times">
								<p class="book-times__placeholder" id="book-times-placeholder">Pick a date above to see open times.</p>
							</div>
						</div>

						<div class="book-step">
							<h3><span class="book-step__num">2</span> Customer details</h3>
							<p class="book-step__hint">Get these from the customer on the call.</p>

							<form id="book-form" class="book-form">
								<div class="book-form__row">
									<label for="book-name">Full Name</label>
									<input type="text" id="book-name" name="name" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-email">Email</label>
									<input type="email" id="book-email" name="email" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-phone">Phone</label>
									<input type="tel" id="book-phone" name="phone" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-address">Home Address</label>
									<input type="text" id="book-address" name="address" required autocomplete="off" />
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-access">How do we get in?</label>
									<input
										type="text"
										id="book-access"
										name="access"
										placeholder="Gate code, lockbox code, garage code, or if someone will be home"
										required
									/>
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-pets">Will pets be home? <span class="book-form__optional">(optional)</span></label>
									<input type="text" id="book-pets" name="pets" placeholder="Kind, and anything we should know" />
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-notes">Anything else? <span class="book-form__optional">(optional)</span></label>
									<textarea id="book-notes" name="notes" rows="3" placeholder="Parking, allergies, areas to focus on or skip, anything else"></textarea>
								</div>

								<p class="book-form__error" id="book-form-error" hidden></p>

								<button type="submit" class="btn btn--primary book-form__submit" id="book-submit">
									Create Booking &amp; Get Payment Link
								</button>
							</form>
						</div>

						<div class="book-step admin-link-panel" id="book-link-panel" hidden>
							<h3>Booking created — send this to the customer</h3>
							<p class="book-step__hint" id="book-link-recap"></p>

							<div class="admin-link-row">
								<input type="text" id="book-payment-link" class="admin-link-input" readonly />
								<button type="button" class="btn btn--outline" id="book-copy-link">Copy Link</button>
								<button type="button" class="btn btn--outline" id="book-copy-message">Copy Message</button>
							</div>
							<p class="admin-hint--tight">
								Text or email this link to the customer to complete payment. Nothing is booked or
								charged until they pay it — no calendar event exists yet. "Copy Message" copies a
								ready-to-send note with the link already in it, so you're not typing one out by hand.
							</p>
							<a href="#" target="_blank" rel="noopener" id="book-open-link" class="btn btn--outline">Open Payment Page</a>

							<p class="admin-hint--tight admin-link-panel__next">
								<a href="/admin/quote">Book another customer →</a>
							</p>
						</div>
					</div>

					<aside class="book-summary card" id="book-summary">
						<p class="book-summary__label">Order Summary</p>
						<ul class="book-summary__lines" id="book-summary-lines"></ul>
						<div class="book-summary__total">
							<span>Total</span>
							<span id="book-summary-total">$0</span>
						</div>
						<p class="book-summary__note">This is what the customer will be charged when they pay.</p>
					</aside>
				</div>
			</div>
		</main>

		<style>
			.admin-container {
				max-width: 1100px;
				margin: 0 auto;
				padding-block: 3rem;
			}

			.admin-nav {
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
			}

			.book-layout {
				display: grid;
				grid-template-columns: 1.5fr 1fr;
				gap: 2.5rem;
				align-items: start;
			}

			.book-main {
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			.book-step {
				background: var(--color-white);
				border-radius: var(--radius);
				box-shadow: var(--shadow-soft);
				padding: 2rem;
			}

			.book-step h3 {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.5rem;
			}

			.book-step__num {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				border-radius: 50%;
				background: var(--color-sky);
				color: var(--color-white);
				font-size: 0.9rem;
				flex-shrink: 0;
			}

			.book-step__hint {
				font-size: 0.9rem;
				margin-bottom: 1.25rem;
				color: var(--color-slate);
			}

			.book-dates {
				display: flex;
				gap: 0.6rem;
				overflow-x: auto;
				padding-bottom: 0.5rem;
				margin-bottom: 1.25rem;
			}

			.book-dates :global(.book-date-btn) {
				flex: 0 0 auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.15rem;
				min-width: 64px;
				padding: 0.6rem 0.5rem;
				border-radius: 10px;
				border: 1px solid var(--color-border);
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-body);
				cursor: pointer;
			}

			.book-dates :global(.book-date-btn:hover) {
				border-color: var(--color-sky);
			}

			.book-dates :global(.book-date-btn.is-selected) {
				background: var(--color-sky);
				border-color: var(--color-sky);
				color: var(--color-white);
			}

			.book-dates :global(.book-date-btn__day) {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				opacity: 0.8;
			}

			.book-dates :global(.book-date-btn__num) {
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 1.1rem;
			}

			.book-times {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}

			.book-times :global(.book-times__placeholder),
			.book-times :global(.book-times__empty),
			.book-times :global(.book-times__error) {
				margin: 0;
				font-size: 0.9rem;
				color: var(--color-slate-light);
			}

			.book-times :global(.book-time-btn) {
				padding: 0.55rem 1rem;
				border-radius: 999px;
				border: 1px solid var(--color-border);
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-body);
				font-size: 0.9rem;
				cursor: pointer;
			}

			.book-times :global(.book-time-btn:hover) {
				border-color: var(--color-sky);
			}

			.book-times :global(.book-time-btn.is-selected) {
				background: var(--color-sky);
				border-color: var(--color-sky);
				color: var(--color-white);
			}

			.book-form {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem 1.5rem;
			}

			.book-form__row {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.book-form__row--full {
				grid-column: 1 / -1;
			}

			.book-form label {
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.book-form__optional {
				font-weight: 400;
				color: var(--color-slate-light);
			}

			.book-form input,
			.book-form textarea {
				width: 100%;
				font-family: var(--font-body);
				font-size: 0.95rem;
				color: var(--color-ink);
				background: var(--color-cream);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				padding: 0.7rem 0.9rem;
				resize: vertical;
			}

			.book-form input:focus,
			.book-form textarea:focus {
				outline: 2px solid var(--color-sky);
				outline-offset: 1px;
			}

			.book-form__error {
				grid-column: 1 / -1;
				margin: 0;
				font-size: 0.85rem;
				color: #b3261e;
			}

			.book-form__error[hidden] {
				display: none;
			}

			.book-form__submit {
				grid-column: 1 / -1;
				width: 100%;
				margin-top: 0.25rem;
			}

			.book-form__submit[disabled] {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.admin-link-panel {
				border: 2px solid var(--color-sky);
			}

			.admin-link-row {
				display: flex;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.admin-link-input {
				flex: 1;
				font-family: var(--font-body);
				font-size: 0.9rem;
				color: var(--color-ink);
				background: var(--color-cream);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				padding: 0.7rem 0.9rem;
			}

			.admin-hint--tight {
				margin: 0.75rem 0;
				font-size: 0.85rem;
				color: var(--color-slate);
			}

			.admin-link-panel__next {
				margin-top: 1.25rem;
			}

			.book-summary {
				position: sticky;
				top: 1.5rem;
			}

			.book-summary__label {
				margin: 0 0 1rem;
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--color-sky-dark);
			}

			.book-summary__lines {
				list-style: none;
				margin: 0 0 1rem;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}

			/* :global() because these <li> elements are created client-side via
			   document.createElement — Astro's scoped-style attribute only
			   attaches to elements present in the markup at build time, so
			   without :global() this rule silently never matches them. */
			.book-summary__lines :global(li) {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				font-size: 0.9rem;
				color: var(--color-slate);
			}

			.book-summary__total {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 1.4rem;
				color: var(--color-ink);
			}

			.book-summary__note {
				margin: 1rem 0 0;
				font-size: 0.8rem;
				color: var(--color-slate-light);
			}

			@media (max-width: 900px) {
				.book-layout {
					grid-template-columns: 1fr;
				}

				.book-summary {
					position: static;
				}
			}

			@media (max-width: 560px) {
				.book-form {
					grid-template-columns: 1fr;
				}

				.book-step {
					padding: 1.5rem;
				}
			}
		</style>

		<script>
			function initAdminBookPage() {
				const root = document.getElementById("book-page");
				if (!root || root.dataset.bookInit === "true") return;
				root.dataset.bookInit = "true";

				const workingDays = JSON.parse(root.dataset.workingDays || "[1,2,3,4,5,6]");
				const windowDays = Number(root.dataset.windowDays) || 21;

				const noQuoteEl = root.querySelector("#book-no-quote");
				const stepsEl = root.querySelector("#book-steps");
				const summaryLinesEl = root.querySelector("#book-summary-lines");
				const summaryTotalEl = root.querySelector("#book-summary-total");
				const datesEl = root.querySelector("#book-dates");
				const timesEl = root.querySelector("#book-times");
				const formEl = root.querySelector("#book-form");
				const submitBtn = root.querySelector("#book-submit");
				const errorEl = root.querySelector("#book-form-error");
				const linkPanel = root.querySelector("#book-link-panel");
				const linkRecap = root.querySelector("#book-link-recap");
				const linkInput = root.querySelector("#book-payment-link");
				const copyBtn = root.querySelector("#book-copy-link");
				const copyMessageBtn = root.querySelector("#book-copy-message");
				const openLink = root.querySelector("#book-open-link");

				let selectedDate = null; // "YYYY-MM-DD"
				let selectedSlot = null; // { start, end }
				let lastCustomerName = "";

				function formatMoney(n) {
					const value = Number(n) || 0;
					const hasCents = Math.round(value * 100) % 100 !== 0;
					return (
						"$" +
						value.toLocaleString("en-US", {
							minimumFractionDigits: hasCents ? 2 : 0,
							maximumFractionDigits: 2,
						})
					);
				}

				function toDateStr(date) {
					const y = date.getFullYear();
					const m = String(date.getMonth() + 1).padStart(2, "0");
					const d = String(date.getDate()).padStart(2, "0");
					return `${y}-${m}-${d}`;
				}

				function parseSelections() {
					const params = new URLSearchParams(window.location.search);
					const raw = params.get("s");
					if (!raw) return null;
					try {
						return JSON.parse(raw);
					} catch {
						return null;
					}
				}

				const selections = parseSelections();

				if (!selections) {
					if (noQuoteEl) noQuoteEl.hidden = false;
					if (stepsEl) stepsEl.hidden = true;
					const summaryEl = root.querySelector("#book-summary");
					if (summaryEl) summaryEl.hidden = true;
					return;
				}

				// Display-only order summary — the actual charge is always
				// re-derived server-side from `selections`, not from these lines.
				(selections.lines || []).forEach((line) => {
					const li = document.createElement("li");
					const label = document.createElement("span");
					label.textContent = line.label;
					const amount = document.createElement("span");
					amount.textContent = formatMoney(line.amount);
					li.append(label, amount);
					summaryLinesEl.append(li);
				});
				summaryTotalEl.textContent = formatMoney(selections.total);

				const today = new Date();
				today.setHours(0, 0, 0, 0);

				for (let i = 0; i < windowDays; i++) {
					const date = new Date(today);
					date.setDate(date.getDate() + i);
					if (!workingDays.includes(date.getDay())) continue;

					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "book-date-btn";
					btn.dataset.date = toDateStr(date);
					btn.innerHTML = `
						<span class="book-date-btn__day">${date.toLocaleDateString("en-US", { weekday: "short" })}</span>
						<span class="book-date-btn__num">${date.getDate()}</span>
					`;
					btn.addEventListener("click", () => selectDate(btn.dataset.date, btn));
					datesEl.append(btn);
				}

				async function selectDate(dateStr, btnEl) {
					selectedDate = dateStr;
					selectedSlot = null;

					datesEl.querySelectorAll(".book-date-btn").forEach((b) => b.classList.remove("is-selected"));
					btnEl.classList.add("is-selected");

					timesEl.innerHTML = `<p class="book-times__placeholder">Loading times…</p>`;

					try {
						const response = await fetch(
							`/api/availability?date=${encodeURIComponent(dateStr)}&type=${encodeURIComponent(selections.type || "standard")}`,
						);
						const data = await response.json();

						if (!response.ok) {
							throw new Error(data.error || "Couldn't load availability.");
						}

						renderTimes(data.slots || []);
					} catch (err) {
						const message = err instanceof Error ? err.message : "Couldn't load availability.";
						timesEl.innerHTML = `<p class="book-times__error">${message}</p>`;
					}
				}

				function renderTimes(slots) {
					timesEl.innerHTML = "";

					if (slots.length === 0) {
						timesEl.innerHTML = `<p class="book-times__empty">No open times this day — try another date.</p>`;
						return;
					}

					slots.forEach((slot) => {
						const btn = document.createElement("button");
						btn.type = "button";
						btn.className = "book-time-btn";
						const label = new Date(slot.start).toLocaleTimeString("en-US", {
							hour: "numeric",
							minute: "2-digit",
						});
						btn.textContent = label;
						btn.addEventListener("click", () => {
							selectedSlot = slot;
							timesEl.querySelectorAll(".book-time-btn").forEach((b) => b.classList.remove("is-selected"));
							btn.classList.add("is-selected");
						});
						timesEl.append(btn);
					});
				}

				formEl?.addEventListener("submit", async (event) => {
					event.preventDefault();
					errorEl.hidden = true;

					if (!selectedSlot) {
						errorEl.textContent = "Pick a date and time above before continuing.";
						errorEl.hidden = false;
						timesEl.scrollIntoView({ behavior: "smooth", block: "center" });
						return;
					}

					submitBtn.disabled = true;
					submitBtn.textContent = "Creating booking…";

					const formData = new FormData(formEl);
					const customer = Object.fromEntries(formData.entries());

					try {
						const response = await fetch("/api/create-checkout-session", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({ selections, customer, slot: selectedSlot }),
						});

						const data = await response.json();

						if (!response.ok || !data.url) {
							throw new Error(data.error || "Something went wrong starting checkout.");
						}

						const when = new Date(selectedSlot.start).toLocaleString("en-US", {
							timeZone: "America/Los_Angeles",
							weekday: "short",
							month: "short",
							day: "numeric",
							hour: "numeric",
							minute: "2-digit",
						});
						linkRecap.textContent = `${customer.name || "This customer"} — ${when}, ${formatMoney(selections.total)}`;
						linkInput.value = data.url;
						openLink.href = data.url;
						lastCustomerName = (customer.name || "").trim();
						linkPanel.hidden = false;
						linkPanel.scrollIntoView({ behavior: "smooth", block: "start" });

						formEl.reset();
						submitBtn.disabled = false;
						submitBtn.textContent = "Create Booking & Get Payment Link";
					} catch (err) {
						errorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
						errorEl.hidden = false;
						submitBtn.disabled = false;
						submitBtn.textContent = "Create Booking & Get Payment Link";
					}
				});

				async function copyText(text) {
					try {
						await navigator.clipboard.writeText(text);
					} catch {
						const scratch = document.createElement("textarea");
						scratch.value = text;
						scratch.style.position = "fixed";
						scratch.style.opacity = "0";
						document.body.appendChild(scratch);
						scratch.select();
						document.execCommand("copy");
						document.body.removeChild(scratch);
					}
				}

				function flashCopied(button) {
					const original = button.textContent;
					button.textContent = "Copied!";
					setTimeout(() => {
						button.textContent = original;
					}, 1500);
				}

				copyBtn?.addEventListener("click", async () => {
					await copyText(linkInput.value);
					flashCopied(copyBtn);
				});

				copyMessageBtn?.addEventListener("click", async () => {
					const greetingName = lastCustomerName || "there";
					const message = `Hi ${greetingName}, here's your secure link to complete your Sky House Cleaning booking: ${linkInput.value}\n\nNothing's charged until you finish this step.`;
					await copyText(message);
					flashCopied(copyMessageBtn);
				});
			}

			initAdminBookPage();
			document.addEventListener("astro:page-load", initAdminBookPage);
		</script>
	</body>
</html>
