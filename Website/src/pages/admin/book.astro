---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Step two
// of the phone-booking flow (step one is /admin/quote.astro, which builds
// the `?s=` quote payload this page expects). This is a close adaptation of
// the public /schedule.astro: same date/time picker and contact form,
// reusing the same /api/availability endpoint unchanged. Slot-picking is
// identical to the public flow; what happens after picking a slot is not —
// see below.
//
// The real difference: /schedule.astro redirects the customer's own browser
// straight to Stripe to pay, with the customer themselves checking the
// policy-agreement box right before that. Here, staff are filling this out
// on someone else's behalf over the phone — a checkbox on this screen would
// only prove the STAFF member clicked it, not that the customer actually
// agreed to anything. So instead of creating a Stripe Checkout Session
// directly, this creates a "pending booking" (src/lib/pendingBookings.js)
// and shows a link to the public /confirm/[id] page — the customer opens
// that themselves, reviews the details, and checks the policy box, and only
// then does /api/confirm/finalize-pending-booking.js actually create the
// Stripe session. Nothing is booked or charged (no calendar event, no card
// charge) until the customer completes THAT payment — same invariant as
// every other booking path, enforced the same way, by stripe-webhook.js only
// acting on a completed payment. See AGENTS.md → "Phone booking confirmation
// link" for the full reasoning.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { WORKING_DAYS, BOOKING_WINDOW_DAYS } from "../../data/booking.js";
---

<AdminLayout title="Book a Customer | Sky House Cleaning Staff Tools">
			<div
				class="container admin-container"
				id="book-page"
				data-working-days={JSON.stringify(WORKING_DAYS)}
				data-window-days={BOOKING_WINDOW_DAYS}
			>
				<div class="book-step" id="book-no-quote" hidden>
					<h3>Let's start with a quote</h3>
					<p>We couldn't find a saved quote for this session. Head back and build the customer's quote first.</p>
					<a href="/admin/quote" class="btn btn--primary">Build a Quote</a>
				</div>

				<div id="book-steps" class="book-layout">
					<div class="book-main">
						<div class="book-step">
							<h3><span class="book-step__num">1</span> Pick the date &amp; time</h3>
							<p class="book-step__hint">Choose a day, then an open time slot.</p>

							<div class="book-dates" id="book-dates"></div>
							<button type="button" class="book-dates-toggle" id="book-calendar-toggle" aria-expanded="false">
								<span id="book-calendar-toggle-label">Show full calendar</span>
								<span class="book-dates-toggle-icon" aria-hidden="true">▾</span>
							</button>
							<div class="book-calendar" id="book-calendar" hidden>
								<div class="book-calendar__header">
									<button type="button" class="book-calendar__nav" id="book-calendar-prev" aria-label="Previous month">‹</button>
									<p class="book-calendar__month" id="book-calendar-month"></p>
									<button type="button" class="book-calendar__nav" id="book-calendar-next" aria-label="Next month">›</button>
								</div>
								<div class="book-calendar__weekdays">
									<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
								</div>
								<div class="book-calendar__grid" id="book-calendar-grid"></div>
							</div>
							<div class="book-times" id="book-times">
								<p class="book-times__placeholder" id="book-times-placeholder">Pick a date above to see open times.</p>
							</div>
						</div>

						<div class="book-step">
							<h3><span class="book-step__num">2</span> Customer details</h3>
							<p class="book-step__hint">Get these from the customer on the call.</p>

							<form id="book-form" class="book-form">
								<div class="book-form__row">
									<label for="book-name">Full Name</label>
									<input type="text" id="book-name" name="name" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-email">Email</label>
									<input type="email" id="book-email" name="email" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-phone">Phone</label>
									<input type="tel" id="book-phone" name="phone" required autocomplete="off" />
								</div>
								<div class="book-form__row">
									<label for="book-address">Home Address</label>
									<input type="text" id="book-address" name="address" required autocomplete="off" />
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-access">How do we get in?</label>
									<input
										type="text"
										id="book-access"
										name="access"
										placeholder="Gate code, lockbox code, garage code, or if someone will be home"
										required
									/>
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-pets">Will pets be home? <span class="book-form__optional">(optional)</span></label>
									<input type="text" id="book-pets" name="pets" placeholder="Kind, and anything we should know" />
								</div>
								<div class="book-form__row book-form__row--full">
									<label for="book-notes">Anything else? <span class="book-form__optional">(optional)</span></label>
									<textarea id="book-notes" name="notes" rows="3" placeholder="Parking, allergies, areas to focus on or skip, anything else"></textarea>
								</div>

								<p class="book-form__error" id="book-form-error" hidden></p>

								<button type="submit" class="btn btn--primary book-form__submit" id="book-submit">
									Create Booking &amp; Get Confirmation Link
								</button>
							</form>
						</div>

						<div class="book-step admin-link-panel" id="book-link-panel" hidden>
							<h3>Booking created, send this to the customer</h3>
							<p class="book-step__hint" id="book-link-recap"></p>

							<div class="admin-link-row">
								<input type="text" id="book-confirm-link" class="admin-link-input" readonly />
								<button type="button" class="btn btn--outline" id="book-copy-link">Copy Link</button>
								<button type="button" class="btn btn--outline" id="book-copy-message">Copy Message</button>
							</div>
							<p class="admin-hint--tight">
								Text or email this link to the customer to review their booking and confirm it. Nothing
								is booked or charged until they check the box and pay on that page, no calendar event
								exists yet. "Copy Message" copies a ready-to-send note with the link already in it, so
								you're not typing one out by hand.
							</p>
							<a href="#" target="_blank" rel="noopener" id="book-open-link" class="btn btn--outline">Open Confirmation Page</a>

							<p class="admin-hint--tight admin-link-panel__next">
								<a href="/admin/quote">Book another customer →</a>
							</p>
						</div>
					</div>

					<aside class="book-summary card" id="book-summary">
						<p class="book-summary__label">Order Summary</p>
						<ul class="book-summary__lines" id="book-summary-lines"></ul>
						<div class="book-summary__total">
							<span>Total</span>
							<span id="book-summary-total">$0</span>
						</div>
						<p class="book-summary__note">This is what the customer will be charged when they pay.</p>
					</aside>
				</div>
			</div>

		<style>
			.admin-container {
				max-width: 1100px;
				margin: 0 auto;
				padding-block: 3rem;
			}

			.book-layout {
				display: grid;
				grid-template-columns: 1.5fr 1fr;
				gap: 2.5rem;
				align-items: start;
			}

			.book-main {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				/* Grid items default to a minimum width equal to their content's
				   natural (unwrapped) width — and the date-picker strip below is
				   ~20 buttons wide with no wrap, so without this, .book-main
				   refuses to shrink to its 1.5fr share and instead forces the
				   whole two-column grid (this + the Order Summary sidebar) wider
				   than the viewport, causing horizontal scroll — same bug fixed on
				   the public /schedule page (see its CSS comment), just never
				   carried over to this admin twin. This lets the grid track
				   shrink normally; .book-dates' own overflow-x: auto then handles
				   the long date strip by scrolling inside its own card. */
				min-width: 0;
			}

			.book-step {
				background: var(--color-white);
				border-radius: var(--radius);
				box-shadow: var(--shadow-soft);
				padding: 2rem;
			}

			.book-step h3 {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 0.5rem;
			}

			.book-step__num {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 28px;
				height: 28px;
				border-radius: 50%;
				background: var(--color-sky);
				color: var(--color-white);
				font-size: 0.9rem;
				flex-shrink: 0;
			}

			.book-step__hint {
				font-size: 0.9rem;
				margin-bottom: 1.25rem;
				color: var(--color-slate);
			}

			.book-dates {
				display: flex;
				align-items: flex-start;
				gap: 1.5rem;
				overflow-x: auto;
				padding-bottom: 0.5rem;
				margin-bottom: 1.25rem;
			}

			/* :global() — these groups (one per month) are JS-created. */
			.book-dates :global(.book-date-group) {
				flex: 0 0 auto;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.book-dates :global(.book-date-group__days) {
				display: flex;
				gap: 0.6rem;
			}

			.book-dates :global(.book-date-month-header) {
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}

			.book-dates :global(.book-date-month) {
				margin: 0;
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				color: var(--color-sky-dark);
				white-space: nowrap;
			}

			/* Scrolls the strip to the adjacent month's group — only present
			   when there is an adjacent month (see the JS below). */
			.book-dates :global(.book-date-month-nav) {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 18px;
				height: 18px;
				border: none;
				background: none;
				padding: 0;
				font-size: 0.85rem;
				line-height: 1;
				color: var(--color-sky-dark);
				cursor: pointer;
			}

			.book-dates :global(.book-date-month-nav:hover) {
				color: var(--color-sky);
			}

			.book-dates-toggle {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				border: none;
				background: none;
				padding: 0;
				margin-bottom: 1.25rem;
				font-family: var(--font-body);
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--color-sky-dark);
				cursor: pointer;
			}

			.book-dates-toggle:hover {
				text-decoration: underline;
			}

			.book-dates-toggle-icon {
				font-size: 0.7rem;
				transition: transform 0.15s ease;
			}

			.book-dates-toggle[aria-expanded="true"] .book-dates-toggle-icon {
				transform: rotate(180deg);
			}

			.book-calendar {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				padding: 1.25rem;
				margin-bottom: 1.25rem;
			}

			.book-calendar[hidden] {
				display: none;
			}

			.book-calendar__header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 0.9rem;
			}

			.book-calendar__month {
				margin: 0;
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 1rem;
				color: var(--color-ink);
			}

			.book-calendar__nav {
				width: 32px;
				height: 32px;
				border-radius: 50%;
				border: 1px solid var(--color-border);
				background: var(--color-white);
				color: var(--color-ink);
				font-size: 1.1rem;
				line-height: 1;
				cursor: pointer;
			}

			.book-calendar__nav:hover {
				border-color: var(--color-sky);
			}

			.book-calendar__nav:disabled {
				opacity: 0.35;
				cursor: not-allowed;
			}

			.book-calendar__weekdays {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				margin-bottom: 0.4rem;
			}

			.book-calendar__weekdays span {
				text-align: center;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				color: var(--color-slate-light);
			}

			.book-calendar__grid {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				gap: 0.35rem;
			}

			/* :global() — grid cells (and padding placeholders) are JS-created. */
			:global(.book-calendar__pad) {
				display: block;
			}

			:global(.book-calendar__day) {
				aspect-ratio: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 8px;
				border: 1px solid var(--color-border);
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-body);
				font-size: 0.9rem;
				cursor: pointer;
			}

			:global(.book-calendar__day:hover:not(:disabled)) {
				border-color: var(--color-sky);
			}

			:global(.book-calendar__day.is-selected) {
				background: var(--color-sky);
				border-color: var(--color-sky);
				color: var(--color-white);
			}

			:global(.book-calendar__day:disabled) {
				opacity: 0.3;
				cursor: not-allowed;
				background: transparent;
				border-color: transparent;
			}

			.book-dates :global(.book-date-btn) {
				flex: 0 0 auto;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.15rem;
				min-width: 64px;
				padding: 0.6rem 0.5rem;
				border-radius: 10px;
				border: 1px solid var(--color-border);
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-body);
				cursor: pointer;
			}

			.book-dates :global(.book-date-btn:hover) {
				border-color: var(--color-sky);
			}

			.book-dates :global(.book-date-btn.is-selected) {
				background: var(--color-sky);
				border-color: var(--color-sky);
				color: var(--color-white);
			}

			.book-dates :global(.book-date-btn__day) {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
				opacity: 0.8;
			}

			.book-dates :global(.book-date-btn__num) {
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 1.1rem;
			}

			.book-times {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
			}

			.book-times :global(.book-times__placeholder),
			.book-times :global(.book-times__empty),
			.book-times :global(.book-times__error) {
				margin: 0;
				font-size: 0.9rem;
				color: var(--color-slate-light);
			}

			.book-times :global(.book-time-btn) {
				padding: 0.55rem 1rem;
				border-radius: 999px;
				border: 1px solid var(--color-border);
				background: var(--color-cream);
				color: var(--color-ink);
				font-family: var(--font-body);
				font-size: 0.9rem;
				cursor: pointer;
			}

			.book-times :global(.book-time-btn:hover) {
				border-color: var(--color-sky);
			}

			.book-times :global(.book-time-btn.is-selected) {
				background: var(--color-sky);
				border-color: var(--color-sky);
				color: var(--color-white);
			}

			.book-form {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem 1.5rem;
			}

			.book-form__row {
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
			}

			.book-form__row--full {
				grid-column: 1 / -1;
			}

			.book-form label {
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.book-form__optional {
				font-weight: 400;
				color: var(--color-slate-light);
			}

			.book-form input,
			.book-form textarea {
				width: 100%;
				font-family: var(--font-body);
				font-size: 0.95rem;
				color: var(--color-ink);
				background: var(--color-cream);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				padding: 0.7rem 0.9rem;
				resize: vertical;
			}

			.book-form input:focus,
			.book-form textarea:focus {
				outline: 2px solid var(--color-sky);
				outline-offset: 1px;
			}

			.book-form__error {
				grid-column: 1 / -1;
				margin: 0;
				font-size: 0.85rem;
				color: #b3261e;
			}

			.book-form__error[hidden] {
				display: none;
			}

			.book-form__submit {
				grid-column: 1 / -1;
				width: 100%;
				margin-top: 0.25rem;
			}

			.book-form__submit[disabled] {
				opacity: 0.6;
				cursor: not-allowed;
			}

			.admin-link-panel {
				border: 2px solid var(--color-sky);
			}

			.admin-link-row {
				display: flex;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}

			.admin-link-input {
				flex: 1;
				font-family: var(--font-body);
				font-size: 0.9rem;
				color: var(--color-ink);
				background: var(--color-cream);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				padding: 0.7rem 0.9rem;
			}

			.admin-hint--tight {
				margin: 0.75rem 0;
				font-size: 0.85rem;
				color: var(--color-slate);
			}

			.admin-link-panel__next {
				margin-top: 1.25rem;
			}

			.book-summary {
				position: sticky;
				top: 1.5rem;
				min-width: 0;
			}

			.book-summary__label {
				margin: 0 0 1rem;
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.8rem;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: var(--color-sky-dark);
			}

			.book-summary__lines {
				list-style: none;
				margin: 0 0 1rem;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
			}

			/* :global() because these <li> elements are created client-side via
			   document.createElement — Astro's scoped-style attribute only
			   attaches to elements present in the markup at build time, so
			   without :global() this rule silently never matches them. */
			.book-summary__lines :global(li) {
				display: flex;
				justify-content: space-between;
				gap: 1rem;
				font-size: 0.9rem;
				color: var(--color-slate);
			}

			.book-summary__total {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
				font-family: var(--font-heading);
				font-weight: 700;
				font-size: 1.4rem;
				color: var(--color-ink);
			}

			.book-summary__note {
				margin: 1rem 0 0;
				font-size: 0.8rem;
				color: var(--color-slate-light);
			}

			@media (max-width: 900px) {
				.book-layout {
					grid-template-columns: 1fr;
				}

				.book-summary {
					position: static;
				}
			}

			@media (max-width: 560px) {
				.book-form {
					grid-template-columns: 1fr;
				}

				.book-step {
					padding: 1.5rem;
				}
			}
		</style>

		<script>
			function initAdminBookPage() {
				const root = document.getElementById("book-page");
				if (!root || root.dataset.bookInit === "true") return;
				root.dataset.bookInit = "true";

				const workingDays = JSON.parse(root.dataset.workingDays || "[1,2,3,4,5,6]");
				const windowDays = Number(root.dataset.windowDays) || 21;

				const noQuoteEl = root.querySelector("#book-no-quote");
				const stepsEl = root.querySelector("#book-steps");
				const summaryLinesEl = root.querySelector("#book-summary-lines");
				const summaryTotalEl = root.querySelector("#book-summary-total");
				const datesEl = root.querySelector("#book-dates");
				const calendarToggleBtn = root.querySelector("#book-calendar-toggle");
				const calendarToggleLabelEl = root.querySelector("#book-calendar-toggle-label");
				const calendarEl = root.querySelector("#book-calendar");
				const calendarMonthEl = root.querySelector("#book-calendar-month");
				const calendarGridEl = root.querySelector("#book-calendar-grid");
				const calendarPrevBtn = root.querySelector("#book-calendar-prev");
				const calendarNextBtn = root.querySelector("#book-calendar-next");
				const timesEl = root.querySelector("#book-times");
				const formEl = root.querySelector("#book-form");
				const submitBtn = root.querySelector("#book-submit");
				const errorEl = root.querySelector("#book-form-error");
				const linkPanel = root.querySelector("#book-link-panel");
				const linkRecap = root.querySelector("#book-link-recap");
				const linkInput = root.querySelector("#book-confirm-link");
				const copyBtn = root.querySelector("#book-copy-link");
				const copyMessageBtn = root.querySelector("#book-copy-message");
				const openLink = root.querySelector("#book-open-link");

				let selectedDate = null; // "YYYY-MM-DD"
				let selectedSlot = null; // { start, end }
				let lastCustomerName = "";

				function formatMoney(n) {
					const value = Number(n) || 0;
					const hasCents = Math.round(value * 100) % 100 !== 0;
					return (
						"$" +
						value.toLocaleString("en-US", {
							minimumFractionDigits: hasCents ? 2 : 0,
							maximumFractionDigits: 2,
						})
					);
				}

				function toDateStr(date) {
					const y = date.getFullYear();
					const m = String(date.getMonth() + 1).padStart(2, "0");
					const d = String(date.getDate()).padStart(2, "0");
					return `${y}-${m}-${d}`;
				}

				function parseSelections() {
					const params = new URLSearchParams(window.location.search);
					const raw = params.get("s");
					if (!raw) return null;
					try {
						return JSON.parse(raw);
					} catch {
						return null;
					}
				}

				const selections = parseSelections();

				if (!selections) {
					if (noQuoteEl) noQuoteEl.hidden = false;
					if (stepsEl) stepsEl.hidden = true;
					const summaryEl = root.querySelector("#book-summary");
					if (summaryEl) summaryEl.hidden = true;
					return;
				}

				// If a CRM deal's "Convert to Booking" button sent us here with a
				// contactId (carried through /admin/quote's ctaHref), prefill the
				// known contact fields so staff aren't retyping them — everything
				// visit-specific (address/access/pets/notes) still gets entered
				// fresh, since that can vary and isn't part of the CRM contact.
				const contactId = new URLSearchParams(window.location.search).get("contactId");
				if (contactId) {
					fetch(`/api/admin/crm/get-client?id=${encodeURIComponent(contactId)}`)
						.then((res) => res.json())
						.then((data) => {
							const client = data.client;
							if (!client) return;
							if (client.name) formEl.querySelector("#book-name").value = client.name;
							if (client.email) formEl.querySelector("#book-email").value = client.email;
							if (client.phone) formEl.querySelector("#book-phone").value = client.phone;
							if (client.address) formEl.querySelector("#book-address").value = client.address;
						})
						.catch(() => {
							// Non-fatal — the form just stays blank, same as any normal
							// phone-in booking staff would fill out by hand.
						});
				}

				// Display-only order summary — the actual charge is always
				// re-derived server-side from `selections`, not from these lines.
				(selections.lines || []).forEach((line) => {
					const li = document.createElement("li");
					const label = document.createElement("span");
					label.textContent = line.label;
					const amount = document.createElement("span");
					amount.textContent = formatMoney(line.amount);
					li.append(label, amount);
					summaryLinesEl.append(li);
				});
				summaryTotalEl.textContent = formatMoney(selections.total);

				const today = new Date();
				today.setHours(0, 0, 0, 0);

				// Last bookable day — used both to cap the quick-pick strip and to
				// know when to disable "next month" in the full calendar below.
				const maxDate = new Date(today);
				maxDate.setDate(maxDate.getDate() + windowDays - 1);

				// Groups the strip by month — each month gets its own label ("August",
				// "September", etc., plain text, no year since the whole window is at
				// most a few weeks out) sitting above its own row of date buttons, so
				// it's never ambiguous which month a given day falls in, even when
				// the window happens to roll from one month into the next.
				let lastMonthKey = null;
				let daysRowEl = null;
				const monthGroups = []; // { el, headerEl } — one per month, in order

				for (let i = 0; i < windowDays; i++) {
					const date = new Date(today);
					date.setDate(date.getDate() + i);
					if (!workingDays.includes(date.getDay())) continue;

					const monthKey = `${date.getFullYear()}-${date.getMonth()}`;
					if (monthKey !== lastMonthKey) {
						lastMonthKey = monthKey;
						const groupEl = document.createElement("div");
						groupEl.className = "book-date-group";

						const headerEl = document.createElement("div");
						headerEl.className = "book-date-month-header";
						const monthLabel = document.createElement("p");
						monthLabel.className = "book-date-month";
						monthLabel.textContent = date.toLocaleDateString("en-US", { month: "long" });
						headerEl.append(monthLabel);

						daysRowEl = document.createElement("div");
						daysRowEl.className = "book-date-group__days";
						groupEl.append(headerEl, daysRowEl);
						datesEl.append(groupEl);
						monthGroups.push({ el: groupEl, headerEl });
					}

					const btn = document.createElement("button");
					btn.type = "button";
					btn.className = "book-date-btn";
					btn.dataset.date = toDateStr(date);
					btn.innerHTML = `
						<span class="book-date-btn__day">${date.toLocaleDateString("en-US", { weekday: "short" })}</span>
						<span class="book-date-btn__num">${date.getDate()}</span>
					`;
					btn.addEventListener("click", () => selectDate(btn.dataset.date));
					daysRowEl.append(btn);
				}

				// Small ‹ › arrows next to each month label that jump the strip to the
				// adjacent month's group (scrolled so that month's first date lands at
				// the left edge) — only added where there actually is a previous/next
				// month, so the first month only gets a right arrow, and the last
				// month only gets a left arrow.
				monthGroups.forEach((group, idx) => {
					if (idx > 0) {
						const prevBtn = document.createElement("button");
						prevBtn.type = "button";
						prevBtn.className = "book-date-month-nav";
						prevBtn.setAttribute("aria-label", "Scroll to previous month");
						prevBtn.textContent = "‹";
						prevBtn.addEventListener("click", () => {
							monthGroups[idx - 1].el.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
						});
						group.headerEl.prepend(prevBtn);
					}
					if (idx < monthGroups.length - 1) {
						const nextBtn = document.createElement("button");
						nextBtn.type = "button";
						nextBtn.className = "book-date-month-nav";
						nextBtn.setAttribute("aria-label", "Scroll to next month");
						nextBtn.textContent = "›";
						nextBtn.addEventListener("click", () => {
							monthGroups[idx + 1].el.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
						});
						group.headerEl.append(nextBtn);
					}
				});

				// Selecting a date can happen from either the quick-pick strip or the
				// full calendar below — keep both in sync by date string rather than
				// tracking which element was clicked.
				function highlightSelectedDate(dateStr) {
					root.querySelectorAll(".book-date-btn, .book-calendar__day").forEach((el) => {
						el.classList.toggle("is-selected", el.dataset.date === dateStr);
					});
				}

				// --- Full calendar (collapsed by default) ---------------------------
				// Lets someone browse by month instead of scrolling the quick-pick
				// strip. Days before today, outside working days, or past the
				// `windowDays` booking window are shown (for context) but disabled —
				// the bookable range itself isn't changed, just how it's browsed.
				let calendarViewYear = today.getFullYear();
				let calendarViewMonth = today.getMonth();
				let calendarBuilt = false;

				function isDateBookable(date) {
					if (date < today || date > maxDate) return false;
					return workingDays.includes(date.getDay());
				}

				function renderCalendar() {
					const monthStart = new Date(calendarViewYear, calendarViewMonth, 1);
					calendarMonthEl.textContent = monthStart.toLocaleDateString("en-US", { month: "long", year: "numeric" });

					calendarGridEl.innerHTML = "";

					const daysInMonth = new Date(calendarViewYear, calendarViewMonth + 1, 0).getDate();
					for (let i = 0; i < monthStart.getDay(); i++) {
						const pad = document.createElement("span");
						pad.className = "book-calendar__pad";
						calendarGridEl.append(pad);
					}

					for (let d = 1; d <= daysInMonth; d++) {
						const date = new Date(calendarViewYear, calendarViewMonth, d);
						const dateStr = toDateStr(date);

						const cell = document.createElement("button");
						cell.type = "button";
						cell.className = "book-calendar__day";
						cell.textContent = String(d);
						cell.dataset.date = dateStr;

						if (!isDateBookable(date)) {
							cell.disabled = true;
						} else {
							cell.addEventListener("click", () => selectDate(dateStr));
						}
						if (selectedDate === dateStr) cell.classList.add("is-selected");
						calendarGridEl.append(cell);
					}

					calendarPrevBtn.disabled = calendarViewYear === today.getFullYear() && calendarViewMonth === today.getMonth();
					calendarNextBtn.disabled = calendarViewYear === maxDate.getFullYear() && calendarViewMonth === maxDate.getMonth();
				}

				calendarPrevBtn.addEventListener("click", () => {
					calendarViewMonth -= 1;
					if (calendarViewMonth < 0) {
						calendarViewMonth = 11;
						calendarViewYear -= 1;
					}
					renderCalendar();
				});

				calendarNextBtn.addEventListener("click", () => {
					calendarViewMonth += 1;
					if (calendarViewMonth > 11) {
						calendarViewMonth = 0;
						calendarViewYear += 1;
					}
					renderCalendar();
				});

				calendarToggleBtn.addEventListener("click", () => {
					const expanding = calendarEl.hidden;
					calendarEl.hidden = !expanding;
					calendarToggleBtn.setAttribute("aria-expanded", String(expanding));
					calendarToggleLabelEl.textContent = expanding ? "Hide full calendar" : "Show full calendar";
					if (expanding && !calendarBuilt) {
						calendarBuilt = true;
						renderCalendar();
					}
				});

				async function selectDate(dateStr) {
					selectedDate = dateStr;
					selectedSlot = null;

					highlightSelectedDate(dateStr);

					timesEl.innerHTML = `<p class="book-times__placeholder">Loading times…</p>`;

					try {
						const response = await fetch(
							`/api/availability?date=${encodeURIComponent(dateStr)}&type=${encodeURIComponent(selections.type || "standard")}`,
						);
						const data = await response.json();

						if (!response.ok) {
							throw new Error(data.error || "Couldn't load availability.");
						}

						renderTimes(data.slots || []);
					} catch (err) {
						const message = err instanceof Error ? err.message : "Couldn't load availability.";
						timesEl.innerHTML = `<p class="book-times__error">${message}</p>`;
					}
				}

				function renderTimes(slots) {
					timesEl.innerHTML = "";

					if (slots.length === 0) {
						timesEl.innerHTML = `<p class="book-times__empty">No open times this day. Try another date.</p>`;
						return;
					}

					slots.forEach((slot) => {
						const btn = document.createElement("button");
						btn.type = "button";
						btn.className = "book-time-btn";
						const label = new Date(slot.start).toLocaleTimeString("en-US", {
							hour: "numeric",
							minute: "2-digit",
						});
						btn.textContent = label;
						btn.addEventListener("click", () => {
							selectedSlot = slot;
							timesEl.querySelectorAll(".book-time-btn").forEach((b) => b.classList.remove("is-selected"));
							btn.classList.add("is-selected");
						});
						timesEl.append(btn);
					});
				}

				formEl?.addEventListener("submit", async (event) => {
					event.preventDefault();
					errorEl.hidden = true;

					if (!selectedSlot) {
						errorEl.textContent = "Pick a date and time above before continuing.";
						errorEl.hidden = false;
						timesEl.scrollIntoView({ behavior: "smooth", block: "center" });
						return;
					}

					submitBtn.disabled = true;
					submitBtn.textContent = "Creating booking…";

					const formData = new FormData(formEl);
					const customer = Object.fromEntries(formData.entries());

					try {
						const response = await fetch("/api/admin/create-pending-booking", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({ selections, customer, slot: selectedSlot }),
						});

						const data = await response.json();

						if (!response.ok || !data.confirmUrl) {
							throw new Error(data.error || "Something went wrong creating this booking.");
						}

						const when = new Date(selectedSlot.start).toLocaleString("en-US", {
							timeZone: "America/Los_Angeles",
							weekday: "short",
							month: "short",
							day: "numeric",
							hour: "numeric",
							minute: "2-digit",
						});
						linkRecap.textContent = `${customer.name || "This customer"}: ${when}, ${formatMoney(selections.total)}`;
						linkInput.value = data.confirmUrl;
						openLink.href = data.confirmUrl;
						lastCustomerName = (customer.name || "").trim();
						linkPanel.hidden = false;
						linkPanel.scrollIntoView({ behavior: "smooth", block: "start" });

						formEl.reset();
						submitBtn.disabled = false;
						submitBtn.textContent = "Create Booking & Get Confirmation Link";
					} catch (err) {
						errorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
						errorEl.hidden = false;
						submitBtn.disabled = false;
						submitBtn.textContent = "Create Booking & Get Confirmation Link";
					}
				});

				async function copyText(text) {
					try {
						await navigator.clipboard.writeText(text);
					} catch {
						const scratch = document.createElement("textarea");
						scratch.value = text;
						scratch.style.position = "fixed";
						scratch.style.opacity = "0";
						document.body.appendChild(scratch);
						scratch.select();
						document.execCommand("copy");
						document.body.removeChild(scratch);
					}
				}

				function flashCopied(button) {
					const original = button.textContent;
					button.textContent = "Copied!";
					setTimeout(() => {
						button.textContent = original;
					}, 1500);
				}

				copyBtn?.addEventListener("click", async () => {
					await copyText(linkInput.value);
					flashCopied(copyBtn);
				});

				copyMessageBtn?.addEventListener("click", async () => {
					const greetingName = lastCustomerName || "there";
					const message = `Hi ${greetingName}, here's your secure link to review and confirm your Sky House Cleaning booking: ${linkInput.value}\n\nNothing's charged until you confirm and pay on that page.`;
					await copyText(message);
					flashCopied(copyMessageBtn);
				});
			}

			initAdminBookPage();
			document.addEventListener("astro:page-load", initAdminBookPage);
		</script>
</AdminLayout>
