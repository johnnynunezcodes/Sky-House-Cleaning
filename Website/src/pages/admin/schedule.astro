			   standard trick for that: each cell paints over it with its own
			   background, leaving a uniform 1px line wherever two cells meet,
			   without doubling up borders the way giving every cell its own
			   full border would. Reclaims the space that gap: 0.4rem between
			   every cell was eating into (was the actual ask — more room for
			   what's inside each day, not just visual polish). */
			.admin-month-grid {
				display: grid;
				grid-template-columns: repeat(7, 1fr);
				gap: 1px;
				background: var(--color-border);
				border: 1px solid var(--color-border);
				border-radius: 10px;
				overflow: hidden;
			}

			/* Leading/trailing days from the neighboring months (see
			   renderMonthGrid's comment) — same cell markup and grid lines as
			   a real day, just muted so the eye reads them as "outside this
			   month" the way Jobber's own calendar grays its overflow days,
			   rather than looking like an equally-relevant empty day. */
			.admin-month-day--outside {
				background: var(--color-cream);
			}

			.admin-month-day--outside .admin-month-day__num {
				color: var(--color-slate-light);
				font-weight: 600;
			}

			.admin-month-day {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
				min-height: 90px;
				/* Grid items default to min-width: auto, which resolves to their
				   content's min-content size — a long unbroken visit-chip label
				   (e.g. "Sky House Cleaning: ..., Office & Commercial Cleaning")
				   was stretching that day's grid column past its 1fr share,
				   throwing off every other column's alignment with the SUN-SAT
				   headers above. Same overflow bug fixed elsewhere in this
				   codebase (see AdminLayout.astro's own min-width: 0 comment) —
				   this explicit override is what lets the column actually shrink
				   back to 1fr; .admin-month-chip's own text then wraps onto a
				   second line within that width instead of overflowing. */
				min-width: 0;
				padding: 0.5rem;
				background: var(--color-white);
			}

			.admin-month-day.is-today {
				/* inset, not a regular box-shadow — an outward ring would draw
				   past this cell's own bounds into its neighbors now that
				   there's no gap between cells to draw it into. */
				box-shadow: inset 0 0 0 2px var(--color-sky);
			}

			/* Deliberately NOT tinting the whole cell here (an earlier version
			   set this to the exact same #fdeceb as .admin-month-chip--unassigned
			   below) — a "needs a cleaner" day and its visit card ended up the
			   same color and visually merged into one blob, which is what
			   prompted this pass. The cell stays neutral white/bordered; only
			   the chip itself (with its own border below) carries the color, so
			   it reads as a distinct card sitting inside the cell — closer to
			   how Jobber's own calendar looks. */

			.admin-month-day__header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.3rem;
				border: none;
				background: none;
				padding: 0;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-month-day__num {
				font-family: var(--font-heading);
				font-weight: 700;
				color: var(--color-ink);
				font-size: 0.9rem;
			}

			.admin-month-day__count {
				font-size: 0.65rem;
				font-weight: 600;
				color: var(--color-slate-light);
				background: var(--color-sky-light);
				border-radius: 999px;
				padding: 0.05rem 0.4rem;
				white-space: nowrap;
			}

			.admin-month-day__chips {
				display: flex;
				flex-direction: column;
				gap: 0.2rem;
			}

			/* A small rounded card per visit (avatar + bold time + wrapping
			   summary text) — Jobber-style, replacing an earlier version that
			   truncated everything to one ellipsized line. Text is allowed to
			   wrap onto a second line rather than being cut off; the day cell
			   grows taller to fit instead. Relies on .admin-month-day's own
			   min-width: 0 (see that rule's comment) to keep the grid column
			   itself from stretching to fit a long label. */
			.admin-month-chip {
				display: flex;
				align-items: flex-start;
				gap: 0.35rem;
				width: 100%;
				text-align: left;
				border: 1px solid #cddef2;
				border-radius: 8px;
				background: #eaf1fb;
				color: #1a3a5c;
				padding: 0.3rem 0.45rem;
				font-size: 0.72rem;
				font-family: inherit;
				cursor: pointer;
				box-shadow: 0 1px 2px rgba(28, 43, 69, 0.06);
			}

			.admin-month-chip:hover {
				filter: brightness(0.97);
			}

			.admin-month-chip__avatar {
				flex-shrink: 0;
				width: 18px;
				height: 18px;
				margin-top: 0.05rem;
				border-radius: 50%;
				background: #1a5fb4;
				color: var(--color-white);
				font-size: 0.58rem;
				font-weight: 700;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.admin-month-chip__body {
				min-width: 0;
				line-height: 1.3;
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
			}

			.admin-month-chip--unassigned {
				background: #fdeceb;
				border-color: #f3c6c1;
				color: #7a1a15;
			}

			.admin-month-chip--unassigned .admin-month-chip__avatar {
				background: #b3261e;
			}

			/* --- Day view: hour grid, one column per cleaner --------------------- */

			.admin-daygrid {
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				overflow-x: auto;
				background: var(--color-white);
			}

			.admin-daygrid__empty {
				margin: 1rem 1.25rem 0;
			}

			.admin-daygrid__inner {
				min-width: fit-content;
			}

			.admin-daygrid__headers,
			.admin-daygrid__body {
				display: flex;
			}

			.admin-daygrid__gutter-cell,
			.admin-daygrid__gutter {
				width: 64px;
				flex-shrink: 0;
			}

			.admin-daygrid__headers {
				border-bottom: 1px solid var(--color-border);
				position: sticky;
				top: 0;
				background: var(--color-white);
				z-index: 2;
			}

			.admin-daygrid__col-header {
				flex: 1 0 170px;
				padding: 0.6rem 0.75rem;
				border-left: 1px solid var(--color-border);
				font-family: var(--font-heading);
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.admin-daygrid__col-header--unassigned {
				color: #b3261e;
			}

			.admin-daygrid__gutter {
				position: relative;
			}

			.admin-daygrid__hour-label {
				position: absolute;
				right: 8px;
				top: 4px;
				font-size: 0.7rem;
				color: var(--color-slate-light);
				white-space: nowrap;
			}

			.admin-daygrid__col {
				position: relative;
				flex: 1 0 170px;
				border-left: 1px solid var(--color-border);
			}

			.admin-daygrid__gridline {
				position: absolute;
				left: 0;
				right: 0;
				border-top: 1px solid var(--color-border);
			}

			.admin-daygrid__block {
				position: absolute;
				left: 4px;
				right: 4px;
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
				border-radius: 6px;
				background: #eaf1fb;
				border: 1px solid #1a5fb4;
				color: #1a3a5c;
				text-align: left;
				padding: 0.25rem 0.4rem;
				overflow: hidden;
				cursor: pointer;
				font-family: inherit;
			}

			.admin-daygrid__block:hover {
				filter: brightness(0.97);
			}

			.admin-daygrid__block--unassigned {
				background: #fdeceb;
				border-color: #b3261e;
				color: #7a1a15;
			}

			.admin-daygrid__block-time {
				font-size: 0.68rem;
				font-weight: 700;
			}

			.admin-daygrid__block-title {
				font-size: 0.75rem;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			/* --- Shared modal shell ------------------------------------------------ */

			.admin-modal-backdrop {
				position: fixed;
				inset: 0;
				z-index: 80;
				background: rgba(28, 43, 69, 0.45);
				display: flex;
				align-items: flex-start;
				justify-content: center;
				padding: 4rem 1.5rem;
				overflow-y: auto;
			}

			.admin-modal-backdrop[hidden] {
				display: none;
			}

			/* The Tier-1 Visit Popup is positioned next to whatever chip/block
			   was clicked (see positionPopupNear() in the script) rather than
			   flex-centered like Edit Visit/Details below — so its backdrop
			   stays a transparent full-viewport click-catcher (for the existing
			   click-outside-to-close listener) instead of dimming the page,
			   matching Jobber's own lightweight "quick glance" popup rather
			   than a heavier modal treatment. */
			#popup-backdrop {
				background: transparent;
			}

			.admin-modal {
				width: 100%;
				max-width: 480px;
				padding: 1.5rem;
			}

			.admin-modal__header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--color-border);
			}

			.admin-modal__header h3 {
				margin: 0 0 0.3rem;
			}

			.admin-modal__close {
				flex-shrink: 0;
				width: 32px;
				height: 32px;
				border-radius: 50%;
				border: 1px solid var(--color-border);
				background: var(--color-white);
				color: var(--color-slate);
				cursor: pointer;
				font-size: 0.9rem;
			}

			.admin-modal__close:hover {
				border-color: var(--color-sky);
				color: var(--color-sky-dark);
			}

			.admin-modal__body {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.admin-confirm-label {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
				cursor: pointer;
			}

			.admin-confirm-label input {
				width: auto;
			}

			/* --- Visit Popup (tier 1) ---------------------------------------------- */

			.admin-visit-popup__completed {
				margin-bottom: 0.75rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--color-border);
			}

			.admin-visit-popup__row {
				display: flex;
				gap: 0.75rem;
				font-size: 0.9rem;
				padding: 0.3rem 0;
			}

			.admin-visit-popup__label {
				flex: 0 0 90px;
				font-weight: 600;
				color: var(--color-slate);
			}

			.admin-visit-popup__actions {
				display: flex;
				gap: 0.5rem;
				margin-top: 1rem;
			}

			.admin-visit-popup__actions--top {
				margin-top: 0;
				margin-bottom: 1.25rem;
			}

			/* --- Edit Visit (tier 2a) ----------------------------------------------- */

			.admin-edit-title {
				margin: 0;
				font-weight: 600;
				color: var(--color-ink);
			}

			.admin-edit-jobdetails {
				background: var(--color-sky-light);
				border-radius: 8px;
				padding: 0.75rem 1rem;
			}

			.admin-edit-jobdetails__title {
				margin: 0 0 0.5rem;
				font-weight: 600;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.admin-edit-jobdetails__grid {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 0.25rem 0.75rem;
				font-size: 0.88rem;
			}

			.admin-edit-jobdetails__grid span:nth-child(odd) {
				color: var(--color-slate);
				font-weight: 600;
			}

			.admin-edit-section-title {
				margin: 0.25rem 0 0;
				font-weight: 700;
				font-size: 0.85rem;
				color: var(--color-ink);
			}

			.admin-edit-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-top: 1.25rem;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
			}

			.admin-edit-footer__right {
				display: flex;
				gap: 0.5rem;
			}

			.admin-btn--danger {
				color: #b3261e;
				border-color: #f3c8c5;
			}

			.admin-btn--danger:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}

			/* --- Visit Details (tier 2b) --------------------------------------------- */

			.admin-tabs {
				display: flex;
				gap: 1.25rem;
				border-bottom: 1px solid var(--color-border);
				margin-bottom: 1rem;
			}

			.admin-tab {
				padding: 0.5rem 0;
				border: none;
				background: none;
				font-family: inherit;
				font-weight: 600;
				font-size: 0.88rem;
				color: var(--color-slate);
				cursor: pointer;
				border-bottom: 2px solid transparent;
			}

			.admin-tab.is-active {
				color: var(--color-ink);
				border-bottom-color: var(--color-sky-dark);
			}

			.admin-tab-panel {
				margin-bottom: 1rem;
			}

			.admin-tab-panel textarea {
				width: 100%;
				padding: 0.6rem 0.75rem;
				border: 1px solid var(--color-border);
				border-radius: 8px;
				font-size: 0.9rem;
				font-family: inherit;
				resize: vertical;
			}

			@media (max-width: 900px) {
				.admin-week-board {
					grid-template-columns: repeat(7, minmax(150px, 1fr));
				}
			}
		</style>
</AdminLayout>
