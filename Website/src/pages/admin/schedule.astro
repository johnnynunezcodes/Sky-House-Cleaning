				editStartTime.disabled = isRecurring;
				editEndTime.disabled = isRecurring;
				editDate.value = job.visitDate || "";
				editStartTime.value = toTimeInputValue(job.start);
				editEndTime.value = toTimeInputValue(job.end);

				const assignedIds = job.assignedCleanerIds || [];
				editAssign.innerHTML = cleanerOptions(assignedIds);
