			// --- Day view: hour-ruler grid, one column per cleaner -----------------

			function hourLabel(h) {
				const hour24 = ((h % 24) + 24) % 24;
				const period = hour24 < 12 ? "AM" : "PM";
				let hour12 = hour24 % 12;
				if (hour12 === 0) hour12 = 12;
				return `${hour12} ${period}`;
			}

			function dayBlock(job, gridStartHour) {
				const startMin = minutesSinceMidnightPT(job.start);
				const endMin = Math.max(minutesSinceMidnightPT(job.end), startMin + 20);
				const top = (startMin - gridStartHour * 60) * (HOUR_HEIGHT / 60);
				const height = Math.max((endMin - startMin) * (HOUR_HEIGHT / 60), 24);

				const assignedIds = job.assignedCleanerIds || [];
				const block = document.createElement("button");
				block.type = "button";
				block.className = "admin-daygrid__block" + (assignedIds.length === 0 ? " admin-daygrid__block--unassigned" : "");
				block.style.top = `${top}px`;
				block.style.height = `${height}px`;
				block.innerHTML = `
					<span class="admin-daygrid__block-time">${fmtTime(job.start)}</span>
					<span class="admin-daygrid__block-title">${escapeHtml(job.summary)}</span>
					${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
				`;
				block.addEventListener("click", () => openPopup(job, block));
				return block;
			}

			function buildDayGrid(jobs) {
				dayGrid.innerHTML = "";

				let startHour = WORKING_HOURS_START;
				let endHour = WORKING_HOURS_END;
				jobs.forEach((job) => {
					const s = minutesSinceMidnightPT(job.start) / 60;
					const e = minutesSinceMidnightPT(job.end) / 60;
					startHour = Math.min(startHour, Math.floor(s));
					endHour = Math.max(endHour, Math.ceil(e));
				});
				const totalHours = Math.max(1, endHour - startHour);
				const gridHeight = totalHours * HOUR_HEIGHT;

				const dayCleaners = cleaners.filter(
					(c) => c.active || jobs.some((j) => (j.assignedCleanerIds || []).includes(c.id)),
				);
				const columns = [{ id: "", name: "Unassigned" }, ...dayCleaners.map((c) => ({ id: c.id, name: c.name }))];

				const inner = document.createElement("div");
				inner.className = "admin-daygrid__inner";

				const header = document.createElement("div");
				header.className = "admin-daygrid__headers";
				header.innerHTML =
					`<div class="admin-daygrid__gutter-cell"></div>` +
					columns
						.map(
							(col) => `
						<div class="admin-daygrid__col-header${col.id ? "" : " admin-daygrid__col-header--unassigned"}">
							${escapeHtml(col.name)}
						</div>
					`,
						)
						.join("");
				inner.appendChild(header);

				const body = document.createElement("div");
				body.className = "admin-daygrid__body";
				body.style.height = `${gridHeight}px`;

				const gutter = document.createElement("div");
				gutter.className = "admin-daygrid__gutter";
				for (let h = startHour; h <= endHour; h++) {
					const label = document.createElement("div");
					label.className = "admin-daygrid__hour-label";
					label.style.top = `${(h - startHour) * HOUR_HEIGHT}px`;
					label.textContent = hourLabel(h);
					gutter.appendChild(label);
				}
				body.appendChild(gutter);

				columns.forEach((col) => {
					const colEl = document.createElement("div");
					colEl.className = "admin-daygrid__col";

					for (let h = startHour; h <= endHour; h++) {
						const line = document.createElement("div");
						line.className = "admin-daygrid__gridline";
						line.style.top = `${(h - startHour) * HOUR_HEIGHT}px`;
						colEl.appendChild(line);
					}

					const colJobs = jobs.filter((j) => {
						const ids = j.assignedCleanerIds || [];
						return col.id ? ids.includes(col.id) : ids.length === 0;
					});
					colJobs.forEach((job) => colEl.appendChild(dayBlock(job, startHour)));

					body.appendChild(colEl);
				});

				inner.appendChild(body);

				if (!jobs.length) {
					const empty = document.createElement("p");
					empty.className = "admin-status admin-daygrid__empty";
					empty.textContent = "No visits scheduled this day.";
					dayGrid.appendChild(empty);
				}
				dayGrid.appendChild(inner);
			}

			// --- Week view (7-column board, chips open the popup) ------------------

			function formatWeekRange(weekStart) {
				const start = localDate(weekStart).toLocaleDateString("en-US", { month: "short", day: "numeric" });
				const end = localDate(addDays(weekStart, 6)).toLocaleDateString("en-US", {
					month: "short",
					day: "numeric",
					year: "numeric",
				});
				return `${start} – ${end}`;
			}

			function jobChip(job) {
				const chip = document.createElement("button");
				chip.type = "button";
				const assignedIds = job.assignedCleanerIds || [];
				const isUnassigned = assignedIds.length === 0;
				chip.className = "admin-chip" + (isUnassigned ? " admin-chip--unassigned" : "");
				const names = cleanerNamesFor(assignedIds);
				chip.innerHTML = `
					<span class="admin-chip__time">${fmtTime(job.start)}</span>
					<span class="admin-chip__summary">${escapeHtml(job.summary)}</span>
					<span class="admin-chip__cleaners${names.length ? "" : " admin-chip__cleaners--empty"}">
						${names.length ? escapeHtml(names.join(", ")) : "Needs cleaner"}
					</span>
					<span class="admin-chip__footer">
						<span class="admin-badge admin-badge--${job.status}">${STATUS_LABELS[job.status] || job.status}</span>
						${job.cleanerConfirmed ? `<span class="admin-confirmed-check">✓</span>` : ""}
					</span>
				`;
				chip.addEventListener("click", () => openPopup(job, chip));
				return chip;
			}

			function weekColumn(dateStr, jobs, isToday) {
				const col = document.createElement("div");
				col.className = "admin-week-col" + (isToday ? " is-today" : "");
				const date = localDate(dateStr);
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;

				col.innerHTML = `
					<button type="button" class="admin-week-col__header" data-date="${dateStr}">
						<span class="admin-week-col__day">${date.toLocaleDateString("en-US", { weekday: "short" })}</span>
						<span class="admin-week-col__date">${date.getDate()}</span>
						${unassignedCount ? `<span class="admin-week-col__badge">${unassignedCount}</span>` : ""}
					</button>
					<div class="admin-week-col__jobs"></div>
				`;

				col.querySelector(".admin-week-col__header").addEventListener("click", () => jumpToDay(dateStr));

				const jobsEl = col.querySelector(".admin-week-col__jobs");
				if (!jobs.length) {
					jobsEl.innerHTML = `<p class="admin-week-empty">No visits</p>`;
				} else {
					jobs.forEach((job) => jobsEl.appendChild(jobChip(job)));
				}
				return col;
			}

			function renderWeekBoard(jobs) {
				weekBoard.innerHTML = "";
				const weekStart = startOfWeek(dayPicker.value);
				const byDate = groupByDate(jobs);
				const today = todayLocalIso();
				for (let i = 0; i < 7; i++) {
					const dateStr = addDays(weekStart, i);
					weekBoard.appendChild(weekColumn(dateStr, byDate.get(dateStr) || [], dateStr === today));
				}
			}

			// --- Month view (calendar grid, chips open the popup) ------------------

			function monthCell(dateStr, dayNum, jobs, isToday, isOutside) {
				const unassignedCount = jobs.filter((j) => (j.assignedCleanerIds || []).length === 0).length;
				const cell = document.createElement("div");
				cell.className =
					"admin-month-day" +
					(isToday ? " is-today" : "") +
					(unassignedCount ? " has-unassigned" : "") +
					(isOutside ? " admin-month-day--outside" : "");

				cell.innerHTML = `
					<button type="button" class="admin-month-day__header" data-date="${dateStr}">
						<span class="admin-month-day__num">${dayNum}</span>
						${jobs.length ? `<span class="admin-month-day__count">${jobs.length} visit${jobs.length === 1 ? "" : "s"}</span>` : ""}
					</button>
					<div class="admin-month-day__chips"></div>
				`;

				cell.querySelector(".admin-month-day__header").addEventListener("click", () => jumpToDay(dateStr));

				const chipsEl = cell.querySelector(".admin-month-day__chips");
				jobs.forEach((job) => {
					const assignedIds = job.assignedCleanerIds || [];
					const isUnassigned = assignedIds.length === 0;
					const firstCleanerName = cleanerNamesFor(assignedIds)[0];
					const mini = document.createElement("button");
					mini.type = "button";
					mini.className = "admin-month-chip" + (isUnassigned ? " admin-month-chip--unassigned" : "");
					mini.innerHTML = `
						<span class="admin-month-chip__avatar">${isUnassigned ? "—" : escapeHtml(initials(firstCleanerName))}</span>
						<span class="admin-month-chip__body"><strong>${fmtTime(job.start)}</strong> ${escapeHtml(job.summary)}</span>
					`;
					mini.addEventListener("click", (e) => {
						e.stopPropagation();
						openPopup(job, mini);
					});
					chipsEl.appendChild(mini);
				});

				return cell;
			}

			function renderMonthGrid(jobs) {
				monthGrid.innerHTML = "";
				const monthStart = startOfMonth(dayPicker.value);
				const totalDays = daysInMonthCount(monthStart);
				const byDate = groupByDate(jobs);
				const today = todayLocalIso();
				const firstDow = localDate(monthStart).getDay();

				// Leading days from the previous month and trailing days from the
				// next, shown muted (.admin-month-day--outside) so the grid always
				// fills complete weeks — Jobber-style — instead of ending abruptly
				// mid-row. These get `jobs: []` rather than a real count: the
				// period this view actually fetched (loadCurrentPeriod, above) is
				// just this month's own days, so there's no visit data on hand for
				// a neighboring month without a second network round trip, which
				// isn't worth it for what's meant to be a muted, secondary glance
				// at "what week does the 1st/last fall in." The day number itself
				// is still a real, clickable jumpToDay() link (see monthCell), so
				// staff can jump straight into an adjacent month's Day view from
				// here same as any other cell.
				const prevMonthStart = addMonths(monthStart, -1);
				const prevMonthDays = daysInMonthCount(prevMonthStart);
				for (let i = 0; i < firstDow; i++) {
					const dayNum = prevMonthDays - firstDow + 1 + i;
					const dateStr = `${prevMonthStart.slice(0, 8)}${String(dayNum).padStart(2, "0")}`;
					monthGrid.appendChild(monthCell(dateStr, dayNum, [], false, true));
				}

				for (let d = 1; d <= totalDays; d++) {
					const dateStr = `${monthStart.slice(0, 8)}${String(d).padStart(2, "0")}`;
					monthGrid.appendChild(monthCell(dateStr, d, byDate.get(dateStr) || [], dateStr === today, false));
				}

				const trailingCells = (7 - ((firstDow + totalDays) % 7)) % 7;
				const nextMonthStart = addMonths(monthStart, 1);
				for (let d = 1; d <= trailingCells; d++) {
					const dateStr = `${nextMonthStart.slice(0, 8)}${String(d).padStart(2, "0")}`;
					monthGrid.appendChild(monthCell(dateStr, d, [], false, true));
				}
			}

			// --- View switching / shared date nav / period loading ------------------

			function setViewMode(mode) {
				viewMode = mode;
				viewButtons.forEach((b) => b.classList.toggle("is-active", b.dataset.view === mode));
				dayViewEl.hidden = mode !== "day";
				weekViewEl.hidden = mode !== "week";
				monthViewEl.hidden = mode !== "month";
			}

			function jumpToDay(dateStr) {
				dayPicker.value = dateStr;
				setViewMode("day");
				loadCurrentPeriod();
			}

			viewButtons.forEach((btn) => {
				btn.addEventListener("click", () => {
					if (btn.dataset.view === viewMode) return;
					setViewMode(btn.dataset.view);
					loadCurrentPeriod();
				});
			});

			function updatePeriodLabel() {
				if (viewMode === "day") {
					periodLabel.textContent = localDate(dayPicker.value).toLocaleDateString("en-US", {
						weekday: "long",
						month: "long",
						day: "numeric",
						year: "numeric",
					});
				} else if (viewMode === "week") {
					periodLabel.textContent = formatWeekRange(startOfWeek(dayPicker.value));
				} else {
					periodLabel.textContent = localDate(startOfMonth(dayPicker.value)).toLocaleDateString("en-US", {
						month: "long",
						year: "numeric",
					});
				}
			}

			async function loadCurrentPeriod() {
				loadStatus.hidden = false;
				loadStatus.textContent = "Loading…";
				loadStatus.classList.remove("admin-status--error");
				updatePeriodLabel();

				let date = dayPicker.value;
				let days = 1;
				if (viewMode === "week") {
					date = startOfWeek(dayPicker.value);
					days = 7;
				} else if (viewMode === "month") {
					date = startOfMonth(dayPicker.value);
					days = daysInMonthCount(date);
				}

				try {
					const res = await fetch(`/api/admin/dispatch/list-jobs?date=${date}&days=${days}`);
					const data = await res.json();
					if (!res.ok) {
						loadStatus.textContent = data.error || "Couldn't load the schedule.";
						loadStatus.classList.add("admin-status--error");
						return;
					}
					loadStatus.hidden = true;
					allJobsRaw = data.jobs || [];
					renderCurrentView();
				} catch {
					loadStatus.textContent = "Network error, please try again.";
					loadStatus.classList.add("admin-status--error");
				}
			}

			prevPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, -1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, -7);
				else dayPicker.value = addMonths(dayPicker.value, -1);
				loadCurrentPeriod();
			});
			nextPeriodBtn.addEventListener("click", () => {
				if (viewMode === "day") dayPicker.value = addDays(dayPicker.value, 1);
				else if (viewMode === "week") dayPicker.value = addDays(dayPicker.value, 7);
				else dayPicker.value = addMonths(dayPicker.value, 1);
				loadCurrentPeriod();
			});
			todayBtn.addEventListener("click", () => {
				dayPicker.value = todayLocalIso();
				loadCurrentPeriod();
			});

			dayPicker.value = todayLocalIso();
			// setViewMode() is what un-hides whichever of day-view/week-view/
			// month-view matches viewMode — the three containers all start
			// `hidden` in the markup above, and otherwise only the view-button
			// click handler ever calls it. Without this, the Month grid still
			// gets built and inserted on first load (loadCurrentPeriod ->
			// renderCurrentView -> renderMonthGrid), it's just invisible until
			// a button click (e.g. Week, then back to Month) finally calls
			// setViewMode() for the first time.
			setViewMode(viewMode);
			loadCleaners().then(loadCurrentPeriod);
		</script>

		<style is:global>
