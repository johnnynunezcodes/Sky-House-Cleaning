---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Split out
// of /admin/jobs (see AGENTS.md → "Schedule (split from Jobs)") after the
// business owner shared reference screenshots of Jobber's own separate
// Schedule page — Month/Week/Day calendar, checkbox-multiselect Type/Team/
// Status filters, and a click-a-visit-for-a-small-popup-then-Edit/Details
// pattern, all distinct from Jobber's List-first Jobs page (which is what
// /admin/jobs stayed as). Reads the exact same calendar+Firestore merge
// /admin/jobs does (`/api/admin/dispatch/list-jobs.js`) — nothing about the
// underlying data changed, only which page shows it and how.
//
// Deliberate departures from Jobber's exact screenshots, worth knowing
// about rather than discovering by their absence:
// - No "Find a Time" availability search — the business owner said they
//   don't need it right now.
// - No Text/Email reminder actions — no SMS/email provider is wired into
//   this app (see AGENTS.md → "Invoices" for the same limitation).
// - No "Line items" on a visit — this app has no per-visit itemized
//   pricing breakdown, only a single total computed at booking time.
// - A recurring job's Schedule (date/time) fields are read-only here, with
//   a note pointing to Manage Plans — moving a recurring visit also has to
//   update the Stripe subscription's stored lastVisitStart/lastVisitEnd (or
//   the next auto-renewal computes the wrong following date) and realign
//   billing, which is exactly what /admin/reschedule's dedicated tool
//   already does correctly. Duplicating that logic here risked a silent
//   billing desync for a lower-priority convenience; one-off, quote-based,
//   and assessment visits have no subscription to desync, so those ARE
//   fully editable here.
// - No "Manage cleaners" section on this page — that moved to its own nav
//   tab, /admin/team-organization (see AGENTS.md → "Team Organization
//   (split from Schedule)"), after the business owner asked for it to be
//   separate. This page still loads the same cleaner roster for its Team
//   filter and the Edit Visit form's assignment dropdown.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { WORKING_HOURS } from "../../data/booking.js";
---

<AdminLayout title="Schedule | Sky House Cleaning Staff Tools">
			<div
				class="container admin-container"
				id="schedule-page"
				data-working-hours-start={WORKING_HOURS.start}
				data-working-hours-end={WORKING_HOURS.end}
			>
				<h1>Schedule</h1>

				<div class="admin-schedule-toolbar">
					<div class="admin-schedule-toolbar__nav">
						<button type="button" id="prev-period" class="btn btn--outline">←</button>
						<button type="button" id="today-btn" class="btn btn--outline">Today</button>
						<button type="button" id="next-period" class="btn btn--outline">→</button>
						<input type="date" id="day-picker" class="admin-day-picker-hidden" />
						<span id="period-label" class="admin-period-label"></span>
					</div>

					<div class="admin-schedule-toolbar__filters">
						<div class="admin-filter-popover" id="type-filter-wrap">
							<button type="button" class="admin-filter-btn" id="type-filter-btn">Type | <span id="type-filter-summary">All</span></button>
							<div class="admin-filter-popover__menu" id="type-filter-menu" hidden>
								<label class="admin-filter-popover__option"><input type="checkbox" value="visit" checked /> Visits</label>
								<label class="admin-filter-popover__option"><input type="checkbox" value="assessment" checked /> Assessments</label>
							</div>
						</div>
						<div class="admin-filter-popover" id="team-filter-wrap">
							<button type="button" class="admin-filter-btn" id="team-filter-btn">Team | <span id="team-filter-summary">All</span></button>
							<div class="admin-filter-popover__menu" id="team-filter-menu" hidden></div>
						</div>
						<div class="admin-filter-popover" id="status-filter-wrap">
							<button type="button" class="admin-filter-btn" id="status-filter-btn">Status | <span id="status-filter-summary">All</span></button>
							<div class="admin-filter-popover__menu" id="status-filter-menu" hidden>
								<label class="admin-filter-popover__option"><input type="checkbox" value="unassigned" checked /> Unassigned</label>
								<label class="admin-filter-popover__option"><input type="checkbox" value="assigned" checked /> Assigned</label>
								<label class="admin-filter-popover__option"><input type="checkbox" value="en_route" checked /> En route</label>
								<label class="admin-filter-popover__option"><input type="checkbox" value="in_progress" checked /> In progress</label>
								<label class="admin-filter-popover__option"><input type="checkbox" value="completed" checked /> Completed</label>
							</div>
						</div>
					</div>

					<div class="admin-view-switcher" role="group" aria-label="View">
						<button type="button" class="admin-view-btn is-active" data-view="month">Month</button>
						<button type="button" class="admin-view-btn" data-view="week">Week</button>
						<button type="button" class="admin-view-btn" data-view="day">Day</button>
					</div>
				</div>

				<p id="load-status" class="admin-status">Loading…</p>

				<div id="day-view" class="admin-day-view" hidden>
					<div id="day-grid" class="admin-daygrid"></div>
				</div>

				<div id="week-view" class="admin-week-view" hidden>
					<div id="week-board" class="admin-week-board"></div>
				</div>

				<div id="month-view" class="admin-month-view" hidden>
					<div class="admin-month-weekdays">
						<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
					</div>
					<div id="month-grid" class="admin-month-grid"></div>
				</div>
			</div>

			<!-- Tier 1: small popup shown on click -->
			<div class="admin-modal-backdrop" id="popup-backdrop" hidden>
				<div class="admin-modal card admin-visit-popup" id="visit-popup" role="dialog" aria-modal="true">
					<div class="admin-modal__header">
						<div>
							<h3 id="popup-title"></h3>
							<p class="admin-card__meta" id="popup-subtitle"></p>
						</div>
						<button type="button" class="admin-modal__close" id="popup-close" aria-label="Close">✕</button>
					</div>
					<label class="admin-confirm-label admin-visit-popup__completed">
						<input type="checkbox" id="popup-completed" />
						Completed
					</label>
					<div class="admin-visit-popup__row">
						<span class="admin-visit-popup__label">Details</span>
						<span id="popup-details"></span>
					</div>
					<div class="admin-visit-popup__row">
						<span class="admin-visit-popup__label">Team</span>
						<span id="popup-team"></span>
					</div>
					<div class="admin-visit-popup__row" id="popup-location-row">
						<span class="admin-visit-popup__label">Location</span>
						<span id="popup-location"></span>
					</div>
					<div class="admin-visit-popup__row">
						<span class="admin-visit-popup__label">Start</span>
						<span id="popup-start"></span>
					</div>
					<div class="admin-visit-popup__row">
						<span class="admin-visit-popup__label">End</span>
						<span id="popup-end"></span>
					</div>
					<p class="admin-result-message" id="popup-message" hidden></p>
					<div class="admin-visit-popup__actions">
						<div class="admin-filter-popover" id="popup-more-wrap">
							<button type="button" class="btn btn--outline" id="popup-more-btn">•••</button>
							<div class="admin-filter-popover__menu admin-filter-popover__menu--actions" id="popup-more-menu" hidden>
								<button type="button" class="admin-menu-item" id="popup-hold-btn" hidden>Put client's plan on hold</button>
								<button type="button" class="admin-menu-item" id="popup-archive-btn">Archive visit</button>
							</div>
						</div>
						<button type="button" class="btn btn--outline" id="popup-edit-btn">Edit</button>
						<button type="button" class="btn btn--primary" id="popup-details-btn">Details</button>
					</div>
				</div>
			</div>

			<!-- Tier 2a: Edit Visit -->
			<div class="admin-modal-backdrop" id="edit-backdrop" hidden>
				<div class="admin-modal card" id="edit-modal" role="dialog" aria-modal="true">
					<div class="admin-modal__header">
						<h3>Edit Visit</h3>
						<button type="button" class="admin-modal__close" id="edit-close" aria-label="Close">✕</button>
					</div>
					<div class="admin-modal__body">
						<div class="admin-form__row">
							<label>Title</label>
							<p class="admin-edit-title" id="edit-title-display"></p>
						</div>
						<div class="admin-form__row">
							<label for="edit-instructions">Instructions</label>
							<textarea id="edit-instructions" rows="2" placeholder="Anything the team should know"></textarea>
						</div>

						<div class="admin-edit-jobdetails">
							<p class="admin-edit-jobdetails__title">Job details</p>
							<div class="admin-edit-jobdetails__grid">
								<span>Job #</span><span id="edit-jobnumber"></span>
								<span>Client</span><span id="edit-client"></span>
								<span>Phone</span><span id="edit-phone"></span>
								<span>Address</span><span id="edit-address"></span>
							</div>
						</div>

						<p class="admin-edit-section-title">Schedule</p>
						<p class="admin-hint admin-hint--tight" id="edit-schedule-note" hidden>
							This is a recurring plan's visit — moving it here would fall out of sync with billing.
							Use <a href="/admin/reschedule">Manage Plans</a> to reschedule a recurring plan.
						</p>
						<div class="admin-form__grid">
							<div class="admin-form__row">
								<label for="edit-date">Date</label>
								<input type="date" id="edit-date" />
							</div>
							<div class="admin-form__row">
								<label for="edit-start-time">Start time</label>
								<input type="time" id="edit-start-time" />
							</div>
							<div class="admin-form__row">
								<label for="edit-end-time">End time</label>
								<input type="time" id="edit-end-time" />
							</div>
						</div>

						<p class="admin-edit-section-title">Team</p>
						<div class="admin-form__row">
							<label for="edit-assign">Assign team members</label>
							<select multiple class="admin-assign-select" id="edit-assign"></select>
						</div>
					</div>
					<p class="admin-result-message" id="edit-message" hidden></p>
					<div class="admin-edit-footer">
						<button type="button" class="btn btn--outline admin-btn--danger" id="edit-delete-btn">Delete</button>
						<div class="admin-edit-footer__right">
							<button type="button" class="btn btn--outline" id="edit-cancel-btn">Cancel</button>
							<button type="button" class="btn btn--primary" id="edit-save-btn">Save</button>
						</div>
					</div>
				</div>
			</div>

			<!-- Tier 2b: Visit Details -->
			<div class="admin-modal-backdrop" id="details-backdrop" hidden>
				<div class="admin-modal card" id="details-modal" role="dialog" aria-modal="true">
					<div class="admin-modal__header">
						<div>
							<h3 id="details-title"></h3>
							<p class="admin-card__meta" id="details-time"></p>
						</div>
						<button type="button" class="admin-modal__close" id="details-close" aria-label="Close">✕</button>
					</div>
					<div class="admin-visit-popup__actions admin-visit-popup__actions--top">
						<button type="button" class="btn btn--primary" id="details-complete-btn">Mark Complete</button>
						<div class="admin-filter-popover" id="details-more-wrap">
							<button type="button" class="btn btn--outline" id="details-more-btn">••• More Actions</button>
							<div class="admin-filter-popover__menu admin-filter-popover__menu--actions" id="details-more-menu" hidden>
								<button type="button" class="admin-menu-item" id="details-edit-btn">Edit</button>
								<button type="button" class="admin-menu-item" id="details-hold-btn" hidden>Put client's plan on hold</button>
								<button type="button" class="admin-menu-item" id="details-archive-btn">Archive visit</button>
							</div>
						</div>
					</div>

					<div class="admin-tabs">
						<button type="button" class="admin-tab is-active" data-tab="info">Info</button>
						<button type="button" class="admin-tab" data-tab="client">Client</button>
						<button type="button" class="admin-tab" data-tab="notes">Notes</button>
					</div>

					<div class="admin-tab-panel" id="tab-info">
						<p class="admin-edit-section-title">Instructions</p>
						<p id="details-instructions" class="admin-card__meta">No additional instructions</p>
						<p class="admin-edit-section-title">Job</p>
						<p><a href="/admin/jobs" id="details-job-link"></a></p>
						<p class="admin-edit-section-title">Team</p>
						<p id="details-team" class="admin-card__meta"></p>
					</div>

					<div class="admin-tab-panel" id="tab-client" hidden>
						<div id="details-client-body">Loading…</div>
					</div>

					<div class="admin-tab-panel" id="tab-notes" hidden>
						<textarea id="details-notes" rows="4" placeholder="Anything the team should know"></textarea>
					</div>

					<p class="admin-result-message" id="details-message" hidden></p>
				</div>
			</div>

		<script>
			const root = document.getElementById("schedule-page");
			const WORKING_HOURS_START = Number(root?.dataset.workingHoursStart) || 8;
			const WORKING_HOURS_END = Number(root?.dataset.workingHoursEnd) || 18;

			const dayPicker = document.getElementById("day-picker");
			const prevPeriodBtn = document.getElementById("prev-period");
			const nextPeriodBtn = document.getElementById("next-period");
			const todayBtn = document.getElementById("today-btn");
			const periodLabel = document.getElementById("period-label");
			const loadStatus = document.getElementById("load-status");
			const viewButtons = Array.from(document.querySelectorAll(".admin-view-btn"));
			const dayViewEl = document.getElementById("day-view");
			const weekViewEl = document.getElementById("week-view");
			const monthViewEl = document.getElementById("month-view");
			const dayGrid = document.getElementById("day-grid");
			const weekBoard = document.getElementById("week-board");
			const monthGrid = document.getElementById("month-grid");

			const STATUS_LABELS = {
				unassigned: "Unassigned",
				assigned: "Assigned",
				en_route: "En route",
				in_progress: "In progress",
				completed: "Completed",
			};
			const HOUR_HEIGHT = 56; // px per hour row in the Day view grid

			let cleaners = [];
			let allJobsRaw = []; // unfiltered jobs for the currently-loaded period
			let viewMode = "month"; // "day" | "week" | "month" — List lives on /admin/jobs now

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function todayLocalIso() {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			}

			function fmtTime(iso) {
				return new Date(iso).toLocaleTimeString("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "numeric",
					minute: "2-digit",
				});
			}

			function fmtDateTime(iso) {
				return new Date(iso).toLocaleDateString("en-US", {
					timeZone: "America/Los_Angeles",
					weekday: "short",
					month: "short",
					day: "numeric",
				});
			}

			function minutesSinceMidnightPT(iso) {
				const parts = new Intl.DateTimeFormat("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				}).formatToParts(new Date(iso));
				const hour = Number(parts.find((p) => p.type === "hour")?.value || "0") % 24;
				const minute = Number(parts.find((p) => p.type === "minute")?.value || "0");
				return hour * 60 + minute;
			}

			function addDays(dateStr, delta) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() + delta);
				return date.toISOString().slice(0, 10);
			}

			function startOfWeek(dateStr) {
				const [y, m, d] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1, d));
				date.setUTCDate(date.getUTCDate() - date.getUTCDay());
				return date.toISOString().slice(0, 10);
			}

			function startOfMonth(dateStr) {
				return `${dateStr.slice(0, 7)}-01`;
			}

			function daysInMonthCount(dateStr) {
				const [y, m] = dateStr.split("-").map(Number);
				return new Date(Date.UTC(y, m, 0)).getUTCDate();
			}

			function addMonths(dateStr, delta) {
				const [y, m] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1 + delta, 1));
				return date.toISOString().slice(0, 10);
			}

			function localDate(dateStr) {
				return new Date(dateStr + "T00:00:00");
			}

			function groupByDate(jobs) {
				const map = new Map();
				for (const j of jobs) {
					if (!map.has(j.visitDate)) map.set(j.visitDate, []);
					map.get(j.visitDate).push(j);
				}
				for (const arr of map.values()) arr.sort((a, b) => new Date(a.start) - new Date(b.start));
				return map;
			}

			function cleanerNamesFor(ids) {
				return (ids || []).map((id) => cleaners.find((c) => c.id === id)?.name).filter(Boolean);
			}

			// Up to 2 letters ("John Torres" -> "JT", "Maria" -> "M") for the
			// small round avatar on Month view visit cards, Jobber-style.
			function initials(name) {
				return (name || "")
					.split(/\s+/)
					.filter(Boolean)
					.slice(0, 2)
					.map((part) => part[0].toUpperCase())
					.join("");
			}

			function parseSummary(summary) {
				const m = (summary || "").match(/^Sky House Cleaning: (.+?), (.+)$/);
				return m ? { client: m[1], service: m[2] } : { client: summary || "—", service: "" };
			}

			function clientNameFor(job) {
				return job.clientName || parseSummary(job.summary).client;
			}

			function serviceNameFor(job) {
				return parseSummary(job.summary).service;
			}

			// Adding/deactivating cleaners moved to its own page — /admin/team-
			// organization (see AGENTS.md → "Team Organization (split from
			// Schedule)") — but this page still needs the roster itself, for
			// the Team filter popover and the Edit Visit form's assignment
			// dropdown, so it still fetches the same list-cleaners endpoint.
			async function loadCleaners() {
				try {
					const res = await fetch("/api/admin/dispatch/list-cleaners");
					const data = await res.json();
					if (res.ok) cleaners = data.cleaners || [];
					renderTeamFilterOptions();
				} catch {
					// Non-fatal — assignment dropdowns/names just come up empty.
				}
			}

			function cleanerOptions(selectedIds) {
				return cleaners
					.filter((c) => c.active || selectedIds.includes(c.id))
					.map((c) => `<option value="${c.id}" ${selectedIds.includes(c.id) ? "selected" : ""}>${escapeHtml(c.name)}</option>`)
					.join("");
			}

			// --- Type/Team/Status checkbox-multiselect filter popovers --------------
			// Jobber-style: a button showing "Label | N selected" (or the single
			// selected label, or "All" when everything's checked) that opens a
			// checklist. All three default to fully-checked (no filtering) — same
			// "nothing selected shouldn't mean nothing shown" reasoning as leaving
			// every box ticked in Jobber's own screenshots.
			function setupFilterPopover(btnId, menuId, wrapId, summaryId, labels, onChange) {
				const btn = document.getElementById(btnId);
				const menu = document.getElementById(menuId);
				const wrap = document.getElementById(wrapId);
				const summary = document.getElementById(summaryId);

				function updateSummary() {
					const boxes = Array.from(menu.querySelectorAll('input[type="checkbox"]'));
					const checked = boxes.filter((b) => b.checked);
					if (checked.length === boxes.length) summary.textContent = "All";
					else if (checked.length === 0) summary.textContent = "None";
					else if (checked.length === 1) summary.textContent = labels[checked[0].value] || checked[0].value;
					else summary.textContent = `${checked.length} selected`;
				}

				btn.addEventListener("click", (e) => {
					e.stopPropagation();
					const isOpen = !menu.hidden;
					document.querySelectorAll(".admin-filter-popover__menu").forEach((m) => (m.hidden = true));
					menu.hidden = isOpen;
				});
				menu.addEventListener("change", () => {
					updateSummary();
					onChange();
				});
				wrap.addEventListener("click", (e) => e.stopPropagation());

				updateSummary();
				return { menu, updateSummary };
			}

			function selectedValues(menuId) {
				return Array.from(document.querySelectorAll(`#${menuId} input[type="checkbox"]:checked`)).map((b) => b.value);
			}

			function renderTeamFilterOptions() {
				const menu = document.getElementById("team-filter-menu");
				menu.innerHTML =
					`<label class="admin-filter-popover__option"><input type="checkbox" value="__unassigned__" checked /> Unassigned</label>` +
					cleaners
						.filter((c) => c.active)
						.map((c) => `<label class="admin-filter-popover__option"><input type="checkbox" value="${c.id}" checked /> ${escapeHtml(c.name)}</label>`)
						.join("");
				teamFilterPopover.updateSummary();
			}

			document.addEventListener("click", () => {
				document.querySelectorAll(".admin-filter-popover__menu").forEach((m) => (m.hidden = true));
			});

			const TYPE_LABELS = { visit: "Visits", assessment: "Assessments" };
			const typeFilterPopover = setupFilterPopover(
				"type-filter-btn",
				"type-filter-menu",
				"type-filter-wrap",
				"type-filter-summary",
				TYPE_LABELS,
				() => renderCurrentView(),
			);
			const teamFilterPopover = setupFilterPopover(
				"team-filter-btn",
				"team-filter-menu",
				"team-filter-wrap",
				"team-filter-summary",
				{},
				() => renderCurrentView(),
			);
			const statusFilterPopover = setupFilterPopover(
				"status-filter-btn",
				"status-filter-menu",
				"status-filter-wrap",
				"status-filter-summary",
				STATUS_LABELS,
				() => renderCurrentView(),
			);

			function applyFilters(jobs) {
				const types = selectedValues("type-filter-menu");
				const teams = selectedValues("team-filter-menu");
				const statuses = selectedValues("status-filter-menu");
				return jobs.filter((job) => {
					const jobTypeCategory = job.jobType === "assessment" ? "assessment" : "visit";
					if (!types.includes(jobTypeCategory)) return false;
					if (!statuses.includes(job.status)) return false;
					const ids = job.assignedCleanerIds || [];
					const matchesTeam = ids.length
						? ids.some((id) => teams.includes(id))
						: teams.includes("__unassigned__");
					if (!matchesTeam) return false;
					return true;
				});
			}

			// Re-applies the current filter selection to the already-fetched
			// period's jobs without a network round trip — filters are purely
			// client-side, same as every other filter in this app.
			function renderCurrentView() {
				const filtered = applyFilters(allJobsRaw);
				if (viewMode === "day") buildDayGrid(filtered);
				else if (viewMode === "week") renderWeekBoard(filtered);
				else renderMonthGrid(filtered);
			}

			// --- Tier 1: Visit Popup -------------------------------------------------

			const popupBackdrop = document.getElementById("popup-backdrop");
			const visitPopup = document.getElementById("visit-popup");
			const popupTitle = document.getElementById("popup-title");
