				popupLocation.textContent = job.location || "";
				popupStart.textContent = `${fmtDateTime(job.start)}, ${fmtTime(job.start)}`;
				popupEnd.textContent = `${fmtDateTime(job.end)}, ${fmtTime(job.end)}`;
				popupHoldBtn.hidden = job.jobType !== "recurring";
				popupArchiveBtn.textContent = job.archived ? "Unarchive visit" : "Archive visit";
				popupMoreMenu.hidden = true;
				popupBackdrop.hidden = false;
				positionPopupNear(anchorEl);
			}

			// Jobber's own popup opens right next to whatever you clicked, not
			// centered on screen — this measures the clicked chip/block's real
			// position (only available once the popup is un-hidden and has a
			// rendered size to measure) and places the card beside it instead,
			// flipping to the left/clamping to the viewport edges so it never
			// runs off-screen. #popup-backdrop stays a full-viewport transparent
			// click-catcher (for the existing click-outside-to-close listener)
			// but no longer dims the page or flex-centers its child — see that
			// selector's own CSS comment.
			function positionPopupNear(anchorEl) {
				if (!anchorEl) {
					visitPopup.style.position = "";
					visitPopup.style.top = "";
					visitPopup.style.left = "";
					visitPopup.style.margin = "";
					return;
				}
				const anchorRect = anchorEl.getBoundingClientRect();
				const popupRect = visitPopup.getBoundingClientRect();
				const gap = 10;
				const viewportW = window.innerWidth;
				const viewportH = window.innerHeight;

				let left = anchorRect.right + gap;
				if (left + popupRect.width > viewportW - gap) {
					left = anchorRect.left - popupRect.width - gap;
				}
				if (left < gap) {
					left = Math.max(gap, Math.min(anchorRect.left, viewportW - popupRect.width - gap));
				}

				let top = anchorRect.top;
				if (top + popupRect.height > viewportH - gap) {
					top = viewportH - popupRect.height - gap;
				}
				if (top < gap) top = gap;

				visitPopup.style.position = "fixed";
				visitPopup.style.margin = "0";
				visitPopup.style.left = `${left}px`;
				visitPopup.style.top = `${top}px`;
			}

			function closePopup() {
				popupBackdrop.hidden = true;
				currentJob = null;
			}

			popupClose.addEventListener("click", closePopup);
			popupBackdrop.addEventListener("click", (e) => {
				if (e.target === popupBackdrop) closePopup();
			});

			popupMoreBtn.addEventListener("click", (e) => {
				e.stopPropagation();
				popupMoreMenu.hidden = !popupMoreMenu.hidden;
			});

			async function saveJobFields(job, extraFields) {
				const res = await fetch("/api/admin/dispatch/update-job", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ jobKey: job.jobKey, eventId: job.eventId, visitDate: job.visitDate, ...extraFields }),
				});
				const data = await res.json();
				if (!res.ok) throw new Error(data.error || "Something went wrong.");
				return data;
			}

			popupCompleted.addEventListener("change", async () => {
				if (!currentJob) return;
				const nextStatus = popupCompleted.checked
					? "completed"
					: (currentJob.assignedCleanerIds || []).length
						? "assigned"
						: "unassigned";
				popupCompleted.disabled = true;
				try {
					await saveJobFields(currentJob, { status: nextStatus });
					currentJob.status = nextStatus;
					await loadCurrentPeriod();
				} catch (err) {
					popupMessage.hidden = false;
					popupMessage.textContent = err.message;
					popupMessage.classList.add("admin-result-message--error");
					popupCompleted.checked = !popupCompleted.checked;
				} finally {
					popupCompleted.disabled = false;
