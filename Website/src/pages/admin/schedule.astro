			// Contact records (the `clients` CRM collection) aren't automatically
			// created for every booking — only ones that passed through a Request
			// at some point. A booking with no matching contact isn't an error,
			// it just falls back to whatever the calendar event itself has.
			async function loadClientTab() {
				if (!currentJob) return;
				detailsClientBody.innerHTML = "Loading…";
				try {
					if (!allClientsCache) {
						const res = await fetch("/api/admin/crm/list-clients");
						const data = await res.json();
						allClientsCache = res.ok ? data.clients || [] : [];
