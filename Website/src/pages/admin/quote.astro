---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. First step
// of the phone-booking flow: build the customer's quote using the exact same
// pricing configurator the public Pricing page uses, so staff and customers
// always see identical numbers. "Continue" hands off to /admin/book (step
// two: pick a date/time and enter the customer's details), instead of the
// public /schedule page.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import PricingConfigurator from "../../components/PricingConfigurator.astro";

// If a CRM deal's "Convert to Booking" button sent us here with a
// contactId, thread it through to /admin/book so that page can prefill the
// customer-details step from the contact record instead of a blank form.
// PricingConfigurator appends its own `?s=<quote payload>` to whatever
// ctaHref it's given (see its script's `separator`/`href` logic), so this
// just needs to already contain `?contactId=...` for that to layer on top
// correctly as `&s=...`.
const contactId = Astro.url.searchParams.get("contactId");
const bookHref = contactId ? `/admin/book?contactId=${encodeURIComponent(contactId)}` : "/admin/book";
---

<AdminLayout title="Build a Quote | Sky House Cleaning Staff Tools">
	<div class="container admin-container">
		<h1>Book a Customer Who Called In</h1>
		<p class="admin-hint">
			Build their quote below the same way the website does, then continue to pick a date/time
			and enter their details. At the end you'll get a secure payment link to text or email them.
			Nothing is booked or charged until they pay it.
		</p>

		<PricingConfigurator ctaHref={bookHref} ctaLabel="Continue to date & customer details" />
	</div>

	<style>
		.admin-container {
			max-width: 900px;
			margin: 0 auto;
			padding-block: 3rem;
		}

		.admin-hint {
			color: var(--color-slate);
			margin-bottom: 2rem;
			max-width: 640px;
		}
	</style>
</AdminLayout>
