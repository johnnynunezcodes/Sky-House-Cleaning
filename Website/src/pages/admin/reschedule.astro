---
// Staff-only tool — gated by HTTP Basic Auth in src/middleware.js. Uses
// AdminLayout.astro (the staff-tools sidebar shell), not the public site's
// Layout.astro — no Navbar/Footer/SEO tags, this should never be indexed
// or shared.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Reschedule Recurring Cleaning | Sky House Cleaning Staff Tools">
			<div class="container admin-container">
				<h1>Reschedule a Recurring Plan</h1>
				<p class="admin-hint">
					Use this to permanently move a customer's recurring cleaning to a new day/time. Every
					future visit shifts too. For a <strong>one-time</strong> reschedule that should revert back
					afterward, just edit that one event directly in Google Calendar instead; don't use this tool.
				</p>

				<div class="card admin-browse-card">
					<p id="browse-status" class="admin-status" hidden>Loading customers…</p>

					<div class="admin-browse-select">
						<label for="customer-select">Select a customer</label>
						<select id="customer-select">
							<option value="">Select a customer…</option>
						</select>
					</div>

					<div class="admin-browse-calendar">
						<div class="admin-calendar-nav">
							<button type="button" id="cal-prev" class="btn btn--outline" aria-label="Previous month">←</button>
							<span id="cal-label" class="admin-calendar-label"></span>
							<button type="button" id="cal-next" class="btn btn--outline" aria-label="Next month">→</button>
						</div>
						<p class="admin-hint admin-hint--tight">Each chip is a customer's next scheduled visit — click one to pull up their plan.</p>
						<div class="admin-calendar-weekdays">
							<span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
						</div>
						<div class="admin-calendar-grid" id="cal-grid"></div>
					</div>
				</div>

				<p class="admin-divider">or search by email</p>

				<form id="search-form" class="book-form admin-search">
					<div class="book-form__row book-form__row--full">
						<label for="search-email">Customer email</label>
						<input type="email" id="search-email" required autocomplete="off" />
					</div>
					<button type="submit" class="btn btn--primary">Search</button>
				</form>

				<p id="search-status" class="admin-status" hidden></p>

				<div id="results"></div>
			</div>

		<script>
			const searchForm = document.getElementById("search-form");
			const searchStatus = document.getElementById("search-status");
			const resultsEl = document.getElementById("results");

			const customerSelect = document.getElementById("customer-select");
			const browseStatus = document.getElementById("browse-status");
			const calGrid = document.getElementById("cal-grid");
			const calLabel = document.getElementById("cal-label");
			const calPrevBtn = document.getElementById("cal-prev");
			const calNextBtn = document.getElementById("cal-next");

			const FREQUENCY_LABELS = { weekly: "Weekly", biweekly: "Bi-Weekly", monthly: "Monthly" };

			function escapeHtml(str) {
				const div = document.createElement("div");
				div.textContent = str ?? "";
				return div.innerHTML;
			}

			function fmt(iso) {
				if (!iso) return "N/A";
				return new Date(iso).toLocaleString("en-US", {
					timeZone: "America/Los_Angeles",
					weekday: "short",
					month: "short",
					day: "numeric",
					hour: "numeric",
					minute: "2-digit",
				});
			}

			function toDateInputValue(iso) {
				if (!iso) return "";
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date(iso));
			}

			function toTimeInputValue(iso) {
				if (!iso) return "";
				const parts = new Intl.DateTimeFormat("en-US", {
					timeZone: "America/Los_Angeles",
					hour: "2-digit",
					minute: "2-digit",
					hour12: false,
				}).formatToParts(new Date(iso));
				const rawHour = parts.find((p) => p.type === "hour")?.value || "00";
				const minute = (parts.find((p) => p.type === "minute")?.value || "00").padStart(2, "0");
				const hour = (rawHour === "24" ? "00" : rawHour).padStart(2, "0");
				return `${hour}:${minute}`;
			}

			function statusLabel(status) {
				const labels = {
					trialing: "Trialing (billing date was just re-anchored, expected, not an error)",
					past_due: "Past due, card was declined",
					unpaid: "Unpaid, repeated card declines",
					paused: "Paused",
					incomplete: "Incomplete, first charge hasn't gone through",
				};
				return labels[status] || status;
			}

			function commitmentLabel(sub) {
				// completedVisitCount counts every visit the customer was actually
				// billed for — including "still charge" cancellations, since they
				// paid for that visit even though it wasn't performed. Only skipped
				// visits (never billed at all) don't add to it (see
				// stripe-webhook.js). Staff use this to decide whether a
				// cancellation request is inside or outside the plan's minimum
				// commitment before approving it — nothing here blocks cancellation
				// automatically, it's just the number to check by hand.
				if (sub.minimumCommitment == null) {
					return `Completed visits: <strong>${sub.completedVisitCount}</strong> (minimum commitment not written yet for ${sub.frequency || "this frequency"})`;
				}
				const remaining = sub.minimumCommitment - sub.completedVisitCount;
				const status = remaining <= 0 ? "minimum commitment met" : `${remaining} more to go`;
				return `Completed visits: <strong>${sub.completedVisitCount} of ${sub.minimumCommitment}</strong>, ${status}`;
			}

			function setStatus(message, isError = false) {
				searchStatus.hidden = !message;
				searchStatus.textContent = message;
				searchStatus.classList.toggle("admin-status--error", isError);
			}

			function renderResults(subscriptions) {
				resultsEl.innerHTML = "";
				if (!subscriptions.length) {
					setStatus("No active recurring plans found for that email.");
					return;
				}
				setStatus("");

				for (const sub of subscriptions) {
					const card = document.createElement("div");
					card.className = "card admin-card";
					card.innerHTML = `
						<h3>${escapeHtml(sub.name) || "(no name on file)"}</h3>
						<p class="admin-card__meta">${escapeHtml(sub.address)}${sub.phone ? " · " + escapeHtml(sub.phone) : ""}</p>
						<p class="admin-card__meta">
							Plan: ${sub.frequency || "N/A"} · Current schedule: <strong>${fmt(sub.lastVisitStart)}</strong>
							${sub.status && sub.status !== "active" ? ` · Status: <strong>${statusLabel(sub.status)}</strong>` : ""}
						</p>
						<p class="admin-card__meta">${commitmentLabel(sub)}</p>
						<form class="book-form admin-reschedule-form">
							<div class="book-form__row">
								<label>New date</label>
								<input type="date" name="date" required />
							</div>
							<div class="book-form__row">
								<label>New time</label>
								<input type="time" name="time" required />
							</div>
							<button type="submit" class="btn btn--outline">Save New Schedule</button>
						</form>

						<div class="admin-cancel-actions">
							<button type="button" class="btn btn--outline admin-cancel-visit">
								Cancel Next Visit: Still Charge
							</button>
							<button type="button" class="btn btn--outline admin-skip-visit">
								Cancel Next Visit: Skip Charge
							</button>
							<button type="button" class="btn btn--outline admin-cancel-now">
								Cancel Plan: Immediately
							</button>
						</div>

						<div class="admin-cancel-period-block">
							<p class="admin-hint admin-hint--tight">
								Cancel the plan on a specific date. Visits keep billing normally, right on
								schedule, up through that date; nothing after it. Defaults to right after the
								${fmt(sub.lastVisitStart)} visit, so that one still happens and gets billed.
							</p>
							<form class="book-form admin-cancel-period-form">
								<div class="book-form__row">
									<label>Cancel on date</label>
									<input type="date" name="cancelDate" value="${toDateInputValue(sub.afterNextVisitStart)}" required />
								</div>
								<div class="book-form__row">
									<label>Time</label>
									<input type="time" name="cancelTime" value="${toTimeInputValue(sub.afterNextVisitStart)}" required />
								</div>
								<button type="submit" class="btn btn--outline admin-cancel-period">
									Cancel Plan: On This Date
								</button>
							</form>
						</div>

						<p class="admin-result-message" hidden></p>
					`;

					const form = card.querySelector(".admin-reschedule-form");
					const messageEl = card.querySelector(".admin-result-message");

					form.addEventListener("submit", async (e) => {
						e.preventDefault();
						const date = form.date.value;
						const time = form.time.value;
						const submitBtn = form.querySelector("button[type=submit]");

						await submitReschedule({ subscriptionId: sub.subscriptionId, date, time, force: false });

						async function submitReschedule(payload) {
							submitBtn.disabled = true;
							messageEl.hidden = true;
							try {
								const res = await fetch("/api/admin/reschedule-subscription", {
									method: "POST",
									headers: { "Content-Type": "application/json" },
									body: JSON.stringify(payload),
								});
								const data = await res.json();

								if (res.status === 409 && data.conflict && !payload.force) {
									const confirmed = confirm(
										"That time already has something on the calendar. Schedule it anyway?",
									);
									if (confirmed) {
										await submitReschedule({ ...payload, force: true });
										return;
									}
									messageEl.hidden = false;
									messageEl.textContent = "Not scheduled. Pick a different time or confirm the overlap.";
									messageEl.classList.add("admin-result-message--error");
									return;
								}

								if (!res.ok) {
									messageEl.hidden = false;
									messageEl.textContent = data.error || "Something went wrong.";
									messageEl.classList.add("admin-result-message--error");
									return;
								}

								messageEl.hidden = false;
								if (data.warning) {
									messageEl.classList.add("admin-result-message--error");
									messageEl.textContent = data.warning;
								} else {
									messageEl.classList.remove("admin-result-message--error");
									messageEl.textContent = `Done. All future visits, and billing, now aligned to ${fmt(data.newVisitStart)}.`;
								}
							} catch {
								messageEl.hidden = false;
								messageEl.textContent = "Network error, please try again.";
								messageEl.classList.add("admin-result-message--error");
							} finally {
								submitBtn.disabled = false;
							}
						}
					});

					function showMessage(text, isError = false) {
						messageEl.hidden = false;
						messageEl.textContent = text;
						messageEl.classList.toggle("admin-result-message--error", isError);
					}

					async function postJson(url, payload) {
						const res = await fetch(url, {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify(payload),
						});
						const data = await res.json().catch(() => ({}));
						return { ok: res.ok, data };
					}

					const cancelVisitBtn = card.querySelector(".admin-cancel-visit");
					cancelVisitBtn.addEventListener("click", async () => {
						if (!confirm(`Cancel the next scheduled visit for ${sub.name || "this customer"}? The plan keeps billing and scheduling normally after that.`)) return;
						cancelVisitBtn.disabled = true;
						try {
							const { ok, data } = await postJson("/api/admin/cancel-visit", {
								subscriptionId: sub.subscriptionId,
							});
							showMessage(ok ? "Next visit canceled. The plan continues normally after that." : (data.error || "Something went wrong."), !ok);
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							cancelVisitBtn.disabled = false;
						}
					});

					const skipVisitBtn = card.querySelector(".admin-skip-visit");
					skipVisitBtn.addEventListener("click", async () => {
						if (
							!confirm(
								`Cancel the next visit for ${sub.name || "this customer"} AND skip charging them for it? The plan fast-forwards to the following visit and resumes normally from there.`,
							)
						)
							return;
						skipVisitBtn.disabled = true;
						try {
							const { ok, data } = await postJson("/api/admin/skip-visit", {
								subscriptionId: sub.subscriptionId,
							});
							if (ok && data.warning) {
								showMessage(data.warning, true);
							} else {
								showMessage(
									ok
										? "Next visit canceled and unbilled. The plan resumes on the following visit."
										: data.error || "Something went wrong.",
									!ok,
								);
							}
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							skipVisitBtn.disabled = false;
						}
					});

					const cancelPeriodForm = card.querySelector(".admin-cancel-period-form");
					cancelPeriodForm.addEventListener("submit", async (e) => {
						e.preventDefault();
						const cancelDate = cancelPeriodForm.cancelDate.value;
						const cancelTime = cancelPeriodForm.cancelTime.value;
						const submitBtn = cancelPeriodForm.querySelector("button[type=submit]");
						if (
							!confirm(
								`Schedule ${sub.name || "this customer"}'s plan to cancel on ${cancelDate} at ${cancelTime}? Visits keep billing normally, right on schedule, up through then.`,
							)
						)
							return;
						submitBtn.disabled = true;
						try {
							const { ok, data } = await postJson("/api/admin/cancel-subscription", {
								subscriptionId: sub.subscriptionId,
								immediate: false,
								cancelDate,
								cancelTime,
							});
							if (ok && data.warning) {
								showMessage(data.warning, true);
							} else if (ok && data.note) {
								showMessage(`Plan will cancel on ${fmt(data.cancelAt)}. ${data.note}`, false);
							} else {
								showMessage(
									ok
										? `Plan will cancel on ${fmt(data.cancelAt)}. Billed normally, right on schedule, until then.`
										: data.error || "Something went wrong.",
									!ok,
								);
							}
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							submitBtn.disabled = false;
						}
					});

					const cancelNowBtn = card.querySelector(".admin-cancel-now");
					cancelNowBtn.addEventListener("click", async () => {
						if (!confirm(`Cancel ${sub.name || "this customer"}'s recurring plan immediately and remove their upcoming visit from the calendar? If that visit was already paid for, you'll need to refund it by hand in Stripe.`)) return;
						cancelNowBtn.disabled = true;
						try {
							const { ok, data } = await postJson("/api/admin/cancel-subscription", {
								subscriptionId: sub.subscriptionId,
								immediate: true,
							});
							if (ok && data.warning) {
								showMessage(data.warning, true);
							} else {
								showMessage(ok ? "Plan canceled immediately and the upcoming visit was removed from the calendar." : (data.error || "Something went wrong."), !ok);
							}
						} catch {
							showMessage("Network error, please try again.", true);
						} finally {
							cancelNowBtn.disabled = false;
						}
					});

					resultsEl.appendChild(card);
				}
			}

			searchForm.addEventListener("submit", async (e) => {
				e.preventDefault();
				const email = document.getElementById("search-email").value.trim();
				if (!email) return;

				resultsEl.innerHTML = "";
				setStatus("Searching…");

				try {
					const res = await fetch(`/api/admin/find-subscriptions?email=${encodeURIComponent(email)}`);
					const data = await res.json();
					if (!res.ok) {
						setStatus(data.error || "Search failed.", true);
						return;
					}
					renderResults(data.subscriptions || []);
				} catch {
					setStatus("Network error, please try again.", true);
				}
			});

			// --- Browse-all-customers: dropdown + mini calendar --------------------
			// Both are just alternate ways to select a customer, feeding into the
			// exact same renderResults() the email search uses — once the full
			// roster is fetched, selecting one from either control is instant, no
			// second network round trip.

			let allSubscriptions = [];
			let calMonth = todayLocalIso().slice(0, 7) + "-01"; // "YYYY-MM-01"

			function todayLocalIso() {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date());
			}

			function isoDateInTimeZone(iso) {
				return new Intl.DateTimeFormat("en-CA", {
					timeZone: "America/Los_Angeles",
					year: "numeric",
					month: "2-digit",
					day: "2-digit",
				}).format(new Date(iso));
			}

			// Deliberately NOT `new Date(dateStr)` — that parses "YYYY-MM-DD" as
			// UTC midnight, which can print as the previous day in a west-of-UTC
			// browser (same fix used throughout admin/dispatch.astro).
			function localDate(dateStr) {
				return new Date(dateStr + "T00:00:00");
			}

			function daysInMonthCount(dateStr) {
				const [y, m] = dateStr.split("-").map(Number);
				return new Date(Date.UTC(y, m, 0)).getUTCDate();
			}

			function addMonths(dateStr, delta) {
				const [y, m] = dateStr.split("-").map(Number);
				const date = new Date(Date.UTC(y, m - 1 + delta, 1));
				return date.toISOString().slice(0, 10);
			}

			function selectSubscription(sub) {
				if (!sub) return;
				customerSelect.value = sub.subscriptionId;
				renderResults([sub]);
				resultsEl.scrollIntoView({ behavior: "smooth", block: "start" });
			}

			function buildCustomerSelect() {
				const previousValue = customerSelect.value;
				customerSelect.innerHTML = `<option value="">Select a customer…</option>`;
				for (const sub of allSubscriptions) {
					const opt = document.createElement("option");
					opt.value = sub.subscriptionId;
					const freq = FREQUENCY_LABELS[sub.frequency] || sub.frequency;
					opt.textContent = `${sub.name || "(no name on file)"} — ${freq}${sub.customerEmail ? " · " + sub.customerEmail : ""}`;
					customerSelect.appendChild(opt);
				}
				customerSelect.value = previousValue;
			}

			// Each subscription's `lastVisitStart` is its next scheduled
			// occurrence (recurring plans reuse/move the same calendar event
			// forward each cycle — see AGENTS.md → "Dispatcher" for why — so
			// this is a plan's *only* meaningful upcoming date, not a history).
			// Building the calendar straight from Stripe metadata like this,
			// rather than reading actual Google Calendar events, sidesteps
			// needing a customer/subscription link on the calendar event itself,
			// which doesn't exist today.
			function buildCalendar() {
				calGrid.innerHTML = "";
				calLabel.textContent = localDate(calMonth).toLocaleDateString("en-US", { month: "long", year: "numeric" });

				const byDate = new Map();
				for (const sub of allSubscriptions) {
					if (!sub.lastVisitStart) continue;
					const dateStr = isoDateInTimeZone(sub.lastVisitStart);
					if (!dateStr.startsWith(calMonth.slice(0, 7))) continue;
					if (!byDate.has(dateStr)) byDate.set(dateStr, []);
					byDate.get(dateStr).push(sub);
				}

				const totalDays = daysInMonthCount(calMonth);
				const firstDow = localDate(calMonth).getDay();
				const today = todayLocalIso();

				for (let i = 0; i < firstDow; i++) {
					const pad = document.createElement("span");
					pad.className = "admin-cal-pad";
					calGrid.appendChild(pad);
				}

				for (let d = 1; d <= totalDays; d++) {
					const dateStr = `${calMonth.slice(0, 8)}${String(d).padStart(2, "0")}`;
					const subsToday = byDate.get(dateStr) || [];
					const cell = document.createElement("div");
					cell.className = "admin-cal-day" + (dateStr === today ? " is-today" : "");
					cell.innerHTML = `<span class="admin-cal-day__num">${d}</span>`;
					subsToday.forEach((sub) => {
						const chip = document.createElement("button");
						chip.type = "button";
						chip.className = "admin-cal-chip";
						chip.textContent = sub.name || "(no name)";
						chip.addEventListener("click", () => selectSubscription(sub));
						cell.appendChild(chip);
					});
					calGrid.appendChild(cell);
				}
			}

			customerSelect.addEventListener("change", () => {
				const sub = allSubscriptions.find((s) => s.subscriptionId === customerSelect.value);
				if (sub) selectSubscription(sub);
			});

			calPrevBtn.addEventListener("click", () => {
				calMonth = addMonths(calMonth, -1);
				buildCalendar();
			});
			calNextBtn.addEventListener("click", () => {
				calMonth = addMonths(calMonth, 1);
				buildCalendar();
			});

			(async function loadAllSubscriptions() {
				browseStatus.hidden = false;
				browseStatus.textContent = "Loading customers…";
				browseStatus.classList.remove("admin-status--error");
				try {
					const res = await fetch("/api/admin/list-subscriptions");
					const data = await res.json();
					if (!res.ok) {
						browseStatus.hidden = false;
						browseStatus.textContent = data.error || "Couldn't load customers.";
						browseStatus.classList.add("admin-status--error");
						return;
					}
					allSubscriptions = data.subscriptions || [];
					buildCustomerSelect();
					buildCalendar();
					browseStatus.hidden = true;
				} catch {
					browseStatus.hidden = false;
					browseStatus.textContent = "Network error loading customers.";
					browseStatus.classList.add("admin-status--error");
				}
			})();
		</script>

		<style is:global>
			/* is:global because this page builds its customer result cards (and
			   now the browse calendar's day cells/chips) client-side via
			   document.createElement — Astro's automatic style scoping only
			   tags elements written directly in the page template, so a scoped
			   <style> here wouldn't match any of that JS-built markup. Same
			   root cause diagnosed and fixed on admin/dispatch.astro. Safe here
			   for the same reason: this stylesheet only loads on this page. */
			.admin-container {
				max-width: 680px;
				margin: 0 auto;
				padding-block: 3rem;
			}

			.admin-hint {
				color: var(--color-slate);
				margin-bottom: 2rem;
			}

			.admin-search {
				display: flex;
				align-items: flex-end;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.admin-search .book-form__row {
				flex: 1;
			}

			.admin-status {
				margin-bottom: 1rem;
			}

			.admin-status--error {
				color: #b3261e;
			}

			.admin-card {
				margin-bottom: 1.25rem;
				padding: 1.5rem;
			}

			.admin-card__meta {
				color: var(--color-slate);
				margin: 0.25rem 0;
			}

			.admin-reschedule-form {
				display: flex;
				align-items: flex-end;
				gap: 1rem;
				flex-wrap: wrap;
				margin-top: 1rem;
			}

			.admin-cancel-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.25rem;
				padding-top: 1.25rem;
				border-top: 1px solid var(--color-border);
			}

			.admin-cancel-actions .btn {
				border-color: #b3261e;
				color: #b3261e;
			}

			.admin-cancel-period-block {
				margin-top: 1rem;
				padding-top: 1rem;
				border-top: 1px solid var(--color-border);
			}

			.admin-hint--tight {
				margin: 0 0 0.75rem;
				font-size: 0.9rem;
			}

			.admin-cancel-period-form {
				display: flex;
				align-items: flex-end;
				gap: 1rem;
				flex-wrap: wrap;
			}

			.admin-cancel-period-form .btn {
				border-color: #b3261e;
				color: #b3261e;
			}

			.admin-result-message {
