---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const values = [
	{
		title: "Warm & Down-to-Earth",
		text: "We show up like a trusted neighbor, not a stiff corporate crew. No jargon, no upsell pressure — just honest, personable service.",
	},
	{
		title: "Detail-Oriented",
		text: "We notice the things that get missed — the baseboard, the cabinet handle, the corner behind the couch. It's the small stuff that makes a home feel truly cared for.",
	},
	{
		title: "Reliable",
		text: "You can count on us to show up, do the job right, and treat your home the way we'd treat our own.",
	},
	{
		title: "Eco-Conscious",
		text: "We use eco-conscious products whenever we can, so your home feels fresh and healthy for everyone in it. See our product standards below.",
	},
];

const productStandards = [
	{
		title: "EWG-Rated for Safety",
		text: "We reach for products that score well with the Environmental Working Group (EWG), so you can breathe easy about what's being used in your home.",
	},
	{
		title: "Eco-Friendly Formulas",
		text: "Biodegradable and made from plant-based or naturally occurring ingredients — kind to your home and the planet.",
	},
	{
		title: "Vegan & Cruelty-Free",
		text: "Nothing we use is tested on animals or made with animal-derived ingredients.",
	},
	{
		title: "Gentle, Yet Effective",
		text: "Our products cut through dirt and everyday buildup without harsh chemicals — safe to have around kids, pets, and anyone with sensitivities.",
	},
];
---

<Layout
	title="About Us | Sky House Cleaning"
	description="Sky House Cleaning is a premium residential cleaning company serving the San Francisco Bay Area, built on reliability, detail, and a genuine care for your home."
>
	<PageHero
		eyebrow="About Us"
		title="A team that treats your home like it's our own"
		lede="Sky House Cleaning is a premium residential cleaning company serving the San Francisco Bay Area. We started with a simple idea: cleaning should feel personal, dependable, and never transactional."
	/>

	<section class="section">
		<div class="container about-copy">
			<p>
				We built Sky House Cleaning around exceptional quality, reliability, and a seamless
				experience from booking to walkthrough. That means transparent pricing you can see up
				front, thoughtfully designed recurring memberships that fit real schedules, and a team that
				pays attention to the details that matter.
			</p>
			<p>
				Whether we're in for a one-time reset, a recurring visit, a move-in/move-out clean, or
				helping you get your garage back in order, our goal stays the same: help you enjoy a
				cleaner, healthier home with less stress.
			</p>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">What We Value</p>
				<h2>How we show up in your home</h2>
			</div>
			<div class="grid grid--4">
				{values.map((v) => (
					<div class="value-card">
						<h3>{v.title}</h3>
						<p>{v.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section" id="product-standards">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Product Standards</p>
				<h2>What actually goes into your home</h2>
				<p>
					A clean home shouldn't come with a side of harsh chemicals. That's why we're picky about
					what goes into our cleaning bags — every product we use has to clear a few standards
					first.
				</p>
			</div>
			<div class="grid grid--4">
				{productStandards.map((p) => (
					<div class="value-card">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</div>
				))}
			</div>
			<p class="product-standards__closer">
				We don't think you should have to choose between a clean home and a healthy one — so
				we've already made that choice for you.
			</p>
		</div>
	</section>

	<CtaBand
		heading="Let's take one thing off your plate"
		subtext="Call or email us and let's talk about what your home needs."
	/>
</Layout>

<style>
	.about-copy {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
		font-size: 1.05rem;
	}

	.value-card {
		background: var(--color-white);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		padding: 1.75rem;
	}

	.value-card h3 {
		font-size: 1.05rem;
		color: var(--color-sky-dark);
	}

	.value-card p {
		margin: 0;
		font-size: 0.92rem;
	}

	.product-standards__closer {
		max-width: 620px;
		margin: 2.5rem auto 0;
		text-align: center;
		font-size: 1.05rem;
		color: var(--color-slate);
	}
</style>
