---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const values = [
	{
		title: "Warm & Down-to-Earth",
		text: "We show up like a trusted neighbor, not a stiff corporate crew. No jargon, no upsell pressure, just honest, personable service.",
	},
	{
		title: "Detail-Oriented",
		text: "We notice the things that get missed: the baseboard, the cabinet handle, the corner behind the couch. It's the small stuff that makes a space feel truly cared for.",
	},
	{
		title: "Reliable",
		text: "You can count on us to show up, do the job right, and treat your space the way we'd treat our own.",
	},
	{
		title: "Eco-Conscious",
		text: "We use eco-conscious products whenever we can, so your space feels fresh and healthy for everyone in it. See our product standards below.",
	},
];

const productStandards = [
	{
		title: "EWG-Rated for Safety",
		text: "We reach for products that score well with the Environmental Working Group (EWG), so you can breathe easy about what's being used in your space.",
	},
	{
		title: "Eco-Friendly Formulas",
		text: "Biodegradable and made from plant-based or naturally occurring ingredients, kind to your space and the planet.",
	},
	{
		title: "Vegan & Cruelty-Free",
		text: "Nothing we use is tested on animals or made with animal-derived ingredients.",
	},
	{
		title: "Gentle, Yet Effective",
		text: "Our products cut through dirt and everyday buildup without harsh chemicals, safe to have around kids, pets, and anyone with sensitivities.",
	},
];
---

<Layout
	title="About Us | Sky House Cleaning"
	description="Sky House Cleaning is a premium cleaning company serving homes and businesses across the San Francisco Bay Area, built on reliability, detail, and genuine care for the spaces you count on."
>
	<PageHero
		eyebrow="About Us"
		title="Cleaning, the way we'd want it done for our own home"
		lede="Sky House Cleaning started with a simple frustration: too many cleaning services feel rushed, impersonal, or hard to trust. We wanted to build something different for the Bay Area, a team that shows up, does the job right, and treats your home like it matters."
	/>

	<section class="section">
		<div class="container about-intro">
			<img
				src="/images/about/team-member-cleaning.jpg"
				alt="A Sky House Cleaning team member, in uniform, smiling in a client's dining room"
				class="about-intro__photo"
				loading="lazy"
			/>
			<p class="about-intro__text">
				That shows up in how we run things. Pricing you can see before you book, no surprises at
				the door. Memberships built to actually fit your schedule, not the other way around. And a
				team that pays attention to the small stuff (the baseboard, the cabinet handle, the corner
				behind the couch) because that's what makes a space feel truly cared for.
			</p>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">What We Value</p>
				<h2>How we show up for you</h2>
			</div>
			<div class="grid grid--4">
				{values.map((v) => (
					<div class="value-card">
						<h3>{v.title}</h3>
						<p>{v.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section" id="product-standards">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Product Standards</p>
				<h2>What actually goes into your space</h2>
				<p>
					A clean home shouldn't come with a side of harsh chemicals. That's why we're picky about
					what goes into our cleaning bags. Every product we use has to clear a few standards
					first.
				</p>
			</div>
			<div class="grid grid--4">
				{productStandards.map((p) => (
					<div class="value-card">
						<h3>{p.title}</h3>
						<p>{p.text}</p>
					</div>
				))}
			</div>
			<p class="product-standards__closer">
				We don't think you should have to choose between a clean home and a healthy one, so
				we've already made that choice for you.
			</p>
		</div>
	</section>

	<CtaBand
		heading="Let's take one thing off your plate"
		subtext="Ready to get started? Schedule your cleaning, or reach out and let's talk about what your home or business needs."
		primaryLabel="Schedule Your Cleaning"
		primaryHref="/booking"
	/>
</Layout>

<style>
	.about-intro {
		display: grid;
		grid-template-columns: minmax(0, 340px) 1fr;
		gap: 2.5rem;
		align-items: center;
		max-width: 960px;
		margin: 0 auto;
	}

	.about-intro__photo {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		object-fit: cover;
	}

	.about-intro__text {
		font-size: 1.05rem;
	}

	@media (max-width: 720px) {
		.about-intro {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.about-intro__photo {
			max-width: 340px;
			margin: 0 auto;
		}
	}

	.value-card {
		background: var(--color-white);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		padding: 1.75rem;
	}

	.value-card h3 {
		font-size: 1.05rem;
		color: var(--color-sky-dark);
	}

	.value-card p {
		margin: 0;
		font-size: 0.92rem;
	}

	.product-standards__closer {
		max-width: 620px;
		margin: 2.5rem auto 0;
		text-align: center;
		font-size: 1.05rem;
		color: var(--color-slate);
	}

</style>
