---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
---

<Layout
	title="Booking Canceled | Sky House Cleaning"
	description="Your payment was canceled. No charge was made."
>
	<PageHero
		eyebrow="No Charge Made"
		title="Payment Canceled"
		lede="You canceled before payment went through, so nothing was charged. Your date/time selection wasn't saved either, no worries, you can pick up right where you left off."
	/>

	<section class="section">
		<div class="container">
			<div class="card canceled-card">
				<p>Ready to try again, or need a hand? We're happy to help.</p>
				<div class="canceled-actions">
					<a href="/booking" class="btn btn--primary">Back to Booking</a>
					<a href="tel:+18017592044" class="btn btn--outline">Call (801) 759-2044</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.canceled-card {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
	}

	.canceled-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.25rem;
	}
</style>
