---
// Public — no admin auth, no login. This is the page a customer lands on
// after staff text/email them a link from /admin/book.astro's phone-booking
// flow. It exists so the customer, not staff, is the one reviewing the
// booking and checking the policy-agreement box — see AGENTS.md → "Phone
// booking confirmation link" and src/lib/pendingBookings.js for why.
//
// Server-rendered (not client-fetched) on purpose: the booking data is
// looked up here in frontmatter using the Firebase Admin SDK, the same way
// /schedule/success.astro looks up the Stripe session server-side, so there's
// no second public "get pending booking by id" API to expose — the only
// public API this flow needs is the POST that actually finalizes it
// (/api/confirm/finalize-pending-booking.js).
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { getPendingBooking } from "../../lib/pendingBookings.js";
import { isConfigured as isFirebaseConfigured } from "../../lib/firebaseAdmin.js";
import { policyFor } from "../../lib/policies.js";

const id = Astro.params.id;

let pending = null;
let errorMessage = null;

if (!isFirebaseConfigured()) {
	errorMessage = "This page isn't configured yet. Please call us to complete your booking.";
} else if (!id) {
	errorMessage = "We couldn't find that booking.";
} else {
	try {
		pending = await getPendingBooking(id);
	} catch {
		errorMessage = "We couldn't load your booking. Please try again or give us a call.";
	}

	if (!pending && !errorMessage) {
		errorMessage = "We couldn't find that booking. The link may be incorrect — please give us a call and we'll help.";
	} else if (pending?.status === "converted") {
		errorMessage = "This booking has already been confirmed and paid for. If that wasn't you, please give us a call.";
	} else if (pending?.expiresAt && new Date(pending.expiresAt) < new Date()) {
		errorMessage = "This link has expired. Please give us a call and we'll send you a new one.";
	}
}

const policy =
	pending && !errorMessage ? policyFor({ type: pending.selections?.type, frequency: pending.selections?.frequency }) : null;

function formatMoney(n) {
	const value = Number(n) || 0;
	const hasCents = Math.round(value * 100) % 100 !== 0;
	return (
		"$" +
		value.toLocaleString("en-US", {
			minimumFractionDigits: hasCents ? 2 : 0,
			maximumFractionDigits: 2,
		})
	);
}

const whenLabel = pending?.slot?.start
	? new Date(pending.slot.start).toLocaleString("en-US", {
			timeZone: "America/Los_Angeles",
			weekday: "long",
			month: "long",
			day: "numeric",
			hour: "numeric",
			minute: "2-digit",
		})
	: "";

const lines = pending?.selections?.lines || [];
const total = pending?.selections?.total || 0;
const customer = pending?.customer || {};
---

<Layout
	title="Confirm Your Booking | Sky House Cleaning"
	description="Review and confirm your Sky House Cleaning booking."
>
	<PageHero
		eyebrow="Almost There"
		title="Confirm Your Booking"
		lede={
			errorMessage
				? undefined
				: "Take a look below, then check the box once you're ready. Nothing is charged until you confirm and pay on the next screen."
		}
	/>

	<section class="section">
		<div class="container">
			{
				errorMessage ? (
					<div class="card confirm-card confirm-card--error">
						<p>{errorMessage}</p>
						<a href="tel:+18017592044" class="btn btn--primary">
							Call (801) 759-2044
						</a>
					</div>
				) : (
					<div class="confirm-layout">
						<div class="confirm-main">
							<div class="card confirm-card">
								<h3>Appointment</h3>
								<p class="confirm-when">{whenLabel}</p>
							</div>

							<div class="card confirm-card">
								<h3>Your Details</h3>
								<ul class="confirm-details">
									<li>
										<strong>Name:</strong> {customer.name}
									</li>
									<li>
										<strong>Email:</strong> {customer.email}
									</li>
									<li>
										<strong>Phone:</strong> {customer.phone}
									</li>
									<li>
										<strong>Address:</strong> {customer.address}
									</li>
									{customer.access && (
										<li>
											<strong>Access:</strong> {customer.access}
										</li>
									)}
									{customer.pets && (
										<li>
											<strong>Pets:</strong> {customer.pets}
										</li>
									)}
									{customer.notes && (
										<li>
											<strong>Notes:</strong> {customer.notes}
										</li>
									)}
								</ul>
								<p class="confirm-hint">
									Something not right? Call us at <a href="tel:+18017592044">(801) 759-2044</a> before confirming
									and we'll fix it.
								</p>
							</div>

							<div class="card confirm-card">
								<form id="confirm-form" data-id={id}>
									{policy && (
										<div class="confirm-policy" id="confirm-policy-block">
											{policy.minimumCommitment && (
												<p class="confirm-policy__commitment">
													This plan requires a minimum commitment of {policy.minimumCommitment} completed
													cleanings before you can cancel. Full details in the policy below.
												</p>
											)}
											<label class="confirm-policy__checkbox">
												<input type="checkbox" id="confirm-policy-agree" />
												<span>
													I have read and agree to the{" "}
													<a href={policy.path} target="_blank" rel="noopener">
														{policy.label}
													</a>
													.
												</span>
											</label>
										</div>
									)}

									<p class="confirm-form__error" id="confirm-form-error" hidden />

									<button type="submit" class="btn btn--primary confirm-form__submit" id="confirm-submit">
										Confirm &amp; Continue to Payment
									</button>
								</form>
							</div>
						</div>

						<aside class="card confirm-summary">
							<p class="confirm-summary__label">Order Summary</p>
							<ul class="confirm-summary__lines">
								{lines.map((line) => (
									<li>
										<span>{line.label}</span>
										<span>{formatMoney(line.amount)}</span>
									</li>
								))}
							</ul>
							<div class="confirm-summary__total">
								<span>Total</span>
								<span>{formatMoney(total)}</span>
							</div>
						</aside>
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.confirm-card--error {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
	}

	.confirm-card--error .btn {
		margin-top: 1rem;
	}

	.confirm-layout {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 2.5rem;
		align-items: start;
		max-width: 1100px;
		margin: 0 auto;
	}

	.confirm-main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
	}

	.confirm-card {
		padding: 2rem;
	}

	.confirm-card h3 {
		margin-bottom: 0.75rem;
	}

	.confirm-when {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--color-sky-dark);
		margin: 0;
	}

	.confirm-details {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.95rem;
		color: var(--color-ink);
	}

	.confirm-hint {
		margin: 0;
		font-size: 0.85rem;
		color: var(--color-slate);
	}

	.confirm-policy {
		background: var(--color-sky-light);
		border-radius: 10px;
		padding: 1rem 1.1rem;
		margin-bottom: 1.25rem;
	}

	.confirm-policy__commitment {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-ink);
	}

	.confirm-policy__checkbox {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: 0.9rem;
		color: var(--color-slate);
		cursor: pointer;
	}

	.confirm-policy__checkbox input {
		width: auto;
		margin-top: 0.2rem;
		flex-shrink: 0;
	}

	.confirm-form__error {
		margin: 0 0 1rem;
		font-size: 0.85rem;
		color: #b3261e;
	}

	.confirm-form__error[hidden] {
		display: none;
	}

	.confirm-form__submit {
		width: 100%;
	}

	.confirm-form__submit[disabled] {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.confirm-summary {
		position: sticky;
		top: 1.5rem;
		min-width: 0;
		padding: 2rem;
	}

	.confirm-summary__label {
		margin: 0 0 1rem;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-sky-dark);
	}

	.confirm-summary__lines {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.confirm-summary__lines li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9rem;
		color: var(--color-slate);
	}

	.confirm-summary__total {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.4rem;
		color: var(--color-ink);
	}

	@media (max-width: 900px) {
		.confirm-layout {
			grid-template-columns: 1fr;
		}

		.confirm-summary {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.confirm-card {
			padding: 1.5rem;
		}
	}
</style>

<script>
	function initConfirmPage() {
		const form = document.getElementById("confirm-form");
		if (!form || form.dataset.init === "true") return;
		form.dataset.init = "true";

		const id = form.dataset.id;
		const policyBlock = document.getElementById("confirm-policy-block");
		const policyAgree = document.getElementById("confirm-policy-agree");
		const errorEl = document.getElementById("confirm-form-error");
		const submitBtn = document.getElementById("confirm-submit");

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			errorEl.hidden = true;

			if (policyBlock && policyAgree && !policyAgree.checked) {
				errorEl.textContent = "Please check the box above before continuing.";
				errorEl.hidden = false;
				policyBlock.scrollIntoView({ behavior: "smooth", block: "center" });
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = "Redirecting to payment…";

			try {
				const response = await fetch("/api/confirm/finalize-pending-booking", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ id, policyAgreed: policyBlock && policyAgree ? policyAgree.checked : false }),
				});
				const data = await response.json();

				if (!response.ok || !data.url) {
					throw new Error(data.error || "Something went wrong starting checkout.");
				}

				window.location.href = data.url;
			} catch (err) {
				errorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = "Confirm & Continue to Payment";
			}
		});
	}

	initConfirmPage();
	document.addEventListener("astro:page-load", initConfirmPage);
</script>
