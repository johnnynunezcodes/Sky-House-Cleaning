---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import BeforeAfterSlider from "../../components/BeforeAfterSlider.astro";
import CtaBand from "../../components/CtaBand.astro";
import {
	cleaningServices,
	otherServices,
	shortTermRentalServices,
	commercialServices,
	addOns,
} from "../../data/content.js";
---

<Layout
	title="Services | Sky House Cleaning"
	description="Residential cleaning, car detailing, and garage organization services from Sky House Cleaning, serving the San Francisco Bay Area."
>
	<PageHero
		eyebrow="What We Offer"
		title="Services for every home and business"
		lede="From a single reset clean to a recurring membership, plus car detailing, garage organization, and cleaning for offices and job sites. Here's everything we offer."
	/>

	<section class="section">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">Residential Cleaning</p>
				<h2>Home cleaning, on your terms</h2>
			</div>
			<div class="grid grid--4">
				{cleaningServices.map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">See the Difference</p>
				<h2>A real kitchen, before and after</h2>
				<p>Drag the slider to see what a Sky House Cleaning visit looks like in person.</p>
			</div>
			<div class="before-after-wrap">
				<BeforeAfterSlider
					beforeSrc="/images/before-after/kitchen-2-before.jpg"
					afterSrc="/images/before-after/kitchen-2-after.jpg"
					alt="Kitchen cleaned by Sky House Cleaning"
				/>
			</div>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">Organization &amp; Vehicle Care</p>
				<h2>More ways we help</h2>
			</div>
			<div class="grid grid--2">
				{otherServices.map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">Short-Term Rentals</p>
				<h2>Airbnb turnover cleaning</h2>
				<p>Fast, guest-ready turnovers on your schedule. Quote-based and booked by phone or email.</p>
			</div>
			<div class="single-card">
				{shortTermRentalServices.map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">For Businesses</p>
				<h2>Commercial cleaning</h2>
				<p>
					Offices, small businesses, and job sites need the same reliability we bring to homes.
					These are quote-based and booked by phone or email rather than online.
				</p>
			</div>
			<div class="grid grid--2">
				{commercialServices.map((service) => (
					<ServiceCard
						title={service.title}
						blurb={service.blurb}
						href={`/services/${service.slug}`}
						startingAt={service.startingAt}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading section-heading--left">
				<p class="eyebrow">Add-On Services</p>
				<h2>Make any cleaning your own</h2>
				<p>
					Want a little extra attention in a specific spot? Add any of these on to your booking.
				</p>
			</div>
			<ul class="addon-list">
				{addOns.map((addon) => (
					<li>{addon}</li>
				))}
			</ul>
		</div>
	</section>

	<CtaBand
		heading="Not sure which service is right for you?"
		subtext="Call or email us and we'll help you pick the best fit for your home."
	/>
</Layout>

<style>
	.section-heading--left {
		text-align: left;
		max-width: 640px;
		margin: 0 0 2.5rem;
	}

	.before-after-wrap {
		max-width: 760px;
		margin: 0 auto;
	}

	/* Only one card in this section, so it's capped to a normal card width
	   instead of stretching full-width like a lone grid column would. */
	.single-card {
		max-width: 380px;
	}

	.addon-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.9rem;
	}

	.addon-list li {
		background: var(--color-white);
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		padding: 1rem 1.4rem;
		font-family: var(--font-heading);
		font-weight: 500;
		font-size: 0.95rem;
	}

	@media (max-width: 860px) {
		.addon-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 560px) {
		.addon-list {
			grid-template-columns: 1fr;
		}
	}
</style>
