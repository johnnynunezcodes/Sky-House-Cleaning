---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ChecklistCard from "../../components/ChecklistCard.astro";
import CtaBand from "../../components/CtaBand.astro";

const sections = [
	{
		title: "Kitchen",
		items: [
			"Wiping down and spot-cleaning cabinet faces",
			"Cleaning the stovetop, burners, and drip pans",
			"Freshening the inside of the microwave",
			"Cleaning the exterior of appliances",
			"Polishing the sink and wiping counters and backsplash",
			"Cleaning the interior of cabinets and drawers",
			"Cleaning the interior of appliances (oven, refrigerator)",
		],
	},
	{
		title: "Bathrooms",
		items: [
			"Thorough scrubbing of sinks, toilets, tubs, and showers",
			"Polished faucets and sparkling mirrors",
			"Wiped counters and cabinet fronts",
			"Cleaning the interior of cabinets and drawers",
		],
	},
	{
		title: "Living Areas & Bedrooms",
		items: [
			"Tidying pillows, blankets, and common areas",
			"Making beds (if fresh linens are left out)",
			"Dusting shelves and blinds",
			"Wiping window sills",
		],
	},
	{
		title: "Throughout the Home",
		items: [
			"Vacuuming carpets and sweeping/mopping hard surfaces",
			"Dusting interior shelves and closets",
			"Wiping down handrails",
			"Wiping down walls and baseboards",
			"Cleaning interior windows",
		],
	},
];
---

<Layout
	title="Move-In / Move-Out Cleaning | Sky House Cleaning"
	description="A top-to-bottom clean for a home in transition. Full access to every room, cabinet, and closet. Starting at $263."
>
	<PageHero
		eyebrow="Residential Cleaning · From $263"
		title="Move-In / Move-Out Cleaning"
		lede="A top-to-bottom clean for a home in transition — whether you're handing over the keys or just picked them up. You'll get everything in our Standard Cleaning, plus the deeper detailing an empty (or newly filled) home needs."
	>
		<div class="hero-actions">
			<a href="tel:+18017592044" class="btn btn--primary">Call (801) 759-2044</a>
			<a href="/pricing" class="btn btn--outline">See Pricing</a>
		</div>
	</PageHero>

	<section class="section">
		<div class="container">
			<div class="grid grid--2">
				{sections.map((section) => (
					<ChecklistCard title={section.title} items={section.items} />
				))}
			</div>
			<p class="note">
				This one's ideal for empty or near-empty homes — with full access to cabinets, closets, and
				every room, we can reach the spots that usually stay off-limits during a regular visit.
			</p>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.note {
		max-width: 760px;
		margin: 2.5rem auto 0;
		text-align: center;
	}
</style>
