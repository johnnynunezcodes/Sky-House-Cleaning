---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ChecklistCard from "../../components/ChecklistCard.astro";
import CtaBand from "../../components/CtaBand.astro";

const sections = [
	{
		title: "Interior Detailing",
		items: [
			"Full vacuum of seats, carpets, and trunk",
			"Wiping down all interior surfaces, including the dash, console, and door panels",
			"Cleaning interior glass and mirrors",
			"Spot-treating stains on fabric seats and upholstery",
			"Wiping down leather and vinyl surfaces",
			"Cleaning cup holders, vents, and other tight spots",
		],
	},
];
---

<Layout
	title="Interior Car Detailing | Sky House Cleaning"
	description="One-time and monthly membership interior car detailing from Sky House Cleaning. One-time details from $275, membership visits from $250."
>
	<PageHero
		eyebrow="Vehicle Care · One-Time $275 or Membership $250/Visit"
		title="Interior Car Detailing"
		lede="Professional detailing, exceptional results. We bring your vehicle's interior back to life — whether it's a one-time refresh or a monthly membership to keep it that way."
	>
		<div class="hero-actions">
			<a href="/booking/car-detailing" class="btn btn--primary">Schedule Your Detail</a>
			<a href="tel:+18017592044" class="btn btn--outline">Call (801) 759-2044</a>
		</div>
	</PageHero>

	<section class="section section--white">
		<div class="container">
			<div class="checklist-single">
				{sections.map((section) => (
					<ChecklistCard title={section.title} items={section.items} />
				))}
			</div>
			<p class="note">
				Fabric stains get spot-treated rather than fully shampooed, and leather or vinyl seating gets
				wiped down rather than conditioned. Standard vacuuming picks up everyday pet hair — for
				heavier shedding, extensive pet hair removal is available as an add-on.
			</p>
		</div>
	</section>

	<CtaBand />
</Layout>

<style>
	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.note {
		max-width: 760px;
		margin: 2.5rem auto 0;
		text-align: center;
	}

	/* Only one checklist item on this page (unlike the 4-item grid on other
	   service pages), so it's centered as a single column instead of sitting
	   left-aligned in a half-empty two-column grid. */
	.section--white {
		background: var(--color-white);
	}

	.checklist-single {
		max-width: 480px;
		margin: 0 auto;
	}
</style>
