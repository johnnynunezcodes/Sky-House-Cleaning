---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ChecklistCard from "../../components/ChecklistCard.astro";
import CtaBand from "../../components/CtaBand.astro";

const sections = [
	{
		title: "General Cleaning",
		items: [
			"Emptying trash and replacing liners",
			"Vacuuming carpets and mopping hard floors",
			"Dusting desks, surfaces, and furniture",
			"Wiping down and disinfecting high-touch surfaces, including door handles, light switches, and handrails",
			"Cleaning interior glass, mirrors, and partitions",
		],
	},
	{
		title: "Restrooms, Break Rooms & Common Areas",
		items: [
			"Cleaning and disinfecting toilets, sinks, and countertops",
			"Restocking paper towels, toilet paper, and soap when supplies are left on-site",
			"Wiping down break room counters, tables, and the exterior of appliances",
			"Emptying and relining trash bins",
			"Wiping down reception desks and shared furniture near entrances",
		],
	},
];
---

<Layout
	title="Office & Commercial Cleaning | Sky House Cleaning"
	description="Recurring office and commercial cleaning for the San Francisco Bay Area. Weekly, bi-weekly, or custom schedules for offices and small businesses. Custom quotes."
>
	<PageHero
		eyebrow="Commercial Cleaning · Custom Quote"
		title="Office & Commercial Cleaning"
		lede="Recurring cleaning for offices and small businesses, so your space stays consistently welcoming for the people who work there and the customers who walk through the door. We work around your hours."
	>
		<div class="hero-actions">
			<a href="tel:+18017592044" class="btn btn--primary">Call (801) 759-2044</a>
			<a href="/contact" class="btn btn--outline">Get a Quote</a>
		</div>
	</PageHero>

	<section class="section section--white">
		<div class="container">
			<div class="grid grid--2">
				{sections.map((section) => (
					<ChecklistCard title={section.title} items={section.items} />
				))}
			</div>
			<p class="note">
				Available weekly, bi-weekly, or on a custom recurring schedule built around your business.
				This service is booked by phone or email, not through our online booking — call or send us
				a message and we'll put together a plan.
			</p>
		</div>
	</section>

	<section class="section section--tint">
		<div class="container">
			<div class="video-feature">
				<div class="video-feature__text section-heading">
					<p class="eyebrow">See Us in Action</p>
					<h2>Commercial-grade results</h2>
					<p>Our team deep-cleaning a commercial kitchen floor.</p>
				</div>
				<div class="video-wrap" id="commercial-video-wrap">
					<video
						src="/videos/commercial-cleaning-kitchen-floor.mp4"
						poster="/videos/commercial-cleaning-kitchen-floor-poster.jpg"
						autoplay
						muted
						loop
						playsinline
						webkit-playsinline="true"
						preload="auto"
					>
						Your browser doesn't support embedded video. <a href="/videos/commercial-cleaning-kitchen-floor.mp4">Watch the video directly</a>.
					</video>
					<button type="button" class="video-toggle" aria-label="Pause video">
						<svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
							<rect x="6" y="4" width="4" height="16" rx="1"></rect>
							<rect x="14" y="4" width="4" height="16" rx="1"></rect>
						</svg>
						<svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" hidden>
							<path d="M7 4l13 8-13 8z"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</section>

	<CtaBand
		heading="Ready for a cleaner workplace?"
		subtext="Every business is different, so pricing is custom. Call or email us and we'll put together a quote."
	/>
</Layout>

<style>
	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 1.5rem;
	}

	.note {
		max-width: 760px;
		margin: 2.5rem auto 0;
		text-align: center;
	}

	.section--white {
		background: var(--color-white);
	}

	/* Stacked on mobile (text above, video below, both centered — the
	   default .section-heading look). On desktop this becomes a row: the
	   text sits to the left of the video, and the pair is centered as a
	   single unit within the page rather than the text spanning the full
	   container width above a centered video. */
	.video-feature {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	@media (min-width: 861px) {
		.video-feature {
			flex-direction: row;
			justify-content: center;
			align-items: center;
			gap: 3rem;
			max-width: 900px;
			margin: 0 auto;
		}

		.video-feature__text {
			text-align: left;
			max-width: 380px;
			margin: 0;
		}
	}

	/* The source clip is a vertical (9:16) phone recording, so it's capped
	   to a narrow column instead of stretching full-width like a landscape
	   video would. */
	.video-wrap {
		position: relative;
		max-width: 320px;
		margin: 0 auto;
	}

	.video-wrap video {
		display: block;
		width: 100%;
		/* Reserves the correct portrait box up front (matches the file's
		   real 720x1280 ratio exactly), so the video/poster has somewhere
		   to render immediately on slower mobile connections instead of
		   collapsing to the browser's fallback 300x150 box while metadata
		   is still loading — that collapse is what made it disappear on
		   mobile. Deliberately no object-fit override: since this ratio
		   matches the file exactly, the browser default already renders
		   it full-bleed with no letterboxing or cropping. */
		aspect-ratio: 9 / 16;
		border-radius: var(--radius);
		box-shadow: var(--shadow-soft);
		cursor: pointer;
	}

	/* A small Instagram-style tap target instead of the native <video>
	   controls bar — no gray scrubber/volume/fullscreen strip covering the
	   footage, just a minimal circular icon. Clicking anywhere on the
	   video itself also toggles play/pause (see script below); this
	   button is just a visible, obvious affordance in the corner. */
	.video-toggle {
		position: absolute;
		bottom: 0.85rem;
		right: 0.85rem;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.45);
		color: #fff;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.video-toggle:hover {
		background: rgba(0, 0, 0, 0.65);
	}

	.video-toggle svg {
		width: 15px;
		height: 15px;
		fill: currentColor;
	}
</style>

<script>
	// Custom play/pause for the commercial-cleaning clip: clicking anywhere
	// on the video, or the small corner button, toggles playback — no
	// native <video controls> bar (that draws a gray strip over the
	// bottom of the footage).
	function initCommercialVideoToggle() {
		const wrap = document.getElementById("commercial-video-wrap");
		if (!wrap || wrap.dataset.toggleInit === "true") return;
		wrap.dataset.toggleInit = "true";

		const video = wrap.querySelector("video");
		const btn = wrap.querySelector(".video-toggle");
		const pauseIcon = wrap.querySelector(".icon-pause");
		const playIcon = wrap.querySelector(".icon-play");
		if (!video || !btn || !pauseIcon || !playIcon) return;

		function updateIcon() {
			const playing = !video.paused && !video.ended;
			pauseIcon.hidden = !playing;
			playIcon.hidden = playing;
			btn.setAttribute("aria-label", playing ? "Pause video" : "Play video");
		}

		function toggle() {
			if (video.paused || video.ended) {
				video.play();
			} else {
				video.pause();
			}
		}

		video.addEventListener("click", toggle);
		btn.addEventListener("click", (event) => {
			event.stopPropagation();
			toggle();
		});
		video.addEventListener("play", updateIcon);
		video.addEventListener("pause", updateIcon);
		updateIcon();
	}

	initCommercialVideoToggle();
	document.addEventListener("astro:page-load", initCommercialVideoToggle);
</script>
