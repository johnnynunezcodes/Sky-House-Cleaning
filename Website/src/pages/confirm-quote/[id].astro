---
// Public — no admin auth. This is the page a customer lands on after staff
// send them a quote link from /admin/book-quote.astro. Adapted from the old
// /confirm-deposit/[id].astro, with one real difference: NO appointment
// exists yet at this point (see src/lib/quotes.js) — staff pick the actual
// date/time later, after this quote is accepted. So unlike the old page,
// there's no "Appointment" card here, just the price and the deposit.
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { getQuote } from "../../lib/quotes.js";
import { isConfigured as isFirebaseConfigured } from "../../lib/firebaseAdmin.js";
import { QUOTE_SERVICE_TYPES } from "../../data/booking.js";

const id = Astro.params.id;

let quote = null;
let errorMessage = null;

if (!isFirebaseConfigured()) {
	errorMessage = "This page isn't configured yet. Please call us to review your quote.";
} else if (!id) {
	errorMessage = "We couldn't find that quote.";
} else {
	try {
		quote = await getQuote(id);
	} catch {
		errorMessage = "We couldn't load your quote. Please try again or give us a call.";
	}

	if (!quote && !errorMessage) {
		errorMessage = "We couldn't find that quote. The link may be incorrect — please give us a call and we'll help.";
	} else if (quote?.status === "accepted" || quote?.status === "scheduled") {
		errorMessage = "This quote has already been accepted. If that wasn't you, please give us a call.";
	} else if (quote?.status === "declined") {
		errorMessage = "This quote is no longer active. Please give us a call if you'd like a new one.";
	} else if (quote?.expiresAt && new Date(quote.expiresAt) < new Date()) {
		errorMessage = "This link has expired. Please give us a call and we'll send you a new one.";
	}
}

function formatMoney(n) {
	const value = Number(n) || 0;
	return "$" + value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

const serviceLabel = quote?.serviceType ? QUOTE_SERVICE_TYPES[quote.serviceType] || quote.serviceType : "";
const customer = quote?.customer || {};
const quotedTotal = quote?.quotedTotal || 0;
const depositAmount = quote?.depositAmount || 0;
const balanceDue = Math.max(quotedTotal - depositAmount, 0);
---

<Layout title="Review Your Quote | Sky House Cleaning" description="Review and accept your quote from Sky House Cleaning.">
	<PageHero
		eyebrow="Your Quote"
		title="Review Your Quote"
		lede={
			errorMessage
				? undefined
				: "Take a look at the details below, then accept and pay your deposit to move forward. We'll reach out to schedule the actual date and time once you do."
		}
	/>

	<section class="section">
		<div class="container">
			{
				errorMessage ? (
					<div class="card confirm-card confirm-card--error">
						<p>{errorMessage}</p>
						<a href="tel:+18017592044" class="btn btn--primary">
							Call (801) 759-2044
						</a>
					</div>
				) : (
					<div class="confirm-layout">
						<div class="confirm-main">
							<div class="card confirm-card">
								<h3>Service</h3>
								<p class="confirm-service">{serviceLabel}</p>
								{quote.notes && <p class="confirm-hint">{quote.notes}</p>}
							</div>

							<div class="card confirm-card">
								<h3>Your Details</h3>
								<ul class="confirm-details">
									<li>
										<strong>Name:</strong> {customer.name}
									</li>
									{customer.email && (
										<li>
											<strong>Email:</strong> {customer.email}
										</li>
									)}
									<li>
										<strong>Phone:</strong> {customer.phone}
									</li>
									<li>
										<strong>Address:</strong> {customer.address}
									</li>
								</ul>
								<p class="confirm-hint">
									Something not right? Call us at <a href="tel:+18017592044">(801) 759-2044</a> before
									accepting and we'll fix it.
								</p>
							</div>

							<div class="card confirm-card">
								<form id="confirm-quote-form" data-id={id}>
									<div class="confirm-policy">
										<label class="confirm-policy__checkbox">
											<input type="checkbox" id="confirm-quote-agree" />
											<span>
												I accept this quote and authorize this deposit charge to secure the job. The
												remaining balance of {formatMoney(balanceDue)} is due once the work is complete.
												We'll be in touch to schedule the actual date and time.
											</span>
										</label>
									</div>

									<p class="confirm-form__error" id="confirm-quote-error" hidden />

									<button type="submit" class="btn btn--primary confirm-form__submit" id="confirm-quote-submit">
										Accept &amp; Pay Deposit
									</button>
								</form>
							</div>
						</div>

						<aside class="card confirm-summary">
							<p class="confirm-summary__label">Quote Summary</p>
							<ul class="confirm-summary__lines">
								<li>
									<span>Quoted total</span>
									<span>{formatMoney(quotedTotal)}</span>
								</li>
								<li>
									<span>Balance due later</span>
									<span>{formatMoney(balanceDue)}</span>
								</li>
							</ul>
							<div class="confirm-summary__total">
								<span>Deposit due today</span>
								<span>{formatMoney(depositAmount)}</span>
							</div>
						</aside>
					</div>
				)
			}
		</div>
	</section>
</Layout>

<style>
	.confirm-card--error {
		max-width: 640px;
		margin: 0 auto;
		text-align: center;
	}

	.confirm-card--error .btn {
		margin-top: 1rem;
	}

	.confirm-layout {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 2.5rem;
		align-items: start;
		max-width: 1100px;
		margin: 0 auto;
	}

	.confirm-main {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
	}

	.confirm-card {
		padding: 2rem;
	}

	.confirm-card h3 {
		margin-bottom: 0.75rem;
	}

	.confirm-service {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 1.15rem;
		color: var(--color-sky-dark);
		margin: 0;
	}

	.confirm-details {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.95rem;
		color: var(--color-ink);
	}

	.confirm-hint {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		color: var(--color-slate);
	}

	.confirm-policy {
		background: var(--color-sky-light);
		border-radius: 10px;
		padding: 1rem 1.1rem;
		margin-bottom: 1.25rem;
	}

	.confirm-policy__checkbox {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: 0.9rem;
		color: var(--color-slate);
		cursor: pointer;
	}

	.confirm-policy__checkbox input {
		width: auto;
		margin-top: 0.2rem;
		flex-shrink: 0;
	}

	.confirm-form__error {
		margin: 0 0 1rem;
		font-size: 0.85rem;
		color: #b3261e;
	}

	.confirm-form__error[hidden] {
		display: none;
	}

	.confirm-form__submit {
		width: 100%;
	}

	.confirm-form__submit[disabled] {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.confirm-summary {
		position: sticky;
		top: 1.5rem;
		min-width: 0;
		padding: 2rem;
	}

	.confirm-summary__label {
		margin: 0 0 1rem;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-sky-dark);
	}

	.confirm-summary__lines {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.confirm-summary__lines li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.9rem;
		color: var(--color-slate);
	}

	.confirm-summary__total {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.4rem;
		color: var(--color-ink);
	}

	@media (max-width: 900px) {
		.confirm-layout {
			grid-template-columns: 1fr;
		}

		.confirm-summary {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.confirm-card {
			padding: 1.5rem;
		}
	}
</style>

<script>
	function initConfirmQuotePage() {
		const form = document.getElementById("confirm-quote-form");
		if (!form || form.dataset.init === "true") return;
		form.dataset.init = "true";

		const id = form.dataset.id;
		const agree = document.getElementById("confirm-quote-agree");
		const errorEl = document.getElementById("confirm-quote-error");
		const submitBtn = document.getElementById("confirm-quote-submit");

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			errorEl.hidden = true;

			if (!agree.checked) {
				errorEl.textContent = "Please check the box above before continuing.";
				errorEl.hidden = false;
				agree.closest(".confirm-policy")?.scrollIntoView({ behavior: "smooth", block: "center" });
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = "Redirecting to payment…";

			try {
				const response = await fetch("/api/confirm-quote/finalize", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ id, agreed: agree.checked }),
				});
				const data = await response.json();

				if (!response.ok || !data.url) {
					throw new Error(data.error || "Something went wrong starting checkout.");
				}

				window.location.href = data.url;
			} catch (err) {
				errorEl.textContent = err instanceof Error ? err.message : "Something went wrong. Please try again.";
				errorEl.hidden = false;
				submitBtn.disabled = false;
				submitBtn.textContent = "Accept & Pay Deposit";
			}
		});
	}

	initConfirmQuotePage();
	document.addEventListener("astro:page-load", initConfirmQuotePage);
</script>
