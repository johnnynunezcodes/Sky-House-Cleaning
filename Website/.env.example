# Copy this file to .env for local development (astro dev), and add the
# same variables in Vercel → Project Settings → Environment Variables for
# production. Never commit the real .env file — it's already gitignored.

# Stripe secret key used by src/pages/api/create-checkout-session.js to
# create Checkout Sessions server-side, and by success.astro to verify a
# payment. Get this from https://dashboard.stripe.com/apikeys — use the
# "test mode" key (starts with sk_test_) while you're setting things up,
# and switch to the live key (sk_live_) only once you're ready to accept
# real payments.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Signing secret for the webhook at /api/stripe-webhook, which is what
# actually creates the Google Calendar event once a payment succeeds. Get
# this from the Stripe Dashboard → Developers → Webhooks → your endpoint →
# "Signing secret" (or from the Stripe CLI's `stripe listen` output while
# testing locally). See AGENTS.md for the full walkthrough.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Calendar service account, used by src/lib/googleCalendar.js to
# check availability and create booking events. See AGENTS.md for how to
# create the service account in Google Cloud Console and share your
# calendar with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key from the service account's JSON key file, keeping
# it on one line with \n in place of real newlines (the code converts them
# back). It should look like: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Found in Google Calendar → Settings → [your calendar] → Integrate calendar
# → "Calendar ID". Usually looks like an email address or ends in
# @group.calendar.google.com.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
