# Copy this file to .env for local development (astro dev), and add the
# same variables in Vercel → Project Settings → Environment Variables for
# production. Never commit the real .env file — it's already gitignored.

# Stripe secret key used by src/pages/api/create-checkout-session.js to
# create Checkout Sessions server-side, and by success.astro to verify a
# payment. Get this from https://dashboard.stripe.com/apikeys — use the
# "test mode" key (starts with sk_test_) while you're setting things up,
# and switch to the live key (sk_live_) only once you're ready to accept
# real payments.
STRIPE_SECRET_KEY=sk_test_your_key_here

# Signing secret for the webhook at /api/stripe-webhook, which is what
# actually creates the Google Calendar event once a payment succeeds. Get
# this from the Stripe Dashboard → Developers → Webhooks → your endpoint →
# "Signing secret" (or from the Stripe CLI's `stripe listen` output while
# testing locally). See AGENTS.md for the full walkthrough.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Calendar service account, used by src/lib/googleCalendar.js to
# check availability and create booking events. See AGENTS.md for how to
# create the service account in Google Cloud Console and share your
# calendar with it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key from the service account's JSON key file, keeping
# it on one line with \n in place of real newlines (the code converts them
# back). It should look like: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Found in Google Calendar → Settings → [your calendar] → Integrate calendar
# → "Calendar ID". Usually looks like an email address or ends in
# @group.calendar.google.com.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# A real mailbox in your Workspace that already has edit access to the
# calendar above (e.g. info@skyhousecleaning.com). The service account
# impersonates this address via Domain-Wide Delegation to get write access —
# Google Calendar won't let you grant "Make changes to events" directly to a
# service account through the sharing UI. Requires enabling Domain-Wide
# Delegation for the service account in Cloud Console and authorizing its
# Client ID in the Workspace Admin console (Security → API controls →
# Domain-wide delegation) for the https://www.googleapis.com/auth/calendar
# scope. See AGENTS.md for the full walkthrough.
GOOGLE_IMPERSONATE_EMAIL=info@skyhousecleaning.com

# Powers the live Google reviews shown on /reviews (src/lib/googleReviews.js).
# Unrelated to the GOOGLE_* Calendar vars above — this is a plain Places API
# (New) key from Google Cloud Console, not a service account. Requires a
# Cloud project with billing enabled and the "Places API (New)" API turned
# on. See AGENTS.md for the full setup walkthrough, including how to find
# your Place ID. If these two vars are left unset, /reviews just falls back
# to the hand-picked testimonials in src/data/content.js — nothing breaks.
GOOGLE_PLACES_API_KEY=your_places_api_key_here
# Find this via Google's Place ID Finder tool (linked in AGENTS.md), or by
# searching your business name on Google Maps and reading it out of the
# share link. Looks like a long string starting with "ChIJ".
GOOGLE_PLACE_ID=ChIJ_your_place_id_here

# Powers the "Leave Us a Review" button on /reviews independently of
# GOOGLE_PLACE_ID above. Get this from Business Profile Manager
# (business.google.com) → your listing → "Get more reviews" / "Ask for
# reviews" → copy the share link. Works even if GOOGLE_PLACE_ID is unset.
GOOGLE_REVIEW_URL=https://g.page/r/your_code_here/review

# Credentials for the staff-only tools under /admin (currently:
# /admin/reschedule, for permanently moving a recurring customer's cleaning
# day/time). Protected by HTTP Basic Auth in src/middleware.js — pick your
# own values here, this isn't tied to any Google/Stripe account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
